page {
  background: #eef3fa;
}

.user-center-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  color: #1d293b;
  background: linear-gradient(180deg, #f1f5fb 0%, #eaf1f9 100%);
}

.user-center-loading { padding-top: 4rpx; }
.skeleton {
  margin-bottom: 18rpx;
  border-radius: 30rpx;
  background: linear-gradient(100deg, #e4eaf3 15%, #f0f4f9 38%, #e4eaf3 62%);
  background-size: 300% 100%;
  animation: skeleton-shimmer 1.25s ease-in-out infinite;
}
.skeleton-profile { height: 150rpx; }
.skeleton-balance { height: 310rpx; }
.skeleton-quick { height: 112rpx; }
.skeleton-records { height: 300rpx; }
@keyframes skeleton-shimmer {
  from { background-position: 100% 0; }
  to { background-position: 0 0; }
}

.profile-card {
  position: relative;
  display: flex;
  min-height: 142rpx;
  padding: 24rpx;
  align-items: center;
  border: 1rpx solid #cdddf1;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #e3efff 0%, #edf4fc 58%, #e8f0fa 100%);
  box-shadow: 0 12rpx 30rpx rgba(45, 78, 124, 0.08);
}
.profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 5rpx solid #f3f7fc;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 235, 0.14);
}
.profile-avatar-fallback {
  color: #1f6feb;
  background: #d6e7ff;
  font-size: 34rpx;
  font-weight: 800;
}
.profile-copy { min-width: 0; flex: 1; margin-left: 20rpx; }
.profile-kicker { color: #5f7da7; font-size: 19rpx; font-weight: 700; }
.profile-name {
  margin-top: 5rpx;
  overflow: hidden;
  color: #20304a;
  font-size: 31rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-caption { margin-top: 6rpx; color: #70839c; font-size: 19rpx; }
.profile-badge {
  margin-left: 14rpx;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #2e659e;
  background: #d9e8fa;
  font-size: 18rpx;
  font-weight: 700;
}
.profile-hint {
  position: absolute;
  right: 24rpx;
  bottom: 10rpx;
  left: 132rpx;
  overflow: hidden;
  color: #a45353;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.balance-card {
  position: relative;
  min-height: 300rpx;
  margin-top: 18rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  border-radius: 34rpx;
  color: #f6faff;
  background: linear-gradient(145deg, #1767da 0%, #2878ed 58%, #3e88f2 100%);
  box-shadow: 0 22rpx 42rpx rgba(31, 111, 235, 0.24);
}
.balance-content { position: relative; z-index: 2; }
.balance-orbit { position: absolute; border-radius: 50%; pointer-events: none; }
.balance-orbit-large {
  right: -64rpx;
  bottom: -86rpx;
  width: 230rpx;
  height: 230rpx;
  border: 18rpx solid rgba(246, 250, 255, 0.13);
}
.balance-orbit-small {
  right: 72rpx;
  bottom: 68rpx;
  width: 34rpx;
  height: 34rpx;
  background: rgba(246, 250, 255, 0.11);
}
.balance-label { color: #d8e8ff; font-size: 21rpx; }
.balance-line { display: flex; margin-top: 7rpx; align-items: baseline; }
.balance-value { font-size: 66rpx; font-weight: 850; line-height: 1.08; letter-spacing: -2rpx; }
.balance-value-placeholder { opacity: 0.82; letter-spacing: 2rpx; }
.balance-unit { margin-left: 10rpx; color: #d8e8ff; font-size: 20rpx; }
.balance-caption { margin-top: 6rpx; color: #c8ddfb; font-size: 18rpx; }
.balance-recharge {
  display: inline-flex;
  width: auto;
  min-width: 142rpx;
  height: 62rpx;
  min-height: 62rpx;
  margin: 24rpx 0 0;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #1f6feb;
  background: #f1f6fd;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 62rpx;
  box-shadow: 0 8rpx 18rpx rgba(14, 64, 139, 0.12);
}
.balance-recharge-arrow { margin-left: 10rpx; font-size: 25rpx; }
.balance-message { margin-top: 14rpx; color: #ffe3e3; font-size: 18rpx; line-height: 28rpx; }

.quick-grid { display: flex; gap: 16rpx; margin-top: 18rpx; }
.quick-card {
  display: flex;
  width: calc(50% - 8rpx);
  min-width: 0;
  min-height: 108rpx;
  margin: 0;
  padding: 20rpx;
  flex: 1;
  align-items: center;
  border: 1rpx solid #cfdaea;
  border-radius: 28rpx;
  color: #25354f;
  background: linear-gradient(145deg, #f0f5fb 0%, #e8f0f9 100%);
  text-align: left;
  box-shadow: 0 10rpx 24rpx rgba(45, 78, 124, 0.06);
}
.quick-icon {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #1f6feb;
  background: #d8e7fb;
  font-size: 20rpx;
  font-weight: 850;
}
.quick-icon-records { color: #147a68; background: #d8eee9; }
.quick-copy { min-width: 0; margin-left: 14rpx; }
.quick-title { color: #293a54; font-size: 23rpx; font-weight: 800; line-height: 31rpx; }
.quick-description { margin-top: 3rpx; color: #788aa2; font-size: 18rpx; line-height: 25rpx; }

.service-message {
  display: flex;
  min-height: 74rpx;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  font-size: 19rpx;
}
.service-message-error { color: #a64949; background: #f8e9eb; }
.service-message button,
.records-retry {
  height: 48rpx;
  min-height: 48rpx;
  margin: 0 0 0 14rpx;
  padding: 0 14rpx;
  border-radius: 13rpx;
  color: #1f6feb;
  background: #e1ebf8;
  font-size: 18rpx;
  line-height: 48rpx;
}

.account-panel {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #cfdaea;
  border-radius: 30rpx;
  background: linear-gradient(160deg, #f2f6fb 0%, #eaf1f8 100%);
  box-shadow: 0 12rpx 28rpx rgba(45, 78, 124, 0.07);
}
.panel-heading { display: flex; padding-bottom: 12rpx; align-items: center; justify-content: space-between; }
.panel-title { color: #293a54; font-size: 24rpx; font-weight: 800; }
.panel-all {
  display: flex;
  width: auto;
  height: 46rpx;
  min-height: 46rpx;
  margin: 0;
  padding: 0 8rpx;
  align-items: center;
  color: #6f829b;
  background: transparent;
  font-size: 18rpx;
  line-height: 46rpx;
}
.panel-all text { margin-left: 4rpx; font-size: 25rpx; }
.record-row {
  display: flex;
  min-height: 94rpx;
  padding: 15rpx 0;
  align-items: center;
  border-top: 1rpx solid #dce4ee;
}
.record-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  font-size: 20rpx;
  font-weight: 850;
}
.record-icon-recharge { color: #147a68; background: #d8eee9; }
.record-icon-spend { color: #c65a36; background: #f7e5dc; }
.record-icon-refund { color: #147f86; background: #d9ecef; }
.record-icon-checkin { color: #1f6feb; background: #dbe8fa; }
.record-icon-income { color: #6552b3; background: #e5e0f5; }
.record-icon-free { color: #68798e; background: #e1e7ef; }
.record-copy { min-width: 0; flex: 1; margin-left: 15rpx; }
.record-title { overflow: hidden; color: #34445c; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.record-time { margin-top: 5rpx; color: #8a99ac; font-size: 17rpx; }
.record-side { margin-left: 12rpx; text-align: right; }
.record-amount { font-size: 22rpx; font-weight: 850; }
.record-amount-recharge,
.record-amount-refund,
.record-amount-checkin,
.record-amount-income { color: #147a68; }
.record-amount-spend { color: #c65a36; }
.record-amount-free { color: #68798e; }
.record-balance { margin-top: 4rpx; color: #8b99aa; font-size: 16rpx; }

.records-state {
  display: flex;
  min-height: 98rpx;
  padding: 17rpx;
  align-items: center;
  border-top: 1rpx solid #dce4ee;
  border-radius: 0 0 18rpx 18rpx;
}
.records-state-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  color: #2b679f;
  background: #d9e7f8;
  font-size: 18rpx;
  font-weight: 850;
}
.records-state-title { color: #43536a; font-size: 20rpx; font-weight: 750; }
.records-state-description { margin-top: 4rpx; color: #7e8ea3; font-size: 17rpx; line-height: 25rpx; }
.records-state-preparing { background: #e5eef8; }
.records-state-empty { background: #e9eff6; }
.records-state-error { justify-content: space-between; color: #a64949; background: #f7e9eb; }

.page-retry-wrap { margin-top: 16rpx; }
.page-retry {
  width: 100%;
  height: 68rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #1f6feb;
  background: #dfe9f6;
  font-size: 20rpx;
  line-height: 68rpx;
}
.account-note {
  display: flex;
  min-height: 62rpx;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  align-items: flex-start;
  border-radius: 18rpx;
  color: #527769;
  background: #dff1eb;
  font-size: 18rpx;
  line-height: 29rpx;
}
.account-note-preparing { color: #55708f; background: #dfeaf7; }
.account-note-icon {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  margin: 1rpx 10rpx 0 0;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 11rpx;
  color: #176d5b;
  background: #c7e7dc;
  font-size: 15rpx;
  font-weight: 850;
}
.account-note-preparing .account-note-icon { color: #2b679f; background: #cbdff5; }

@media (max-width: 340px) {
  .user-center-page { padding-right: 20rpx; padding-left: 20rpx; }
  .profile-card { padding: 20rpx; }
  .profile-avatar { width: 78rpx; height: 78rpx; }
  .profile-caption { display: none; }
  .profile-badge { padding-right: 10rpx; padding-left: 10rpx; }
  .balance-card { padding-right: 28rpx; padding-left: 28rpx; }
  .quick-card { padding: 16rpx; }
  .quick-icon { width: 46rpx; height: 46rpx; }
  .quick-title { font-size: 21rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton { animation: none; }
}
