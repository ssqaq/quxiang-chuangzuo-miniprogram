page {
  background: #f5f7fb;
  overflow-x: hidden;
}

.records-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 35.5rpx 26.63rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  color: #10294b;
  background: #f5f7fb;
}

.record-summary {
  box-sizing: border-box;
  width: 100%;
  min-height: 213rpx;
  padding: 31.07rpx;
  overflow: hidden;
  border-radius: 33.28rpx;
  color: #ffffff;
  background: #1f6feb;
}

.summary-label {
  color: rgba(255, 255, 255, .82);
  font-size: 8px;
  line-height: 12px;
}

.summary-balance-line {
  display: flex;
  margin-top: 2px;
  align-items: baseline;
}

.summary-balance {
  color: #ffffff;
  font-size: 27px;
  line-height: 32px;
  font-weight: 800;
}

.summary-unit {
  margin-left: 5px;
  color: rgba(255, 255, 255, .88);
  font-size: 8px;
  line-height: 12px;
}

.summary-total {
  margin-top: 3px;
  overflow: hidden;
  color: rgba(255, 255, 255, .86);
  font-size: 7px;
  line-height: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-loading,
.summary-refreshing,
.summary-error {
  margin-top: 2px;
  overflow: hidden;
  color: rgba(255, 255, 255, .78);
  font-size: 8px;
  line-height: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-tabs {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 71rpx;
  margin-top: 19.97rpx;
  padding: 8.88rpx;
  align-items: flex-start;
  border-radius: 24.41rpx;
  background: #e9eef5;
  overflow: visible;
}

.filter-hit {
  position: relative;
  display: flex;
  width: 0;
  min-width: 0;
  height: 97.63rpx;
  min-height: 44px;
  margin-top: -22.19rpx;
  flex: 1 1 0;
  align-items: flex-start;
  justify-content: center;
}

.filter-button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 53.25rpx;
  min-height: 53.25rpx;
  margin: 22.19rpx 0 0;
  padding: 0;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 17.75rpx;
  color: #60728b;
  background: transparent;
  font-size: 8px;
  line-height: 53.25rpx;
  font-weight: 600;
  text-align: center;
}

.filter-button::after {
  display: none;
  border: 0;
}

.filter-button-active {
  color: #1f6feb;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(31, 72, 125, .08);
}

.records-panel,
.account-panel {
  box-sizing: border-box;
  width: 100%;
  min-height: 484rpx;
  margin-top: 17.75rpx;
  padding: 26.63rpx;
  border: 1px solid #dce5f0;
  border-radius: 33.28rpx;
  background: #ffffff;
  overflow: hidden;
}

/* 五条流水按冻结 G1 投影后的面板高度；行内高度保持原生取整，避免文字基线漂移。 */
.records-panel {
  min-height: 591rpx;
}

.records-loading {
  width: 100%;
}

.skeleton-row {
  box-sizing: border-box;
  height: 106rpx;
  border-top: 1px solid #e8edf4;
  background: linear-gradient(100deg, #f2f5f9 15%, #fbfcfe 42%, #f2f5f9 66%);
  background-size: 300% 100%;
  animation: skeleton-shimmer 1.25s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  from { background-position: 100% 0; }
  to { background-position: 0 0; }
}

.transaction-list {
  width: 100%;
}

.transaction-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 106rpx;
  min-height: 106rpx;
  align-items: center;
  border-top: 1px solid #e8edf4;
}

.transaction-row:first-child {
  border-top-color: #e2e9f2;
}

.transaction-icon {
  display: flex;
  width: 62.13rpx;
  height: 62.13rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 19.97rpx;
  font-size: 9px;
  line-height: 13px;
  font-weight: 800;
}

.transaction-icon-recharge,
.transaction-icon-refund,
.transaction-icon-checkin,
.transaction-icon-income {
  color: #0b9476;
  background: #e6f7f2;
}

.transaction-icon-spend {
  color: #e75a43;
  background: #fff0ea;
}

.transaction-icon-free {
  color: #6d809c;
  background: #edf2f8;
}

.transaction-icon-neutral {
  color: #68758a;
  background: #eef1f5;
}

.transaction-copy {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1 1 auto;
}

.transaction-title {
  overflow: hidden;
  color: #344158;
  font-size: 9px;
  line-height: 13px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-meta {
  margin-top: 3px;
  overflow: hidden;
  color: #91a0b4;
  font-size: 7px;
  line-height: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-amount {
  min-width: 40rpx;
  margin-left: 12rpx;
  color: #0b9476;
  font-size: 10px;
  line-height: 14px;
  font-weight: 800;
  text-align: right;
  white-space: nowrap;
}

.transaction-amount-spend {
  color: #e84f35;
}

.transaction-amount-free {
  color: #8090a7;
}

.transaction-amount-neutral {
  color: #68758a;
}

.state-panel {
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 54rpx 20rpx 30rpx;
  text-align: center;
}

.state-error {
  color: #a94444;
  background: #fff8f8;
}

.empty-state {
  color: #65748a;
}

.state-icon {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #a94444;
  background: #fff0f0;
  font-size: 16px;
  font-weight: 800;
}

.empty-state-icon {
  color: #758aa6;
  background: #edf3fb;
}

.state-title {
  margin-top: 12px;
  font-size: 12px;
  line-height: 18px;
  font-weight: 700;
}

.state-description {
  margin-top: 4px;
  font-size: 9px;
  line-height: 14px;
  opacity: .82;
}

.retry-button,
.inline-retry,
.load-more-button {
  min-height: 44px;
  border: 0;
  color: #ffffff;
  background: #1f6feb;
  font-size: 10px;
  line-height: 44px;
}

.retry-button {
  width: 110px;
  height: 44px;
  margin: 14px auto 0;
  border-radius: 10px;
}

.inline-error {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  color: #ad4242;
  font-size: 9px;
  line-height: 14px;
}

.inline-error > text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inline-retry {
  width: 52px;
  height: 44px;
  margin-left: 8px;
  padding: 0;
  border-radius: 9px;
  color: #ad4242;
  background: #fff1f1;
}

.pagination-limited {
  padding-top: 4px;
  color: #8d99a9;
  font-size: 8px;
  line-height: 12px;
  text-align: center;
}

.load-more-button {
  width: 100%;
  height: 44px;
  margin-top: 8px;
  border-radius: 10px;
}

.load-more-button[disabled] {
  color: #9aa5b5 !important;
  background: #eef1f5 !important;
}

.records-note {
  margin-top: 11px;
  color: #99a4b4;
  font-size: 7px;
  line-height: 10px;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .skeleton-row { animation: none; }
}
