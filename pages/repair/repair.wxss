.mask-export-canvas {
  position: absolute;
  top: -10000px;
  left: -10000px;
}

.repair-canvas-wrap {
  margin-top: 20rpx;
  overflow: hidden;
  border: 2rpx solid #dfe6f1;
  border-radius: 18rpx;
  background: #f1f4f8;
}

.repair-canvas-viewport {
  position: relative;
  margin: 0 auto;
  overflow: hidden;
  overscroll-behavior: none;
}

.repair-canvas-image {
  display: block;
}

.repair-mask-canvas {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;
  display: block;
}

.canvas-tip {
  padding: 16rpx;
  background: rgba(17, 24, 39, 0.88);
  color: #eef3fb;
  font-size: 22rpx;
  line-height: 1.5;
}

.repair-status {
  margin: 18rpx 0;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-ok {
  color: #16794c;
  background: #eaf8f0;
}

.status-warn {
  color: #9a5c00;
  background: #fff5df;
}

.asset-status-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  color: #536075;
  font-size: 25rpx;
}

.asset-ok {
  color: #16794c;
}

.asset-missing,
.danger-text {
  color: #c53d4d;
}

.reference-actions,
.prompt-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.reference-actions button,
.prompt-actions button {
  flex: 1;
  min-width: 0;
}

.reference-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 0;
  color: #657084;
  font-size: 23rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.issue-group {
  margin-top: 20rpx;
}

.issue-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.issue-item {
  display: flex;
  align-items: center;
  min-width: 42%;
  padding: 12rpx 14rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 12rpx;
  color: #47536a;
  font-size: 23rpx;
}

.prompt-area {
  box-sizing: border-box;
  width: 100%;
  height: 360rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 14rpx;
  background: #f7f9fc;
  color: #536075;
  font-size: 23rpx;
  line-height: 38rpx;
}

.hint {
  margin-top: 16rpx;
  color: #788397;
  font-size: 22rpx;
  line-height: 1.5;
}

@media (max-width: 389px) {
  .reference-actions,
  .prompt-actions {
    gap: 10rpx;
  }

  .reference-actions button,
  .prompt-actions button {
    padding-right: 10rpx;
    padding-left: 10rpx;
    font-size: 22rpx;
  }
}
