                  <view
                    wx:for="{{item.qualityProbe.values}}"
                    wx:for-item="qualityItem"
                    wx:key="value"
                    class="model-probe-quality-value"
                  >
                    <text>{{qualityItem.value}}</text>
                    <text class="{{qualityItem.status === 'supported' ? 'log-ok' : qualityItem.status === 'unsupported' ? 'log-warn' : 'model-probe-quality-unknown'}}">{{qualityItem.statusText}}</text>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.repairAdvice}}" class="model-probe-repair">
                修复建议：{{item.repairAdvice}}
              </view>
            </view>
            <view class="model-probe-side">
              <text class="{{item.ready ? 'log-ok' : 'log-warn'}}">{{item.statusText}}</text>
              <text>{{item.durationText}}</text>
              <view
                class="model-probe-single-button {{modelProbingType === item.type ? 'is-disabled' : ''}}"
                data-model-type="{{item.type}}"
                catchtap="probeSingleModel"
                hover-class="control-tap"
                role="button"
                aria-label="单独探测{{item.typeLabel}}"
              >{{modelProbingType === item.type ? '探测中' : '单独探测'}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{modelProbes.message}}" class="usage-message is-warn">{{modelProbes.message}}</view>
      </view>

      <view id="monitor-section-probeHistory" class="card admin-section auto-face-probe-history-card">
        <view class="admin-section-head">
          <view class="monitor-section-head-main">
            <view class="monitor-section-title-row">
              <text class="monitor-status-dot is-danger"></text>
              <text class="monitor-section-title">探针历史</text>
            </view>
            <text class="monitor-section-summary">最近 {{autoFaceProbeHistory.retentionDays}} 天，最多显示 20 条。</text>
          </view>
          <view class="admin-section-tools">
            <view class="config-state {{moduleStates.probeHistory.status === 'failed' ? 'is-off' : 'is-ready'}}">
              {{moduleStates.probeHistory.label}}
            </view>
            <button class="usage-refresh-button" bindtap="refreshAutoFaceProbeHistory">刷新</button>
            <view class="admin-action-slot">
              <view
                class="monitor-section-toggle-button"
                data-deployment-section="probeHistory"
                catchtap="toggleDeploymentSection"
                hover-class="control-tap"
                role="button"
                aria-label="{{deploymentSections.probeHistory ? '收起探针历史' : '展开探针历史'}}"
              >
                <text>{{deploymentSections.probeHistory ? '收起' : '展开'}}</text>
                <text class="monitor-section-chevron {{deploymentSections.probeHistory ? 'is-open' : ''}}">⌄</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{deploymentSections.probeHistory}}" class="monitor-fold-body module-fold-body {{moduleStates.probeHistory.status === 'loading' ? 'is-loading' : ''}}">
          <view wx:if="{{moduleStates.probeHistory.status === 'loading'}}" class="usage-message">
            正在读取探针历史...
          </view>
          <view wx:if="{{moduleStates.probeHistory.status === 'loading'}}" class="module-loading-placeholder">
            <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
            <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
            <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
          </view>
          <view wx:if="{{moduleStates.probeHistory.status === 'failed'}}" class="usage-message is-warn">
            {{moduleStates.probeHistory.message || '探针历史读取失败，请点击刷新。'}}
          </view>
          <view wx:if="{{autoFaceProbeHistory.message}}" class="usage-message {{autoFaceProbeHistory.unavailable ? 'is-warn' : ''}}">
            {{autoFaceProbeHistory.message}}
          </view>
          <view wx:if="{{(moduleStates.probeHistory.status === 'ready' || moduleStates.probeHistory.hasData) && !autoFaceProbeHistory.history.length && !autoFaceProbeHistory.message}}" class="admin-empty">
            还没有探针历史，点击“立即检查线上部署”生成第一条。
          </view>
          <view wx:for="{{autoFaceProbeHistory.history}}" wx:key="checkedAt" class="auto-face-probe-history-row">
            <view class="auto-face-probe-history-top">
              <view>
                <text class="{{item.status === 'ok' ? 'log-ok' : 'log-warn'}}">{{item.statusText}}</text>
                <text class="auto-face-probe-history-time">{{item.checkedAtText}}</text>
              </view>
              <text class="auto-face-probe-history-duration">{{item.durationText}}</text>
            </view>
            <view class="auto-face-probe-history-meta">
              {{item.buildVersion}} · {{item.visionConfigured ? '视觉配置已就绪' : '视觉配置未就绪'}} · {{item.model}}
            </view>
            <view class="auto-face-probe-history-meta">{{item.buildMarker}}</view>
            <view wx:if="{{item.status === 'failed' && item.errorCode}}" class="auto-face-probe-history-error">
              错误码：{{item.errorCode}}
            </view>
          </view>
        </view>
      </view>
      <view class="card admin-section deployment-log-card">
        <view class="admin-section-head">
          <view class="monitor-section-head-main">
            <view class="monitor-section-title-row">
              <text class="monitor-status-dot is-danger"></text>
              <text class="monitor-section-title">部署检查日志</text>
            </view>
            <text class="monitor-section-summary">只记录版本、状态和配置完整性，不记录 Key 和素材。</text>
          </view>
          <view class="admin-section-tools">
            <view class="config-state {{moduleStates.logs.status === 'failed' ? 'is-off' : 'is-ready'}}">
              {{moduleStates.logs.label}}
            </view>
            <text class="admin-log-count">{{logs.length}} 条</text>
            <view
              class="monitor-inline-check-button {{checking ? 'is-disabled' : ''}}"
              catchtap="checkDeployment"
              hover-class="control-tap"
              role="button"
              aria-label="立即检查线上部署"
            >{{checking ? '检查中' : '立即检查'}}</view>
            <view class="admin-action-slot">
              <view
                class="monitor-section-toggle-button"
                data-deployment-section="logs"
                catchtap="toggleDeploymentSection"
                hover-class="control-tap"
                role="button"
                aria-label="{{deploymentSections.logs ? '收起部署检查日志' : '展开部署检查日志'}}"
              >
                <text>{{deploymentSections.logs ? '收起' : '展开'}}</text>
                <text class="monitor-section-chevron {{deploymentSections.logs ? 'is-open' : ''}}">⌄</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{deploymentSections.logs}}" class="monitor-fold-body module-fold-body {{moduleStates.logs.status === 'loading' ? 'is-loading' : ''}}">
          <view wx:if="{{moduleStates.logs.status === 'loading'}}" class="usage-message">
            正在读取部署日志...
          </view>
          <view wx:if="{{moduleStates.logs.status === 'loading'}}" class="module-loading-placeholder">
            <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
            <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
            <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
          </view>
          <view wx:if="{{moduleStates.logs.status === 'failed'}}" class="usage-message is-warn">
            {{moduleStates.logs.message || '部署日志读取失败，请点击一键刷新全部。'}}
          </view>
          <view wx:if="{{(moduleStates.logs.status === 'ready' || moduleStates.logs.hasData) && !logs.length}}" class="admin-empty">
            还没有检查记录，点击上面的按钮生成第一条。
          </view>
          <view wx:for="{{logs}}" wx:key="checkedAt" class="admin-log-item">
            <view class="admin-log-top">
              <text>{{item.checkedAtText}}</text>
              <text class="{{item.ok ? 'log-ok' : 'log-warn'}}">{{item.statusText}}</text>
            </view>
            <view class="admin-log-meta">{{item.buildVersion}} · {{item.buildMarker}}</view>
            <view class="admin-log-meta">{{item.faceText}} · {{item.analysisText}} · {{item.imageText}} · {{item.videoText}}</view>
          </view>
        </view>
      </view>
      </view>
      </view>


      </view>

    </view>

    <view
      wx:if="{{modelFailureDetailOpen}}"
      class="auto-face-detail-mask"
      catchtap="closeModelFailureUserDetail"
    >
      <view class="auto-face-detail-dialog" catchtap="noop">
        <view class="auto-face-detail-head">
          <view>
            <view class="auto-face-detail-title">用户 {{modelFailureDetail.userHash}} 的失败详情</view>
            <view class="auto-face-detail-subtitle">{{modelFailureView.selectedMonth}} · 共 {{modelFailureDetail.total}} 次</view>
          </view>
          <view class="auto-face-detail-close" catchtap="closeModelFailureUserDetail">关闭</view>
        </view>
        <view wx:if="{{modelFailureDetail.details.length}}" class="auto-face-detail-list">
          <view wx:for="{{modelFailureDetail.details}}" wx:key="requestId" class="auto-face-detail-row">
            <view class="auto-face-detail-row-top">
              <text>{{item.createdAtText}}</text>
              <text class="failure-type-tag is-{{item.failureTone}}">{{item.failureReasonLabel}}</text>
            </view>
            <view class="auto-face-detail-meta">
              <text>{{item.usageTypeLabel}} · {{item.modelDisplayZh || item.modelDisplay}}</text>
              <text>{{item.errorCodeLabel || item.errorCode}}</text>
              <text wx:if="{{item.errorStatus}}">状态码 {{item.errorStatus}}</text>
              <text wx:if="{{item.durationMs}}">用时 {{item.durationMs}} 毫秒</text>
            </view>
            <view class="auto-face-detail-message">{{item.errorMessageZh || item.errorMessage}}</view>
            <view wx:if="{{item.requestId}}" class="auto-face-detail-request">请求 {{item.requestId}}</view>
          </view>
        </view>
        <view wx:else class="admin-empty usage-empty">这个用户当前月份没有失败明细。</view>
      </view>
    </view>

      <view
        wx:if="{{modelPickerOpen}}"
        class="model-picker-mask"
        catchtap="closeModelPicker"
      >
        <view class="model-picker-dialog" catchtap="noop">
          <view class="model-picker-head">
            <view>
              <view class="model-picker-title">{{modelPickerTitle}}</view>
              <view class="model-picker-subtitle">点选后会填入“使用的模型”，最后记得保存。</view>
            </view>
            <view class="model-picker-close" bindtap="closeModelPicker">关闭</view>
          </view>
          <view class="model-picker-search-row">
            <input
              class="model-picker-search-input"
              value="{{modelPickerSearch}}"
              placeholder="搜索模型名称"
              confirm-type="search"
              bindinput="onModelPickerSearchInput"
            />
            <view
              wx:if="{{modelPickerSearch}}"
              class="model-picker-search-clear"
              bindtap="clearModelPickerSearch"
              hover-class="control-tap"
              role="button"
            >清空</view>
          </view>
          <view class="model-picker-count">
            {{modelPickerOptions.length}} / {{modelPickerAllOptions.length}} 个模型
          </view>
          <scroll-view class="model-picker-list" scroll-y>
            <block wx:if="{{modelPickerOptions.length}}">
              <view
                wx:for="{{modelPickerOptions}}"
                wx:key="value"
                class="model-picker-option"
                data-type="{{modelPickerType}}"
                data-value="{{item.value}}"
                bindtap="selectModelOption"
                hover-class="control-tap"
                role="button"
              >
                <text>{{item.label}}</text>
                <text class="model-picker-arrow">›</text>
              </view>
            </block>
            <view wx:else class="model-picker-empty">
              {{modelPickerSearch ? '没有找到相关模型' : '没有可显示的模型'}}
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- 兼容旧版页面状态字段；实际可见下拉框统一使用 providerPickerOptions*。 -->
      <view wx:if="{{false}}" class="legacy-provider-picker-compat">
        <picker mode="selector" range="{{faceProviderProfileOptions}}" value="{{faceProviderProfileIndex}}" data-section="face" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{analysisProviderProfileOptions}}" value="{{analysisProviderProfileIndex}}" data-section="analysis" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{imageProviderProfileOptions}}" value="{{imageProviderProfileIndex}}" data-section="image" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{imageBackupProviderProfileOptions}}" value="{{imageBackupProviderProfileIndex}}" data-section="imageBackup" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{videoProviderProfileOptions}}" value="{{videoProviderProfileIndex}}" data-section="video" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{providerPickerOptionsVideoBackup}}" value="{{providerPickerIndexVideoBackup}}" data-section="videoBackup" bindchange="onProviderPickerChange"></picker>
        <picker mode="selector" range="{{faceProviderProfileOptions}}" value="{{faceProviderProfileIndex}}" data-section="face" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{analysisProviderProfileOptions}}" value="{{analysisProviderProfileIndex}}" data-section="analysis" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{imageProviderProfileOptions}}" value="{{imageProviderProfileIndex}}" data-section="image" bindchange="onProviderProfileChange"></picker>
        <picker mode="selector" range="{{imageBackupProviderProfileOptions}}" value="{{imageBackupProviderProfileIndex}}" data-section="imageBackup" bindchange="onProviderProfileChange"></picker>
      </view>

  </view>
</view>
