.main-image-preview-card {
  width: 100%;
  margin-top: 20rpx;
  overflow: hidden;
  border: 2rpx solid #dfe6f1;
  border-radius: 20rpx;
  background: transparent;
  text-align: center;
}

.main-image-preview-viewport {
  position: relative;
  margin: 0 auto;
  overflow: hidden;
  background: #101722;
  touch-action: none;
  overscroll-behavior: none;
}

.main-image-preview-stage {
  position: relative;
  top: 0;
  left: 0;
  overflow: hidden;
  background: #101722;
  transform-origin: center center;
  will-change: transform;
  touch-action: none;
  overscroll-behavior: none;
}

.main-image-preview-image {
  display: block;
}

.main-image-preview-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: #edf1f6;
  color: #8c98aa;
  font-size: 24rpx;
}

.main-image-preview-tip {
  padding: 14rpx;
  border-top: 1rpx solid #e6edf6;
  background: #f6f9fd;
  color: #53627a;
  font-size: 22rpx;
  line-height: 1.5;
}
