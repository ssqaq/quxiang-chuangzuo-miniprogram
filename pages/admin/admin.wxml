<view class="admin-page">
  <view class="console-header">
    <view class="console-back" bindtap="backToWorkbench" hover-class="control-tap" role="button" aria-label="返回工作台">‹</view>
    <view class="console-heading">
      <view class="console-title">控制台</view>
      <view class="console-subtitle">模型、积分与成本配置</view>
    </view>
    <view class="admin-access-badge">{{isAdmin ? '管理员' : '未授权'}}</view>
  </view>

  <view wx:if="{{loading}}" class="card admin-state-card">
    <view>正在读取管理员配置...</view>
    <view wx:if="{{canRetry}}" class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && !isAdmin && canRetry}}" class="card admin-state-card">
    <view>{{message || '管理员页面暂时无法打开。'}}</view>
    <view class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && isAdmin}}" class="admin-content">
    <view wx:if="{{message}}" class="admin-message">{{message}}</view>

    <view class="status-console status-{{dashboardStatus.tone}}">
      <view class="status-console-top">
        <view>
          <view class="status-console-label">线上运行状态</view>
          <view class="status-console-title">{{dashboardStatus.title}}</view>
        </view>
        <view class="status-console-dot"></view>
      </view>
      <view class="status-console-meta">
        <text>v{{appVersion}}</text>
        <text>探针 {{dashboardStatus.probeDurationText}}</text>
        <text>今日 {{todayFailureText}}</text>
      </view>
      <view class="status-console-actions">
        <view
          class="status-check-button {{checking ? 'is-disabled' : ''}}"
          bindtap="checkDeployment"
          hover-class="control-tap"
          role="button"
          aria-label="立即检查线上部署"
        >
          {{checking ? '正在检查' : '检查线上部署'}}
        </view>
        <view
          class="status-check-button status-refresh-button {{refreshingAll ? 'is-disabled' : ''}}"
          bindtap="refreshAll"
          hover-class="control-tap"
          role="button"
          aria-label="一键刷新全部"
        >
          {{refreshingAll ? '正在刷新' : '一键刷新全部'}}
        </view>
        <view
          class="status-check-button status-probe-button {{modelProbing ? 'is-disabled' : ''}}"
          bindtap="probeModels"
          hover-class="control-tap"
          role="button"
          aria-label="探测四套模型接口"
        >
          {{modelProbing ? '正在探测' : '探测四套模型'}}
        </view>
      </view>
    </view>

    <view class="quick-launch-grid">
      <view
        class="quick-launch quick-face {{activeConfigSection === 'face' ? 'is-active' : ''}} {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开人脸识别模型配置"
      >
        <view class="quick-launch-icon">脸</view>
        <view class="quick-launch-name">人脸</view>
        <view class="quick-launch-state">{{entryHealth.face.label}}</view>
      </view>
      <view
        class="quick-launch quick-analysis {{activeConfigSection === 'analysis' ? 'is-active' : ''}} {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开图片分析模型配置"
      >
        <view class="quick-launch-icon">图</view>
        <view class="quick-launch-name">图片</view>
        <view class="quick-launch-state">{{entryHealth.analysis.label}}</view>
      </view>
      <view
        class="quick-launch quick-image {{activeConfigSection === 'image' ? 'is-active' : ''}} {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开生图模型配置"
      >
        <view class="quick-launch-icon">生</view>
        <view class="quick-launch-name">生图</view>
        <view class="quick-launch-state">{{entryHealth.image.label}}</view>
      </view>
      <view
        class="quick-launch quick-video {{activeConfigSection === 'video' ? 'is-active' : ''}} {{entryHealth.video.abnormal ? 'is-abnormal' : ''}}"
        data-section="video"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开视频模型配置"
      >
        <view class="quick-launch-icon">视</view>
        <view class="quick-launch-name">视频</view>
        <view class="quick-launch-state">{{entryHealth.video.label}}</view>
      </view>
      <view
        class="quick-launch quick-points {{activeConfigSection === 'points' ? 'is-active' : ''}} {{entryHealth.points.abnormal ? 'is-abnormal' : ''}}"
        data-section="points"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开积分规则配置"
      >
        <view class="quick-launch-icon">积</view>
        <view class="quick-launch-name">积分</view>
        <view class="quick-launch-state">{{entryHealth.points.label}}</view>
      </view>
      <view
        class="quick-launch quick-costs {{activeConfigSection === 'costs' ? 'is-active' : ''}} {{entryHealth.costs.abnormal ? 'is-abnormal' : ''}}"
        data-section="costs"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型成本配置"
      >
        <view class="quick-launch-icon">¥</view>
        <view class="quick-launch-name">成本</view>
        <view class="quick-launch-state">{{entryHealth.costs.label}}</view>
      </view>
      <view
        class="quick-launch quick-users {{activeConfigSection === 'users' ? 'is-active' : ''}} {{entryHealth.users.abnormal ? 'is-abnormal' : ''}}"
        data-section="users"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开用户统计"
      >
        <view class="quick-launch-icon">人</view>
        <view class="quick-launch-name">用户</view>
        <view class="quick-launch-state">{{entryHealth.users.label}}</view>
      </view>
    </view>

    <view class="overview-section">
      <view class="overview-heading">当前配置</view>
      <view
        class="current-config-row {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看人脸识别模型配置"
      >
        <view class="current-config-main">
          <view class="current-config-title">人脸识别模型</view>
          <view class="current-config-meta">
            {{faceConfigSummary.provider}} / {{faceConfigSummary.model}}
          </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{faceConfigSummary.ready ? 'is-ready' : 'is-off'}}">
            {{faceConfigSummary.ready ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view
        class="current-config-row {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看图片分析模型配置"
      >
        <view class="current-config-main">
          <view class="current-config-title">图片分析模型</view>
          <view class="current-config-meta">
            {{analysisConfigSummary.provider}} / {{analysisConfigSummary.model}}
          </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{entryHealth.analysis.abnormal ? 'is-off' : 'is-ready'}}">
            {{entryHealth.analysis.label}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view
        class="current-config-row {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看生图模型配置"
      >
        <view class="current-config-main">
          <view class="current-config-title">生图模型</view>
          <view class="current-config-meta">
            {{form.image.provider || '未填写'}} / {{form.image.model || '未填写'}} · {{form.image.size || '未填写'}}
          </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{effective.image.apiKeyConfigured ? 'is-ready' : 'is-off'}}">
            {{effective.image.apiKeyConfigured ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view
        class="current-config-row {{entryHealth.video.abnormal ? 'is-abnormal' : ''}}"
        data-section="video"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看视频模型配置"
      >
        <view class="current-config-main">
          <view class="current-config-title">视频模型</view>
          <view class="current-config-meta">
            {{form.video.provider || '未填写'}} / {{form.video.model || '未填写'}} · {{form.video.resolution || '未填写'}}
          </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{effective.video.apiKeyConfigured ? 'is-ready' : 'is-off'}}">
            {{effective.video.apiKeyConfigured ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="overview-section today-section">
      <view class="overview-heading">今天</view>
      <view class="today-grid">
        <view class="today-item">
          <text class="today-value">{{usageStats.today.total}}</text>
          <text class="today-label">调用</text>
        </view>
        <view class="today-item">
          <text class="today-value {{usageStats.today.failure ? 'is-warn' : ''}}">{{usageStats.today.failure}}</text>
          <text class="today-label">失败</text>
        </view>
        <view class="today-item">
          <text class="today-value">¥{{usageStats.today.estimatedCostDisplay}}</text>
          <text class="today-label">预计成本</text>
        </view>
      </view>
    </view>

    <view wx:if="{{activeConfigSection}}" id="config-editor" class="card config-editor">
      <view class="config-editor-head">
        <view>
          <view class="config-editor-kicker">正在配置</view>
          <view class="config-editor-title">{{activeConfigTitle}}</view>
        </view>
        <view class="config-close-button" bindtap="closeConfigSection" hover-class="control-tap" role="button" aria-label="收起配置">收起</view>
      </view>

      <view wx:if="{{activeConfigSection === 'face'}}" class="config-editor-body">
        <view class="config-helper">API Key 继续从云函数环境变量读取，这里只改人脸识别服务地址和模型。</view>
        <view class="admin-grid">
          <view class="admin-field"><text>Provider</text><input value="{{form.face.provider}}" data-section="face" data-key="provider" bindinput="onInput" /></view>
          <view class="admin-field"><text>Model</text><input value="{{form.face.model}}" data-section="face" data-key="model" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Base URL</text><input value="{{form.face.baseUrl}}" data-section="face" data-key="baseUrl" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Endpoint（可空）</text><input value="{{form.face.endpoint}}" data-section="face" data-key="endpoint" bindinput="onInput" /></view>
          <view class="admin-field"><text>超时毫秒</text><input type="number" value="{{form.face.timeoutMs}}" data-section="face" data-key="timeoutMs" bindinput="onInput" /></view>
        </view>
      </view>

      <view wx:if="{{activeConfigSection === 'analysis'}}" class="config-editor-body">
        <view class="config-helper">图片分析模型独立保存 Provider、地址、模型和超时；API Key 继续从云函数环境变量读取，不会写入数据库。</view>
        <view class="config-editor-tools">
          <view
            class="config-tool-button"
            bindtap="copyFaceConfigToAnalysis"
            hover-class="control-tap"
            role="button"
            aria-label="复制人脸识别配置到图片分析"
          >复制人脸配置</view>
        </view>
        <view class="admin-grid">
          <view class="admin-field"><text>Provider</text><input value="{{form.analysis.provider}}" data-section="analysis" data-key="provider" bindinput="onInput" /></view>
          <view class="admin-field"><text>Model</text><input value="{{form.analysis.model}}" data-section="analysis" data-key="model" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Base URL</text><input value="{{form.analysis.baseUrl}}" data-section="analysis" data-key="baseUrl" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Endpoint（可空）</text><input value="{{form.analysis.endpoint}}" data-section="analysis" data-key="endpoint" bindinput="onInput" /></view>
          <view class="admin-field"><text>超时毫秒</text><input type="number" value="{{form.analysis.timeoutMs}}" data-section="analysis" data-key="timeoutMs" bindinput="onInput" /></view>
        </view>
      </view>

      <view wx:if="{{activeConfigSection === 'image'}}" class="config-editor-body">
        <view class="config-helper">API Key 继续从云函数环境变量读取，这里不会显示密钥。</view>
        <view class="admin-grid">
          <view class="admin-field"><text>Provider</text><input value="{{form.image.provider}}" data-section="image" data-key="provider" bindinput="onInput" /></view>
          <view class="admin-field"><text>Model</text><input value="{{form.image.model}}" data-section="image" data-key="model" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Base URL</text><input value="{{form.image.baseUrl}}" data-section="image" data-key="baseUrl" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Endpoint（可空）</text><input value="{{form.image.endpoint}}" data-section="image" data-key="endpoint" bindinput="onInput" /></view>
          <view class="admin-field"><text>模式</text><input value="{{form.image.mode}}" data-section="image" data-key="mode" placeholder="generations / edits" bindinput="onInput" /></view>
          <view class="admin-field"><text>尺寸</text><input value="{{form.image.size}}" data-section="image" data-key="size" placeholder="1024x1024" bindinput="onInput" /></view>
          <view class="admin-field"><text>超时毫秒</text><input type="number" value="{{form.image.timeoutMs}}" data-section="image" data-key="timeoutMs" bindinput="onInput" /></view>
          <view class="admin-field"><text>最大重试</text><input type="number" value="{{form.image.maxRetries}}" data-section="image" data-key="maxRetries" bindinput="onInput" /></view>
        </view>
        <label class="admin-checkbox-row">
          <checkbox value="enabled" checked="{{form.image.retryEnabled}}" bindchange="onRetryChange" color="#245fd4"></checkbox>
          <text>允许生图上游请求自动重试</text>
        </label>
      </view>

      <view wx:if="{{activeConfigSection === 'video'}}" class="config-editor-body">
        <view class="config-helper">创建任务只发一次，查询任务按配置轮询。</view>
        <view class="admin-grid">
          <view class="admin-field"><text>Provider</text><input value="{{form.video.provider}}" data-section="video" data-key="provider" bindinput="onInput" /></view>
          <view class="admin-field"><text>Model</text><input value="{{form.video.model}}" data-section="video" data-key="model" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>Base URL</text><input value="{{form.video.baseUrl}}" data-section="video" data-key="baseUrl" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>创建 Endpoint（可空）</text><input value="{{form.video.endpoint}}" data-section="video" data-key="endpoint" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>查询 Endpoint（可空）</text><input value="{{form.video.queryEndpoint}}" data-section="video" data-key="queryEndpoint" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>创建路径</text><input value="{{form.video.createPath}}" data-section="video" data-key="createPath" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>查询路径</text><input value="{{form.video.queryPath}}" data-section="video" data-key="queryPath" bindinput="onInput" /></view>
          <view class="admin-field"><text>清晰度</text><input value="{{form.video.resolution}}" data-section="video" data-key="resolution" bindinput="onInput" /></view>
          <view class="admin-field"><text>宽高比（可空）</text><input value="{{form.video.aspectRatio}}" data-section="video" data-key="aspectRatio" bindinput="onInput" /></view>
          <view class="admin-field"><text>超时毫秒</text><input type="number" value="{{form.video.timeoutMs}}" data-section="video" data-key="timeoutMs" bindinput="onInput" /></view>
        </view>
      </view>

      <view wx:if="{{activeConfigSection === 'points'}}" class="config-editor-body">
        <view class="config-helper">活动日期按上海时间判断，积分在提交任务时扣除。</view>
        <view class="admin-grid">
          <view class="admin-field"><text>每日免费次数</text><input type="number" value="{{form.points.dailyFreeLimit}}" data-section="points" data-key="dailyFreeLimit" bindinput="onInput" /></view>
          <view class="admin-field"><text>生图积分</text><input type="number" value="{{form.points.imageCost}}" data-section="points" data-key="imageCost" bindinput="onInput" /></view>
          <view class="admin-field"><text>视频积分</text><input type="number" value="{{form.points.videoCost}}" data-section="points" data-key="videoCost" bindinput="onInput" /></view>
          <view class="admin-field"><text>每日签到积分</text><input type="number" value="{{form.points.checkinPoints}}" data-section="points" data-key="checkinPoints" bindinput="onInput" /></view>
          <view class="admin-field"><text>连续奖励积分</text><input type="number" value="{{form.points.streakBonus}}" data-section="points" data-key="streakBonus" bindinput="onInput" /></view>
          <view class="admin-field"><text>连续奖励天数</text><input type="number" value="{{form.points.streakDays}}" data-section="points" data-key="streakDays" bindinput="onInput" /></view>
          <view class="admin-field"><text>活动开始日期</text><input value="{{form.points.promoStartDate}}" data-section="points" data-key="promoStartDate" placeholder="2026-08-23" bindinput="onInput" /></view>
          <view class="admin-field"><text>活动结束日期</text><input value="{{form.points.promoEndDate}}" data-section="points" data-key="promoEndDate" placeholder="2026-08-24" bindinput="onInput" /></view>
          <view class="admin-field admin-field-wide"><text>时区</text><input value="{{form.points.timeZone}}" data-section="points" data-key="timeZone" placeholder="Asia/Shanghai" bindinput="onInput" /></view>
        </view>
      </view>

      <view wx:if="{{activeConfigSection === 'costs'}}" class="config-editor-body">
        <view class="config-helper">模型成本配置（人民币）用于计算预计花费。</view>
        <view class="admin-grid">
          <view class="admin-field"><text>人脸输入 / 百万Token</text><input type="digit" value="{{form.costs.faceInputPerMillionTokens}}" data-section="costs" data-key="faceInputPerMillionTokens" bindinput="onInput" /></view>
          <view class="admin-field"><text>人脸输出 / 百万Token</text><input type="digit" value="{{form.costs.faceOutputPerMillionTokens}}" data-section="costs" data-key="faceOutputPerMillionTokens" bindinput="onInput" /></view>
          <view class="admin-field"><text>图片分析输入 / 百万Token</text><input type="digit" value="{{form.costs.analysisInputPerMillionTokens}}" data-section="costs" data-key="analysisInputPerMillionTokens" bindinput="onInput" /></view>
          <view class="admin-field"><text>图片分析输出 / 百万Token</text><input type="digit" value="{{form.costs.analysisOutputPerMillionTokens}}" data-section="costs" data-key="analysisOutputPerMillionTokens" bindinput="onInput" /></view>
          <view class="admin-field"><text>生图 1K / 张</text><input type="digit" value="{{form.costs.image1K}}" data-section="costs" data-key="image1K" bindinput="onInput" /></view>
          <view class="admin-field"><text>生图 2K / 张</text><input type="digit" value="{{form.costs.image2K}}" data-section="costs" data-key="image2K" bindinput="onInput" /></view>
          <view class="admin-field"><text>生图 4K / 张</text><input type="digit" value="{{form.costs.image4K}}" data-section="costs" data-key="image4K" bindinput="onInput" /></view>
          <view class="admin-field"><text>视频 480p / 秒</text><input type="digit" value="{{form.costs.video480p}}" data-section="costs" data-key="video480p" bindinput="onInput" /></view>
          <view class="admin-field"><text>视频 720p / 秒</text><input type="digit" value="{{form.costs.video720p}}" data-section="costs" data-key="video720p" bindinput="onInput" /></view>
          <view class="admin-field"><text>视频 1080p / 秒</text><input type="digit" value="{{form.costs.video1080p}}" data-section="costs" data-key="video1080p" bindinput="onInput" /></view>
          <view class="admin-field"><text>视频默认秒数</text><input type="digit" value="{{form.costs.videoDefaultDuration}}" data-section="costs" data-key="videoDefaultDuration" bindinput="onInput" /></view>
        </view>
        <view class="cost-trend-panel">
          <view class="cost-trend-heading">
            <view>
              <view class="cost-trend-title">最近7天成本</view>
              <view class="cost-trend-total">合计 ¥{{costTrend.totalCostDisplay}}</view>
            </view>
            <view class="config-state {{moduleStates.usage.status === 'failed' ? 'is-off' : 'is-ready'}}">
              {{moduleStates.usage.label}}
            </view>
          </view>
          <view wx:if="{{moduleStates.usage.status === 'loading'}}" class="usage-message">
            正在读取最近7天成本...
          </view>
          <view wx:elif="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData) && costTrend.hasCost}}" class="cost-chart">
            <view wx:for="{{costTrend.days}}" wx:key="dateKey" class="cost-chart-item">
              <view class="cost-chart-value">¥{{item.costDisplay}}</view>
              <view class="cost-chart-track">
                <view class="cost-chart-bar" style="height: {{item.barPercent}}%;"></view>
              </view>
              <view class="cost-chart-date">{{item.label}}</view>
            </view>
          </view>
          <view wx:elif="{{moduleStates.usage.status === 'ready' || moduleStates.usage.hasData}}" class="cost-empty">最近7天没有消费，成本为 0 元。</view>
        </view>
      </view>

      <view wx:if="{{activeConfigSection === 'users'}}" class="config-editor-body">
        <view class="user-stats-d-head">
          <view>
            <view class="user-stats-d-kicker">已完善资料</view>
            <view class="user-stats-d-title">用户统计</view>
          </view>
          <view class="user-stats-d-actions">
            <button
              class="usage-refresh-button user-stats-d-action"
              bindtap="refreshUserStats"
              loading="{{userStatsLoading}}"
              disabled="{{userStatsLoading}}"
            >{{userStatsLoading ? '刷新中' : '刷新'}}</button>
            <button
              class="usage-export-button user-stats-d-action"
              bindtap="exportUserStats"
              loading="{{userStatsExporting}}"
              disabled="{{userStatsExporting}}"
            >{{userStatsExporting ? '生成中' : '导出'}}</button>
          </view>
        </view>
        <view class="user-stats-d-helper">
          这里显示已保存个人资料的用户，不是小程序访问人数。
        </view>
        <view class="user-stats-filter-panel">
          <view class="user-stats-search-row">
            <view class="user-stats-search-box">
              <text class="user-stats-search-icon">⌕</text>
              <input
                class="user-stats-search-input"
                value="{{userSearchInput}}"
                maxlength="32"
                placeholder="搜索昵称或匿名编号"
                confirm-type="search"
                bindinput="onUserSearchInput"
                bindconfirm="applyUserSearch"
              />
            </view>
            <view
              class="user-stats-search-action"
              bindtap="applyUserSearch"
              hover-class="control-tap"
              role="button"
              aria-label="搜索用户"
            >搜索</view>
            <view
              wx:if="{{userSearchInput || userSearch}}"
              class="user-stats-search-clear"
              bindtap="clearUserSearch"
              hover-class="control-tap"
              role="button"
              aria-label="清空用户搜索"
            >清空</view>
          </view>
          <view class="user-stats-filter-label">注册时间</view>
          <view class="user-stats-date-filter">
            <view
              wx:for="{{userDateRanges}}"
              wx:key="value"
              class="user-stats-date-option {{userDateRange === item.value ? 'is-active' : ''}}"
              data-range="{{item.value}}"
              bindtap="selectUserDateRange"
              hover-class="control-tap"
              role="button"
              aria-label="查看{{item.label}}注册用户"
            >{{item.label}}</view>
          </view>
          <view wx:if="{{userDateRange === 'custom'}}" class="user-custom-date-row">
            <picker
              class="user-custom-date-picker"
              mode="date"
              value="{{userCustomStartDate}}"
              end="{{userTodayKey}}"
              bindchange="onUserCustomStartChange"
            >
              <view class="user-custom-date-value">
                <text>开始日期</text>
                <text>{{userCustomStartDate}}</text>
              </view>
            </picker>
            <text class="user-custom-date-separator">至</text>
            <picker
              class="user-custom-date-picker"
              mode="date"
              value="{{userCustomEndDate}}"
              end="{{userTodayKey}}"
              bindchange="onUserCustomEndChange"
            >
              <view class="user-custom-date-value">
                <text>结束日期</text>
                <text>{{userCustomEndDate}}</text>
              </view>
            </picker>
          </view>
          <view class="user-stats-filter-label">用户性别</view>
          <view class="user-stats-gender-filter">
            <view
              wx:for="{{userGenders}}"
              wx:key="value"
              class="user-stats-gender-option {{userGender === item.value ? 'is-active' : ''}}"
              data-gender="{{item.value}}"
              bindtap="selectUserGender"
              hover-class="control-tap"
              role="button"
              aria-label="只看{{item.label}}用户"
            >{{item.label}}</view>
          </view>
        </view>
        <view class="user-stats-d-state-row">
          <view class="config-state {{moduleStates.users.status === 'failed' ? 'is-off' : 'is-ready'}}">
            {{moduleStates.users.label}}
          </view>
          <text>用户身份已隐藏，只显示匿名编号</text>
        </view>
        <view wx:if="{{moduleStates.users.status === 'loading'}}" class="usage-message">
          正在读取用户统计...
        </view>
        <view wx:if="{{moduleStates.users.status === 'failed'}}" class="usage-message is-warn">
          {{moduleStates.users.message || '用户统计读取失败，请点击刷新。'}}
        </view>
        <view wx:if="{{userStats.message}}" class="usage-message {{userStats.unavailable ? 'is-warn' : ''}}">
          {{userStats.message}}
        </view>
        <view wx:if="{{moduleStates.users.status === 'ready' || moduleStates.users.hasData}}" class="user-stats-d-overview">
          <view class="user-stats-d-total">
            <text class="user-stats-d-total-value">{{userStats.total}}</text>
            <!-- 兼容旧完整校验：总用户 -->
            <text class="user-stats-d-total-label">已完善资料的用户</text>
          </view>
          <view
            class="user-stats-d-donut"
            style="background: conic-gradient(#df6f9a 0 {{userStats.femaleRatio}}%, #78a9ff {{userStats.femaleRatio}}% 100%);"
          >
            <view class="user-stats-d-donut-center">
              <text class="user-stats-d-donut-value">{{userStats.femaleRatio}}%</text>
              <text class="user-stats-d-donut-label">女性占比</text>
            </view>
          </view>
        </view>
        <view wx:if="{{moduleStates.users.status === 'ready' || moduleStates.users.hasData}}" class="user-stats-d-gender-grid">
          <view class="user-stats-d-gender-card is-male">
            <view class="user-stats-d-gender-icon">♂</view>
            <text class="user-stats-d-gender-value">{{userStats.maleCount}}</text>
            <text class="user-stats-d-gender-label">男性 · {{userStats.maleRatio}}%</text>
          </view>
          <view class="user-stats-d-gender-card is-female">
            <view class="user-stats-d-gender-icon">♀</view>
            <text class="user-stats-d-gender-value">{{userStats.femaleCount}}</text>
            <text class="user-stats-d-gender-label">女性 · {{userStats.femaleRatio}}%</text>
          </view>
        </view>
        <view wx:if="{{moduleStates.users.status === 'ready' || moduleStates.users.hasData}}" class="user-signup-trend">
          <view class="user-signup-trend-head">
            <view>
              <view class="user-signup-trend-title">最近7天新增用户</view>
              <view class="user-signup-trend-help">按完善资料的日期统计</view>
            </view>
            <text>共 {{userStats.signupTrendTotal}} 人</text>
          </view>
          <view class="user-signup-trend-chart">
            <view wx:for="{{userStats.signupTrend}}" wx:key="dateKey" class="user-signup-trend-day">
              <view class="user-signup-trend-bar-area">
                <text class="user-signup-trend-count">{{item.count}}</text>
                <view
                  class="user-signup-trend-bar {{item.count ? '' : 'is-zero'}}"
                  style="height: {{item.barPercent}}%;"
                ></view>
              </view>
              <text class="user-signup-trend-label">{{item.label}}</text>
            </view>
          </view>
        </view>
        <view
          wx:if="{{moduleStates.users.status === 'ready' || moduleStates.users.hasData}}"
          class="user-stats-d-list-title"
        >
          用户明细 · {{userStats.total}}人
        </view>
        <view wx:if="{{(moduleStates.users.status === 'ready' || moduleStates.users.hasData) && userStats.users.length}}" class="admin-user-list user-stats-d-user-list">
          <view
            wx:for="{{userStats.users}}"
            wx:key="userHash"
            class="admin-user-row user-stats-d-user-row"
            data-index="{{index}}"
            bindtap="openUserDetail"
            hover-class="control-tap"
            role="button"
            aria-label="查看{{item.nickname}}的用户详情"
          >
            <image wx:if="{{item.avatarUrl}}" class="admin-user-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="admin-user-avatar admin-user-avatar-empty">人</view>
            <view class="admin-user-copy">
              <view class="admin-user-name">{{item.nickname}}</view>
              <view class="admin-user-meta">{{item.genderText}} · {{item.createdAtText}}</view>
              <view class="admin-user-id">编号 {{item.userHash}}</view>
            </view>
            <view class="admin-user-side">
              <view class="admin-user-gender gender-{{item.gender}}">{{item.genderText}}</view>
              <text class="admin-user-detail-arrow">›</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{moduleStates.users.status === 'ready' || moduleStates.users.hasData}}" class="admin-empty">没有符合条件的用户。</view>
        <button
          wx:if="{{userStats.nextOffset !== null}}"
          class="user-load-more"
          bindtap="loadMoreUsers"
          loading="{{userStatsLoading}}"
          disabled="{{userStatsLoading}}"
        >{{userStatsLoading ? '加载中...' : '继续加载20条'}}</button>
        <view
          wx:if="{{userDetailVisible && selectedUserDetail}}"
          class="user-detail-mask"
          bindtap="closeUserDetail"
          catchtouchmove="stopUserDetailTap"
        >
          <view class="user-detail-sheet" catchtap="stopUserDetailTap">
            <view class="user-detail-handle"></view>
            <view class="user-detail-head">
              <view>
                <view class="user-detail-kicker">用户详情</view>
                <view class="user-detail-title">已完善资料</view>
              </view>
              <view
                class="user-detail-close"
                bindtap="closeUserDetail"
                hover-class="control-tap"
                role="button"
                aria-label="关闭用户详情"
              >×</view>
            </view>
            <view class="user-detail-profile">
              <image
                wx:if="{{selectedUserDetail.avatarUrl}}"
                class="user-detail-avatar"
                src="{{selectedUserDetail.avatarUrl}}"
                mode="aspectFill"
              ></image>
              <view wx:else class="user-detail-avatar user-detail-avatar-empty">人</view>
              <view class="user-detail-profile-copy">
                <view class="user-detail-name">{{selectedUserDetail.nickname}}</view>
                <view class="admin-user-gender gender-{{selectedUserDetail.gender}}">{{selectedUserDetail.genderText}}</view>
              </view>
            </view>
            <view class="user-detail-fields">
              <view class="user-detail-field">
                <text>匿名编号</text>
                <text>{{selectedUserDetail.userHash}}</text>
              </view>
              <view class="user-detail-field">
                <text>首次完善资料</text>
                <text>{{selectedUserDetail.createdAtText}}</text>
              </view>
              <view class="user-detail-field">
                <text>最近修改时间</text>
                <text>{{selectedUserDetail.updatedAtText}}</text>
              </view>
            </view>
            <view class="user-detail-privacy">用户身份已隐藏，这里不会显示原始 OpenID。</view>
          </view>
        </view>
      </view>

      <view wx:if="{{activeConfigSection !== 'users'}}" class="admin-actions">
        <view
          class="admin-action-button primary-btn admin-save-button {{saving ? 'is-disabled' : ''}}"
          bindtap="saveConfig"
          hover-class="control-tap"
          role="button"
          aria-label="保存全部配置"
        >
          {{saving ? '保存中...' : '保存全部配置'}}
        </view>
        <view
          class="admin-action-button secondary-btn admin-close-button"
          bindtap="closeConfigSection"
          hover-class="control-tap"
          role="button"
          aria-label="暂不修改并收起"
        >暂不修改</view>
      </view>
    </view>

    <view
      class="monitor-toggle {{monitorExpanded ? 'is-open' : ''}}"
      bindtap="toggleMonitor"
      hover-class="control-tap"
      role="button"
      aria-label="{{monitorExpanded ? '收起运行监控' : '展开运行监控'}}"
    >
      <view>
        <view class="monitor-toggle-title">运行监控</view>
        <view class="monitor-toggle-subtitle">
          {{deployment && deployment.face.ready && deployment.analysis.ready && deployment.image.ready && deployment.video.ready ? '部署检查通过' : '部署状态待确认'}}
          · 自动贴脸失败 {{autoFaceFailureStats.total30d || 0}} 条
          · 错误日志 {{diagnosticLogs.summary.errorCount || 0}} 条
        </view>
      </view>
      <view class="monitor-toggle-actions">
        <view
          class="monitor-filter-button {{monitorOnlyAbnormal ? 'is-active' : ''}}"
          catchtap="toggleMonitorOnlyAbnormal"
          hover-class="control-tap"
          role="button"
          aria-label="{{monitorOnlyAbnormal ? '查看全部监控内容' : '只看异常内容'}}"
        >{{monitorOnlyAbnormal ? '看全部' : '只看异常'}}</view>
        <view
          class="monitor-all-button"
          data-expanded="1"
          catchtap="setAllMonitorSections"
          hover-class="control-tap"
          role="button"
          aria-label="全部展开监控模块"
        >全展开</view>
        <view
          class="monitor-all-button"
          data-expanded="0"
          catchtap="setAllMonitorSections"
          hover-class="control-tap"
          role="button"
          aria-label="全部收起监控模块"
        >全收起</view>
        <text class="monitor-toggle-arrow">{{monitorExpanded ? '⌃' : '⌄'}}</text>
      </view>
    </view>

    <view wx:if="{{monitorExpanded}}" class="monitor-content">
      <view class="monitor-overview-card">
        <view class="monitor-overview-main">
          <view class="monitor-overview-kicker">系统运行概览</view>
          <view class="monitor-overview-title">{{dashboardStatus.title}}</view>
          <view
            class="monitor-overview-note monitor-overview-note-action"
            data-section="autoFaceFailure"
            catchtap="jumpToMonitorSection"
            hover-class="control-tap"
            role="button"
            aria-label="查看自动贴脸失败统计"
          >
            部署检查通过；自动贴脸有 {{autoFaceFailureStats.total30d || 0}} 条失败待查看。
          </view>
        </view>
        <view class="monitor-overview-stats">
          <view
            class="monitor-overview-stat monitor-overview-stat-action"
            data-section="usage"
            catchtap="jumpToMonitorSection"
            hover-class="control-tap"
            role="button"
            aria-label="查看模型用量统计"
          >
            <text>今日成本</text>
            <text>¥{{usageStats.today.estimatedCostDisplay}}</text>
          </view>
          <view
            class="monitor-overview-stat monitor-overview-stat-action"
            data-section="autoFaceFailure"
            catchtap="jumpToMonitorSection"
            hover-class="control-tap"
            role="button"
            aria-label="查看自动贴脸失败统计"
          >
            <text>自动贴脸失败</text>
            <text>{{autoFaceFailureStats.total30d || 0}}</text>
          </view>
          <view
            class="monitor-overview-stat monitor-overview-stat-action"
            data-section="diagnosticLogs"
            catchtap="jumpToMonitorSection"
            hover-class="control-tap"
            role="button"
            aria-label="查看错误日志"
          >
            <text>错误日志</text>
            <text>{{diagnosticLogs.summary.errorCount || 0}}</text>
          </view>
          <view
            class="monitor-overview-stat monitor-overview-stat-action"
            data-section="deployment"
            catchtap="jumpToMonitorSection"
            hover-class="control-tap"
            role="button"
            aria-label="查看部署记录"
          >
            <text>部署记录</text>
            <text>{{logs.length}}</text>
          </view>
        </view>
      </view>

      <view
        id="monitor-section-deployment"
        class="monitor-deployment-group {{monitorSections.deployment ? 'is-open' : 'is-collapsed'}}"
      >
        <view
          class="monitor-section-head"
          data-section="deployment"
          catchtap="toggleMonitorSection"
          hover-class="control-tap"
          role="button"
          aria-label="{{monitorSections.deployment ? '收起部署与探针' : '展开部署与探针'}}"
        >
          <view class="monitor-section-head-main">
            <view class="monitor-section-title-row">
              <text class="monitor-status-dot {{deployment && deployment.face.ready && deployment.analysis.ready && deployment.image.ready && deployment.video.ready ? '' : 'is-danger'}}"></text>
              <text class="monitor-section-title">部署与探针</text>
            </view>
            <text class="monitor-section-summary">
              {{deployment && deployment.face.ready && deployment.analysis.ready && deployment.image.ready && deployment.video.ready ? '运行正常' : '需要处理'}}
              · 探针历史 {{autoFaceProbeHistory.history.length}} 条
            </text>
          </view>
          <view class="monitor-section-toggle-button">
            <text>{{monitorSections.deployment ? '收起' : '展开'}}</text>
            <text class="monitor-section-chevron {{monitorSections.deployment ? 'is-open' : ''}}">⌄</text>
          </view>
        </view>

        <view wx:if="{{monitorSections.deployment}}" class="monitor-deployment-body">
      <view wx:if="{{deployment}}" class="card admin-section deployment-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">当前线上部署</view>
            <view class="admin-section-help">当前云函数版本和动态配置状态。</view>
          </view>
          <text class="{{deployment.face.ready && deployment.analysis.ready && deployment.image.ready && deployment.video.ready ? 'log-ok' : 'log-warn'}}">
            {{deployment.face.ready && deployment.analysis.ready && deployment.image.ready && deployment.video.ready ? '运行正常' : '需要处理'}}
          </text>
        </view>
        <view class="deployment-grid">
          <view><text>云函数版本</text><text>{{deployment.buildVersion}}</text></view>
          <view><text>构建标记</text><text>{{deployment.buildMarker}}</text></view>
          <view><text>人脸状态</text><text>{{deployment.face.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>图片分析状态</text><text>{{deployment.analysis.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>生图状态</text><text>{{deployment.image.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>视频状态</text><text>{{deployment.video.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>动态配置版本</text><text>{{deployment.runtimeConfigVersion}}</text></view>
          <view><text>检查时间</text><text>{{deployment.checkedAt}}</text></view>
        </view>
      </view>

      <view wx:if="{{autoFaceProbe.available || autoFaceProbe.status === 'failed'}}" class="card admin-section auto-face-probe-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">自动贴脸探针</view>
            <view class="admin-section-help">显示线上版本、接口耗时和视觉配置状态。</view>
          </view>
          <text class="{{autoFaceProbe.status === 'ok' ? 'log-ok' : 'log-warn'}}">{{autoFaceProbe.statusText}}</text>
        </view>
        <view class="deployment-grid">
          <view><text>云函数版本</text><text>{{autoFaceProbe.buildVersion || '未知'}}</text></view>
          <view><text>构建标记</text><text>{{autoFaceProbe.buildMarker || '未知'}}</text></view>
          <view><text>视觉配置</text><text>{{autoFaceProbe.visionConfigured ? '已就绪' : '未就绪'}}</text></view>
          <view><text>Provider / Model</text><text>{{autoFaceProbe.provider || '未知'}} / {{autoFaceProbe.model || '未知'}}</text></view>
          <view><text>Node.js</text><text>{{autoFaceProbe.nodeVersion || '未知'}}</text></view>
          <view><text>接口耗时</text><text>{{autoFaceProbe.durationText}}</text></view>
          <view><text>云函数处理耗时</text><text>{{autoFaceProbe.serverDurationText}}</text></view>
          <view><text>检查时间</text><text>{{autoFaceProbe.checkedAtText}}</text></view>
        </view>
        <view wx:if="{{autoFaceProbe.message}}" class="usage-message is-warn">{{autoFaceProbe.message}}</view>
      </view>

      <view wx:if="{{modelProbes.available || modelProbes.status === 'failed'}}" class="card admin-section model-probe-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">四套模型接口探测</view>
            <view class="admin-section-help">只检查线上接口、密钥和模型配置，不会消耗生图或视频额度。</view>
          </view>
          <text class="{{modelProbes.status === 'ok' ? 'log-ok' : 'log-warn'}}">{{modelProbes.statusText}}</text>
        </view>
        <view class="deployment-grid">
          <view><text>云函数版本</text><text>{{modelProbes.buildVersion || '未知'}}</text></view>
          <view><text>构建标记</text><text>{{modelProbes.buildMarker || '未知'}}</text></view>
          <view><text>正常数量</text><text>{{modelProbes.readyCount}} / {{modelProbes.total}}</text></view>
          <view><text>检查时间</text><text>{{modelProbes.checkedAtText}}</text></view>
        </view>
        <view class="model-probe-list">
          <view wx:for="{{modelProbes.results}}" wx:key="type" class="model-probe-row">
            <view class="model-probe-main">
              <view class="model-probe-title">{{item.typeLabel}}</view>
              <view class="model-probe-meta">{{item.provider}} / {{item.model}}</view>
              <view class="model-probe-message">{{item.message}}</view>
            </view>
            <view class="model-probe-side">
              <text class="{{item.ready ? 'log-ok' : 'log-warn'}}">{{item.statusText}}</text>
              <text>{{item.durationText}}</text>
              <view
                class="model-probe-single-button {{modelProbingType === item.type ? 'is-disabled' : ''}}"
                data-model-type="{{item.type}}"
                catchtap="probeSingleModel"
                hover-class="control-tap"
                role="button"
                aria-label="单独探测{{item.typeLabel}}"
              >{{modelProbingType === item.type ? '探测中' : '单独探测'}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{modelProbes.message}}" class="usage-message is-warn">{{modelProbes.message}}</view>
      </view>

      <view class="card admin-section auto-face-probe-history-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">探针历史</view>
            <view class="admin-section-help">最近 {{autoFaceProbeHistory.retentionDays}} 天，最多显示 20 条。</view>
          </view>
          <view class="admin-section-tools">
            <view class="config-state {{moduleStates.probeHistory.status === 'failed' ? 'is-off' : 'is-ready'}}">
              {{moduleStates.probeHistory.label}}
            </view>
            <button class="usage-refresh-button" bindtap="refreshAutoFaceProbeHistory">刷新</button>
          </view>
        </view>
        <view wx:if="{{moduleStates.probeHistory.status === 'loading'}}" class="usage-message">
          正在读取探针历史...
        </view>
        <view wx:if="{{moduleStates.probeHistory.status === 'failed'}}" class="usage-message is-warn">
          {{moduleStates.probeHistory.message || '探针历史读取失败，请点击刷新。'}}
        </view>
        <view wx:if="{{autoFaceProbeHistory.message}}" class="usage-message {{autoFaceProbeHistory.unavailable ? 'is-warn' : ''}}">
          {{autoFaceProbeHistory.message}}
        </view>
        <view wx:if="{{(moduleStates.probeHistory.status === 'ready' || moduleStates.probeHistory.hasData) && !autoFaceProbeHistory.history.length && !autoFaceProbeHistory.message}}" class="admin-empty">
          还没有探针历史，点击“立即检查线上部署”生成第一条。
        </view>
        <view wx:for="{{autoFaceProbeHistory.history}}" wx:key="checkedAt" class="auto-face-probe-history-row">
          <view class="auto-face-probe-history-top">
            <view>
              <text class="{{item.status === 'ok' ? 'log-ok' : 'log-warn'}}">{{item.statusText}}</text>
              <text class="auto-face-probe-history-time">{{item.checkedAtText}}</text>
            </view>
            <text class="auto-face-probe-history-duration">{{item.durationText}}</text>
