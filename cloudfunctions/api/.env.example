# 视觉能力优先读取 AI_VISION_*；缺失时兼容回退旧 AI_*。
AI_VISION_PROVIDER=dashscope
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_API_KEY=不要把真实密钥提交到代码仓库
AI_VISION_MODEL=qwen3-vl-flash
AI_FACE_MODEL=qwen3-vl-flash
AI_VISION_TIMEOUT_MS=25000
AI_VISION_MAX_IMAGE_BYTES=5242880

# 旧配置兼容项。新部署不需要同时填写，生图接入时再单独规划。
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=不要把真实密钥提交到代码仓库
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_SIZE=1024x1024
AI_TIMEOUT_MS=90000
DAILY_GENERATION_LIMIT=5
AI_IMAGE_MODE=generations
AI_IMAGE_EDIT_ENDPOINT=
AI_IMAGE_MAIN_FIELD=image
AI_IMAGE_MASK_FIELD=mask
AI_IMAGE_REFERENCE_FIELD=image[]
AI_MASK_INVERT=false
AI_MAX_RETRIES=2
AI_IMAGE_RETRY_ENABLED=false

# 如果中转站路径与标准路径不同，可以单独填写：
# AI_VISION_ENDPOINT=https://example.com/v1/chat/completions
# AI_IMAGE_ENDPOINT=https://example.com/v1/images/generations
# 编辑模式默认使用 {AI_BASE_URL}/images/edits，也可以单独指定：
# AI_IMAGE_EDIT_ENDPOINT=https://example.com/v1/images/edits
