page { background:#f4f8fe; color:#10294b; font-family:"Microsoft YaHei","PingFang SC","SimHei",system-ui,sans-serif; }
.operations-page { min-height:100vh; overflow-x:hidden; background:#f4f8fe; }
.appbar { width:100%; min-height:0; padding:0 30rpx 24rpx; display:flex; align-items:flex-end; justify-content:space-between; gap:12rpx; box-sizing:border-box; background:#fff; border-bottom:2rpx solid #d9e4f2; }
.appbar-tools { flex:0 0 auto; min-width:0; display:flex; align-items:center; gap:12rpx; }
.demo-control { display:flex; align-items:center; gap:2rpx; color:#61799a; font-size:17rpx; font-weight:900; }
.demo-control.locked { opacity:.48; }
.demo-toggle { width:56rpx; height:32rpx; margin-left:5rpx; padding:3rpx; box-sizing:border-box; border-radius:18rpx; background:#cbd6e4; }
.demo-toggle.on { background:#2f73ee; }
.demo-knob { width:26rpx; height:26rpx; border-radius:50%; background:#fff; box-shadow:0 2rpx 6rpx rgba(16,41,75,.18); transform:translateX(0); transition:transform .16s ease; }
.demo-toggle.on .demo-knob { transform:translateX(24rpx); }

.appbar-title { flex:1; min-width:0; overflow:hidden; color:#10294b; font-size:42rpx; line-height:38rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.appbar-link { flex:0 0 auto; color:#2f73ee; font-size:24rpx; line-height:38rpx; font-weight:900; white-space:nowrap; }
.appbar-link text { margin-left:4rpx; font-size:30rpx; }
.operations-scroll { width:calc(100% - 48rpx); min-height:0; margin:0 24rpx; padding:24rpx 0 calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; overflow-x:hidden; }
.overview-card { margin-bottom:19rpx; padding:27rpx; border:0; border-radius:27rpx; background:linear-gradient(145deg,#2f73ee 0%,#315fd0 100%); color:#fff; box-shadow:0 14rpx 30rpx rgba(47,115,238,.18); }
.overview-eyebrow { display:block; color:#dce9ff; font-size:17rpx; line-height:1; font-weight:900; letter-spacing:2rpx; }
.overview-title { display:block; margin-top:8rpx; color:#fff; font-size:40rpx; line-height:1.15; font-weight:900; }
.overview-description { display:block; margin-top:6rpx; color:#e3edff; font-size:17rpx; line-height:1.45; }
.overview-actions { margin-top:21rpx; display:flex; align-items:center; justify-content:flex-start; gap:13rpx; text-align:left; }
.overview-button { display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; min-width:0 !important; width:auto !important; height:65rpx; margin:0 !important; margin-left:0 !important; margin-right:0 !important; padding:0 32rpx; border:2rpx solid rgba(255,255,255,.42); border-radius:15rpx; background:rgba(255,255,255,.1); color:#fff; font-size:19rpx; line-height:1; font-weight:900; white-space:nowrap; }
.overview-button[disabled] { opacity:.55; }
.summary-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:13rpx; margin-bottom:19rpx; }
.summary-item { min-width:0; min-height:0; padding:19rpx 12rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; border:2rpx solid #c8dbf3; border-radius:21rpx; background:#fff; text-align:center; }
.summary-label { display:block; color:#61799a; font-size:16rpx; line-height:1.2; }
.summary-value { display:block; max-width:100%; margin-top:8rpx; overflow:hidden; color:#10294b; font-size:31rpx; line-height:1.1; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.detail-list { margin-top:0; }
.detail-card { margin-bottom:15rpx; padding:21rpx; border:2rpx solid #c8dbf3; border-radius:23rpx; background:#fff; }
.detail-head { min-width:0; display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:16rpx; }
.detail-copy { min-width:0; }
.detail-title { display:block; overflow:hidden; color:#10294b; font-size:25rpx; line-height:1.25; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.detail-description { display:block; margin-top:6rpx; overflow:hidden; color:#61799a; font-size:17rpx; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.detail-toggle { width:112rpx; min-width:112rpx; height:65rpx; justify-self:end; display:flex; align-items:center; justify-content:center; box-sizing:border-box; margin:0; padding:0 12rpx; border:2rpx solid #b6d2f5; border-radius:15rpx; background:#f2f7ff; color:#2f73ee; font-size:19rpx; line-height:1; font-weight:900; }
.detail-body { margin-top:20rpx; padding:20rpx; border:2rpx dashed #9ec5f7; border-radius:20rpx; background:#f9fbff; }
.detail-line { display:block; color:#244668; font-size:18rpx; line-height:1.55; word-break:break-all; }
.foot-note { margin-top:0; padding:19rpx; border-radius:19rpx; background:#edf5ff; color:#61799a; font-size:18rpx; line-height:1.5; }
.empty-note { margin-top:0; padding:19rpx; border-radius:19rpx; background:#edf5ff; color:#61799a; font-size:18rpx; line-height:1.5; }
.message { margin-top:20rpx; padding:20rpx 24rpx; border-radius:20rpx; background:#e5f8f1; color:#07875c; font-size:18rpx; line-height:1.4; }
.bottom-space { height:64rpx; }
.tap { opacity:.78; }
