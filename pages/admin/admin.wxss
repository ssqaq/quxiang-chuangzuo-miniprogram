}

.auto-face-probe-card {
  margin-top: 0;
}

.model-probe-card {
  margin-top: 0;
}

.model-probe-tools {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
}

.model-probe-refresh-button {
  width: 160rpx;
  min-width: 160rpx;
}

.model-probe-list {
  margin-top: 16rpx;
}

.model-probe-row {
  display: flex;
  padding: 18rpx 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.model-probe-row:last-child {
  border-bottom: 0;
}

.model-probe-main {
  min-width: 0;
  flex: 1;
}

.model-probe-title {
  color: #1d2a3e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.model-probe-meta,
.model-probe-message {
  margin-top: 5rpx;
  overflow: hidden;
  color: #718096;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
}

.model-probe-meta {
  white-space: nowrap;
}

.model-probe-message {
  white-space: normal;
}

.model-probe-quality {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #d7e4f7;
  border-radius: 14rpx;
  background: #f7faff;
}

.model-probe-quality-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #315a9d;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.model-probe-quality-head text:last-child {
  flex: none;
  color: #4d79bf;
  font-size: 18rpx;
  font-weight: 700;
}

.model-probe-quality-note {
  margin-top: 4rpx;
  color: #7b8da8;
  font-size: 17rpx;
  line-height: 25rpx;
}

.model-probe-quality-values {
  display: flex;
  margin-top: 8rpx;
  gap: 8rpx;
}

.model-probe-quality-value {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 7rpx 8rpx;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  border: 1rpx solid #dce7f6;
  border-radius: 10rpx;
  background: #ffffff;
  color: #526986;
  font-size: 18rpx;
  line-height: 24rpx;
}

.model-probe-quality-value text:first-child {
  font-weight: 800;
}

.model-probe-quality-unknown {
  color: #8a98aa;
}

.admin-quality-compat-row {
  margin-top: 16rpx;
}

.admin-quality-compat-help {
  margin-top: 10rpx;
}

.model-probe-side {
  display: flex;
  flex: none;
  min-width: 112rpx;
  align-items: flex-end;
  flex-direction: column;
  gap: 6rpx;
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.model-probe-single-button {
  display: flex;
  min-width: 108rpx;
  height: 48rpx;
  margin-top: 4rpx;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c8d8ee;
  border-radius: 14rpx;
  color: #2869d7;
  background: #eef5ff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.model-probe-single-button.is-disabled {
  color: #8a99ad;
  background: #f3f5f8;
  opacity: 0.75;
}

.auto-face-probe-history-card {
  margin-top: 0;
}

.auto-face-probe-history-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.auto-face-probe-history-row:last-child {
  border-bottom: 0;
}

.auto-face-probe-history-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  font-size: 22rpx;
}

.auto-face-probe-history-top view {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.auto-face-probe-history-time {
  color: #7a879a;
  font-size: 22rpx;
}

.auto-face-probe-history-duration {
  flex: none;
  color: #2f659d;
  font-size: 22rpx;
  font-weight: 700;
}

.auto-face-probe-history-meta,
.auto-face-probe-history-error {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-face-probe-history-error {
  color: #b36d18;
}

.deployment-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.deployment-grid view {
  min-width: 0;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.deployment-grid text {
  display: block;
  overflow: hidden;
  color: #7d899b;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deployment-grid text + text {
  margin-top: 4rpx;
  color: #26354b;
  font-size: 22rpx;
}

.admin-log-count {
  color: #7b8ba1;
  font-size: 21rpx;
}

.diagnostic-admin-section {
  overflow: hidden;
}

.diagnostic-admin-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.diagnostic-admin-summary-item {
  min-width: 0;
  padding: 16rpx 8rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 14rpx;
  background: #f8fafc;
  text-align: center;
}

.diagnostic-admin-summary-item text {
  display: block;
  color: #7b8798;
  font-size: 18rpx;
}

.diagnostic-admin-summary-item text + text {
  margin-top: 6rpx;
  color: #21334d;
  font-size: 28rpx;
  font-weight: 800;
}

.diagnostic-admin-summary-item.is-error {
  border-color: #f0caca;
  background: #fff6f6;
}

.diagnostic-admin-summary-item.is-error text + text {
  color: #bd3d3d;
}

.diagnostic-admin-summary-item.is-warn {
  border-color: #f1d7ad;
  background: #fff9ef;
}

.diagnostic-admin-summary-item.is-warn text + text {
  color: #aa681b;
}

.diagnostic-admin-summary-item.is-info text + text {
  color: #267849;
}

.diagnostic-admin-filter-block {
  margin-top: 20rpx;
}

.diagnostic-admin-filter-title {
  margin-bottom: 10rpx;
  color: #617086;
  font-size: 20rpx;
  font-weight: 700;
}

.diagnostic-admin-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.diagnostic-admin-filter-row {
  display: flex;
  width: max-content;
  min-width: 100%;
  gap: 10rpx;
}

.diagnostic-admin-filter-chip {
  display: flex;
  flex: none;
  min-width: 78rpx;
  height: 54rpx;
  padding: 0 16rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  color: #627087;
  background: #f7f9fc;
  font-size: 19rpx;
  font-weight: 700;
}

.diagnostic-admin-filter-chip.is-active {
  border-color: #3977dc;
  color: #ffffff;
  background: #3977dc;
}

.diagnostic-admin-user-picker {
  display: flex;
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  color: #53627a;
  background: #f8fafc;
  font-size: 20rpx;
}

.diagnostic-admin-user-picker text + text {
  max-width: 68%;
  overflow: hidden;
  color: #2868c9;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diagnostic-admin-category-summary {
  display: flex;
  margin-top: 18rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.diagnostic-admin-category-item {
  display: flex;
  padding: 10rpx 14rpx;
  align-items: center;
  gap: 8rpx;
  border-radius: 12rpx;
  color: #617087;
  background: #eef3f9;
  font-size: 18rpx;
}

.diagnostic-admin-category-item text + text {
  color: #2c5f9f;
  font-weight: 800;
}

.diagnostic-admin-list {
  margin-top: 18rpx;
}

.diagnostic-admin-log {
  margin-top: 12rpx;
  padding: 18rpx;
  border: 1rpx solid #dfe6ef;
  border-left: 6rpx solid #7ea7df;
  border-radius: 16rpx;
  background: #ffffff;
}

.diagnostic-admin-log.level-error {
  border-color: #f0cccc;
  border-left-color: #d55353;
  background: #fffafa;
}

.diagnostic-admin-log.level-warn {
  border-color: #f0d8b4;
  border-left-color: #d18a2e;
  background: #fffcf6;
}

.diagnostic-admin-log.level-info {
  border-left-color: #55a679;
}

.diagnostic-admin-log-top,
.diagnostic-admin-log-tags,
.diagnostic-admin-log-actions {
  display: flex;
  align-items: center;
}

.diagnostic-admin-log-top {
  justify-content: space-between;
  gap: 12rpx;
}

.diagnostic-admin-log-tags,
.diagnostic-admin-log-actions {
  gap: 10rpx;
}

.diagnostic-admin-level,
.diagnostic-admin-category {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  color: #ffffff;
  background: #617994;
  font-size: 17rpx;
  font-weight: 800;
}

.level-error .diagnostic-admin-level {
  background: #c84848;
}

.level-warn .diagnostic-admin-level {
  background: #bd7624;
}

.level-info .diagnostic-admin-level {
  background: #3b9061;
}

.diagnostic-admin-category {
  color: #47617f;
  background: #eaf0f7;
}

.diagnostic-admin-time {
  flex: none;
  color: #7b8797;
  font-size: 18rpx;
}

.diagnostic-admin-message {
  margin-top: 14rpx;
  color: #24344b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.diagnostic-admin-meta {
  display: flex;
  margin-top: 10rpx;
  flex-wrap: wrap;
  gap: 6rpx 14rpx;
  color: #748196;
  font-size: 18rpx;
  line-height: 28rpx;
}

.diagnostic-admin-log-actions {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-top: 14rpx;
  overflow: hidden;
}

.diagnostic-log-action-button {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diagnostic-log-action-button.is-split {
  width: 0;
  flex: 1 1 0;
}

.diagnostic-log-action-button.is-single {
  flex: 0 1 112rpx;
  width: 112rpx;
}

.diagnostic-detail-button {
  color: #426b9c;
  background: #edf3fa;
}

.diagnostic-admin-detail {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  color: #5c6b80;
  background: #f2f5f9;
  font-size: 18rpx;
  line-height: 28rpx;
  word-break: break-all;
}

.diagnostic-admin-detail view + view {
  margin-top: 12rpx;
}

.diagnostic-admin-detail text {
  display: block;
}

.diagnostic-admin-detail text:first-child {
  margin-bottom: 5rpx;
  color: #2f415c;
  font-weight: 800;
}

.admin-empty {
  padding: 22rpx 0 4rpx;
  color: #8390a3;
  font-size: 22rpx;
}

.admin-log-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.admin-log-item:last-child {
  border-bottom: 0;
}

.admin-log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334258;
  font-size: 22rpx;
}

.admin-log-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-ok {
  color: #23834b;
}

.log-warn {
  color: #b36d18;
}

/* 管理员页统一视觉收口：主卡片 22rpx，内部卡片 18rpx，按钮 14rpx。 */
.admin-page {
  --admin-space-1: 8rpx;
  --admin-space-2: 12rpx;
  --admin-space-3: 16rpx;
  --admin-space-4: 20rpx;
  --admin-space-5: 24rpx;
  --admin-space-head: 18rpx;
  --admin-radius-card: 22rpx;
  --admin-radius-inner: 18rpx;
  --admin-radius-small: 16rpx;
  --admin-radius-control: 14rpx;
  --admin-border-soft: #e7edf5;
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.card,
.status-console,
.monitor-toggle,
.monitor-overview-card,
.monitor-deployment-group,
.admin-section,
.admin-state-card,
.config-editor {
  border-radius: var(--admin-radius-card);
}

.quick-launch,
.current-config-row,
.today-item,
.usage-collapsed-statistics-card {
  border-radius: var(--admin-radius-inner);
}

.usage-summary-item,
.usage-cost-item,
.usage-type-card,
.monitor-overview-stats > view,
.diagnostic-admin-summary-item,
.deployment-grid view,
.auto-face-probe-summary-item,
.auto-face-failure-summary-item,
.usage-failure-summary-item {
  border-radius: var(--admin-radius-small);
}

.config-close-button,
.config-tool-button,
.admin-back-button,
.admin-retry-button,
.usage-refresh-button,
.usage-export-button,
.monitor-section-toggle-button,
.monitor-all-button,
.usage-subsection-toggle,
.model-probe-single-button {
  border-radius: var(--admin-radius-control);
}

.status-console {
  margin-top: var(--admin-space-4);
}

.quick-launch-grid {
  gap: var(--admin-space-3);
  margin-top: var(--admin-space-4);
}

.overview-section {
  margin-top: var(--admin-space-head);
}

.today-grid {
  gap: var(--admin-space-3);
}

.admin-content {
  margin-top: var(--admin-space-4);
}

.admin-section {
  margin-bottom: var(--admin-space-4);
}

.monitor-content {
  margin-top: var(--admin-space-4);
}

.monitor-deployment-body .admin-section {
  margin-bottom: var(--admin-space-3);
}

.admin-content > .admin-section + .admin-section,
.monitor-deployment-body > .admin-section + .admin-section {
  border-top-color: var(--admin-border-soft);
}

.admin-section-head {
  gap: var(--admin-space-head);
  padding-bottom: var(--admin-space-4);
}

.module-fold-body,
.usage-fold-body {
  min-width: 0;
}

.module-loading-placeholder {
  padding-top: 2rpx;
}

.admin-loading-card {
  min-height: 560rpx;
  padding: 28rpx;
}

.admin-loading-title {
  color: #52647d;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.admin-loading-skeleton {
  position: relative;
  overflow: hidden;
  background: #edf2f8;
}

.admin-loading-skeleton::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -40%;
  width: 40%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
  content: "";
  animation: admin-skeleton-shimmer 1.35s ease-in-out infinite;
}

.admin-loading-skeleton-title {
  width: 56%;
  height: 28rpx;
  margin-top: var(--admin-space-head);
  border-radius: var(--admin-radius-control);
}

.admin-loading-skeleton-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--admin-space-2);
  margin-top: var(--admin-space-head);
}

.admin-loading-skeleton-tile {
  height: 116rpx;
  border-radius: var(--admin-radius-small);
}

.admin-loading-skeleton-row {
  width: 100%;
  height: 82rpx;
  margin-top: var(--admin-space-3);
  border-radius: var(--admin-radius-small);
}

.admin-loading-skeleton-panel {
  width: 100%;
  height: 210rpx;
  margin-top: var(--admin-space-3);
  border-radius: var(--admin-radius-inner);
}

.usage-fold-body.is-loading {
  min-height: 500rpx;
}

.module-fold-body.is-loading {
  min-height: 300rpx;
}

@keyframes admin-skeleton-shimmer {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(350%);
  }
}

@media (min-width: 360px) and (max-width: 389px) {
  .admin-page {
    padding-right: var(--admin-space-4);
    padding-left: var(--admin-space-4);
  }

  .quick-launch-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--admin-space-2);
  }

  .quick-launch {
    height: 132rpx;
  }

  .quick-launch-name {
    font-size: 19rpx;
  }

  .status-check-button {
    font-size: 21rpx;
  }
}

@media (min-width: 400px) and (max-width: 430px) {
  .admin-page {
    padding-right: var(--admin-space-5);
    padding-left: var(--admin-space-5);
  }

  .quick-launch-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--admin-space-3);
  }

  .quick-launch {
    height: 136rpx;
  }
}

@media (max-width: 360px) {
  .admin-page {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }

  .status-console,
  .admin-section,
  .admin-state-card,
  .config-editor {
    padding: 18rpx;
  }

  .status-console-actions {
    flex-wrap: wrap;
  }

  .status-check-button {
    flex: 1 1 calc(50% - 6rpx);
    width: calc(50% - 6rpx);
  }

  .status-check-button:last-child {
    flex-basis: 100%;
    width: 100%;
  }

  .quick-launch-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12rpx;
  }

  .quick-launch {
    height: 128rpx;
  }

  .admin-section-head,
  .admin-section-tools {
    gap: 10rpx;
  }

  .admin-section-tools,
  .usage-toolbar {
    width: 100%;
    flex-wrap: wrap;
  }

  .admin-section-tools > .config-state,
  .admin-section-tools > .usage-refresh-button {
    flex: 1 1 calc(50% - 5rpx);
    width: auto;
  }

  .monitor-section-head {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .monitor-deployment-body {
    padding-left: 8rpx;
  }

  .monitor-overview-card {
    padding: 18rpx;
  }

  .admin-loading-card {
    min-height: 520rpx;
  }

  .admin-loading-skeleton-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-grid,
  .deployment-grid {
    grid-template-columns: 1fr;
  }

  .admin-field-wide {
    grid-column: auto;
  }

  .admin-actions {
    flex-direction: column;
  }

  .usage-summary-grid,
  .usage-type-grid,
  .usage-cost-summary,
  .usage-failure-summary,
  .auto-face-failure-summary {
    grid-template-columns: 1fr;
  }

  .diagnostic-admin-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .usage-toolbar {
    align-items: stretch;
    flex-direction: column;
    margin-top: 10rpx;
  }

  .usage-primary-actions {
    width: 100%;
    min-width: 0;
    gap: 8rpx;
  }

  .usage-primary-actions > .usage-refresh-button,
  .usage-primary-actions > .usage-export-button {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    height: 52rpx;
    min-height: 52rpx;
    padding-right: 6rpx;
    padding-left: 6rpx;
    font-size: 18rpx;
  }

  .usage-refresh-button {
    flex: none;
  }

  .usage-export-button {
    flex: none;
  }

  .user-stats-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .user-stats-actions {
    width: 100%;
  }

  .user-stats-d-head {
    align-items: stretch;
    flex-direction: column;
    gap: 12rpx;
  }

  .user-stats-d-actions {
    width: 100%;
  }

  .user-stats-d-action {
    flex: 1;
    width: auto;
    min-width: 0;
  }

  .user-stats-d-overview {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }

  .model-probe-row {
    flex-direction: column;
  }

  .model-probe-side {
    width: 100%;
    align-items: flex-start;
  }

  .user-stats-d-donut {
    width: 148rpx;
    height: 148rpx;
  }
}

.usage-subsection-head,
.usage-collapsed-statistics-card > .usage-subsection-head {
  min-height: 92rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  align-items: center;
}

.admin-section-head,
.monitor-section-head {
  box-sizing: border-box;
  align-items: center;
}

.admin-section-head > view:first-child,
.monitor-section-head-main,
.usage-subsection-head > .usage-subsection-title {
  min-width: 0;
  flex: 1 1 auto;
}

.admin-section-head > .admin-section-tools,
.admin-section-head > .usage-toolbar,
