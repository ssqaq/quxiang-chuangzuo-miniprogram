<view wx:if="{{visualDemoControlVisible}}" class="visual-demo-control">
  <text>演示数据</text>
  <switch checked="{{visualDemoEnabled}}" bindchange="toggleVisualDemo" color="#1f6feb" />
</view>
<view class="recharge-page">
  <view wx:if="{{loading}}" class="recharge-loading" aria-label="正在加载充值配置">
    <view class="skeleton skeleton-balance"></view>
    <view class="skeleton skeleton-packages"></view>
    <view class="skeleton skeleton-channel"></view>
    <view class="skeleton skeleton-button"></view>
  </view>

  <block wx:else>
    <view wx:if="{{errorMessage}}" class="state-panel state-panel-error">
      <view class="state-icon">!</view>
      <view class="state-copy">
        <view class="state-title">充值配置加载失败</view>
        <view class="state-description">{{errorMessage}}</view>
      </view>
      <button class="state-action" bindtap="retryConfig">重试</button>
    </view>

    <block wx:else>
      <view class="recharge-balance">
        <text class="expected-label">本次预计到账</text>
        <view class="expected-value">
          <text>{{selectedGrantPointsText || '--'}}</text>
          <text class="expected-unit">积分</text>
        </view>
      </view>

      <view class="mini-block-title">选择充值套餐</view>
      <view wx:if="{{!packages.length}}" class="empty-panel">
        <view class="empty-title">暂无可选套餐</view>
        <view class="empty-description">套餐更新中，请稍后下拉刷新。</view>
      </view>
      <view wx:else class="package-grid">
        <view
          wx:for="{{packages}}"
          wx:key="productId"
          class="package-hit"
          data-product-id="{{item.productId}}"
          bindtap="selectPackage"
          role="button"
          aria-checked="{{selectedProductId === item.productId}}"
          aria-label="{{item.amountText}}购买{{item.grantPointsText || item.grantPoints}}积分"
        >
          <view class="package-card {{selectedProductId === item.productId ? 'package-card-selected' : ''}}">
            <view wx:if="{{item.productId === 'pkg_2990'}}" class="package-tag">推荐</view>
            <view class="package-points">{{item.grantPointsText || item.grantPoints}}</view>
            <view class="package-unit">积分</view>
            <view class="package-price">{{item.amountText}}</view>
            <view class="package-extra">
              {{item.productId === 'pkg_2990' ? '多送 30' : item.productId === 'pkg_5990' ? '多送 88' : '轻量体验'}}
            </view>
          </view>
        </view>
      </view>

      <view class="mini-block-title payment-title">
        <text>支付方式</text>
        <text class="payment-title-note">仅支持微信支付</text>
      </view>

      <view wx:if="{{eligible}}" class="channel-list">
        <view class="channel-row {{hasWxpay ? 'channel-row-selected' : 'channel-row-disabled'}}">
          <view class="channel-icon">微</view>
          <view class="channel-copy">
            <view class="channel-title">微信支付</view>
            <view class="channel-description">{{hasWxpay ? '当前可用' : channelMessage || '支付通道准备中'}}</view>
          </view>
          <view class="channel-check">{{hasWxpay ? '✓' : '…'}}</view>
        </view>
      </view>

      <view wx:if="{{paymentStatus !== 'idle'}}" class="payment-status payment-status-{{paymentStatus}}">
        <view class="payment-status-icon">
          {{paymentStatus === 'success' ? '✓' : paymentStatus === 'failed' ? '!' : paymentStatus === 'canceled' ? '×' : '…'}}
        </view>
        <view class="payment-status-copy">
          <view class="payment-status-title">{{statusTitle}}</view>
          <view class="payment-status-description">{{statusMessage}}</view>
          <view wx:if="{{currentBalanceText}}" class="payment-status-balance">当前余额 {{currentBalanceText}} 积分</view>
        </view>
        <button wx:if="{{paymentStatus === 'success'}}" class="records-link" bindtap="openRecords">看记录</button>
      </view>

      <view wx:if="{{!eligible}}" class="state-panel state-panel-disabled">
        <view class="state-icon">候</view>
        <view class="state-copy">
          <view class="state-title">充值暂未开放</view>
          <view class="state-description">{{unavailableMessage}}</view>
        </view>
      </view>

      <button
        wx:if="{{eligible}}"
        class="pay-hit"
        bindtap="submitPayment"
        loading="{{paying}}"
        disabled="{{paying || !hasWxpay || !selectedProductId || !packages.length}}"
        aria-label="{{paying ? '处理中' : !hasWxpay ? '支付通道准备中' : '确认支付' + selectedAmountText}}"
      >
        <view class="pay-button {{paying || !hasWxpay || !selectedProductId || !packages.length ? 'pay-button-disabled' : ''}}">
          {{paying ? '处理中...' : !hasWxpay ? '通道准备中' : '确认支付 ' + selectedAmountText}}
        </view>
      </button>

      <view class="payment-note">
        <view class="payment-note-icon" aria-hidden="true"></view>
        <text>支付完成后由服务端确认到账，不由前端直接加积分</text>
      </view>
    </block>
  </block>
</view>
