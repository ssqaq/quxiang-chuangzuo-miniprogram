{
  "apis": [
    {
      "id": "get_simulator_console",
      "name": "读取 console",
      "summary": "对小程序 console 缓冲区执行 grep 过滤并返回命中行。command 是 grep 命令字符串（不含文件名），如 'grep -i error'。要获取全部日志请用 'grep -n .'（匹配任意行）。返回空字符串代表没有匹配行，不代表 console 为空。",
      "group": "runtime",
      "source": {
        "type": "wechatide"
      },
      "scenes": [
        "debugger"
      ],
      "inputSchema": {
        "project": {
          "type": "string",
          "required": true,
          "description": "项目绝对路径"
        },
        "command": {
          "type": "string",
          "required": true,
          "description": "grep 命令字符串（不含文件名），例如: 'grep -n .'（全部）、'grep -i error'（过滤 error）、'grep -n warn'（过滤 warn）。不要传 'all' 等枚举值。"
        }
      },
      "execution": {
        "transport": "skill_call",
        "toolName": "get_simulator_console"
      }
    },
    {
      "id": "automation_evaluate",
      "name": "运行时执行",
      "summary": "在当前小程序或小游戏运行时执行一段 JS 函数字符串并返回结果。该工具会实际执行代码，不是只读查询",
      "group": "automation",
      "source": {
        "type": "wechatide"
      },
      "scenes": [
        "automator"
      ],
      "inputSchema": {
        "project": {
          "type": "string",
          "required": true,
          "description": "项目绝对路径"
        },
        "action": {
          "type": "string",
          "fixed": true,
          "description": "Always sent as \"evaluate\""
        },
        "fnSource": {
          "type": "string",
          "required": true,
          "description": "函数源代码字符串，例如 function() { return wx.getSystemInfoSync(); }"
        },
        "args": {
          "type": "array",
          "required": false,
          "description": "函数参数"
        }
      },
      "execution": {
        "transport": "skill_call",
        "toolName": "automation_evaluate"
      }
    },
    {
      "id": "automation_wx_api",
      "name": "小程序 API 调试",
      "summary": "调用、mock 或恢复 wx API。",
      "group": "automation",
      "source": {
        "type": "wechatide"
      },
      "scenes": [
        "debugger",
        "automator"
      ],
      "inputSchema": {
        "project": {
          "type": "string",
          "required": true
        },
        "action": {
          "type": "string",
          "required": true,
          "enum": [
            "call",
            "mock",
            "restore"
          ]
        },
        "method": {
          "type": "string",
          "required": true
        },
        "args": {
          "type": "array",
          "required": false
        },
        "result": {
          "type": "object",
          "required": false
        },
        "functionDeclaration": {
          "type": "string",
          "required": false
        }
      },
      "execution": {
        "transport": "skill_call",
        "toolName": "automation_wx_api"
      }
    }
  ]
}
