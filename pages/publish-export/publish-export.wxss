page {
  background: #f5f7fb;
}

.publish-export-page {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.publish-export-intro {
  background: linear-gradient(135deg, #eef5ff 0%, #ffffff 72%);
}

.source-upload-card {
  padding-bottom: 24rpx;
}

.source-upload-card .section-title {
  margin-bottom: 14rpx;
}

.source-upload-card .section-subtitle {
  margin-bottom: 0;
}

.upload-main-button {
  display: flex;
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  margin: 16rpx auto 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.device-photo-hint {
  margin-top: 10rpx;
  color: #8290a4;
  font-size: 21rpx;
  line-height: 1.5;
}

.scope-switch,
.choice-list {
  display: flex;
  gap: 12rpx;
}

.scope-button,
.choice-button {
  flex: 1;
  height: 68rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid #dfe6f1;
  border-radius: 14rpx;
  background: #f8faff;
  color: #66758a;
  font-size: 24rpx;
  line-height: 66rpx;
}

.scope-button {
  display: flex;
  height: 80rpx;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.scope-button-active,
.choice-button-active {
  border-color: #9fc3f8;
  background: #edf4ff;
  color: #1f6feb;
  font-weight: 700;
}

.scope-button-active {
  border-color: #1f6feb;
  background: #1f6feb !important;
  color: #ffffff !important;
  box-shadow: 0 8rpx 18rpx rgba(31, 111, 235, 0.2);
}

.selection-summary {
  margin-top: 20rpx;
  color: #1f6feb;
  font-size: 23rpx;
  font-weight: 600;
}

.selection-summary text {
  color: #8491a5;
  font-weight: 400;
}

.publish-record-list {
  margin-top: 12rpx;
}

.publish-record {
  position: relative;
  display: flex;
  min-height: 128rpx;
  margin-top: 12rpx;
  padding: 12rpx 48rpx 12rpx 12rpx;
  align-items: center;
  border: 1rpx solid #e5eaf2;
  border-radius: 16rpx;
  background: #ffffff;
}

.publish-record-selected {
  border-color: #afd0fb;
  background: #f8fbff;
}

.publish-record-image {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 14rpx;
  background: #edf1f6;
}

.publish-record-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a2adbc;
  font-size: 21rpx;
}

.publish-record-info {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.publish-record-title {
  overflow: hidden;
  color: #29354b;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.publish-record-time {
  margin-top: 8rpx;
  color: #8290a4;
  font-size: 21rpx;
}

.publish-record-state {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #1f6feb;
  font-size: 19rpx;
}

.publish-record:not(.publish-record-selected) .publish-record-state {
  background: #f1f3f6;
  color: #8b95a7;
}

.publish-record-check {
  position: absolute;
  top: 50%;
  right: 16rpx;
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  margin-top: -18rpx;
  border: 2rpx solid #d5deeb;
  border-radius: 50%;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.publish-record-selected .publish-record-check {
  border-color: #1f6feb;
  background: #1f6feb;
}

.publish-export-empty {
  margin-top: 18rpx;
}

.publish-export-empty button {
  margin-top: 22rpx;
}

.export-options-card {
  padding-bottom: 24rpx;
}

.scheme6-export-stack {
  margin-top: 4rpx;
}

.scheme6-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  border-radius: 26rpx;
}

.scheme6-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.scheme6-card-heading .section-title {
  margin-bottom: 8rpx;
}

.scheme6-card-caption {
  color: #8491a5;
  font-size: 21rpx;
  line-height: 1.5;
}

.scheme6-card-status {
  flex: none;
  padding-top: 8rpx;
  color: #1f6feb;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.scheme6-format-card .option-line {
  margin-top: 28rpx;
}

.scheme6-feature-card .enhancement-list {
  margin-top: 20rpx;
}

.scheme6-feature-card .enhancement-row {
  min-height: 104rpx;
}

.scheme6-feature-card .enhancement-title {
  font-size: 26rpx;
}

.scheme6-feature-card .enhancement-description {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.scheme6-strength-card .strength-row {
  padding: 20rpx 0 12rpx;
}

.scheme6-strength-card .strength-row:first-of-type {
  margin-top: 14rpx;
}

.scheme6-strength-card .option-label {
  font-size: 26rpx;
}

.scheme6-actions {
  margin: 0 0 24rpx;
  padding: 18rpx 20rpx 16rpx;
  border: 1rpx solid #dce5f0;
  border-radius: 24rpx;
  background: #ffffff;
}

.scheme6-actions .scheme6-export-button {
  width: 100% !important;
  height: 82rpx;
  min-height: 82rpx;
  margin: 0;
  max-width: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.scheme6-actions .scheme6-back-button {
  width: 100% !important;
  height: 82rpx;
  min-height: 82rpx;
  margin: 12rpx 0 0;
  max-width: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.option-line {
  display: flex;
  margin-top: 20rpx;
  align-items: center;
  gap: 18rpx;
}

.option-label {
  flex: none;
  width: 136rpx;
  color: #4b5567;
  font-size: 25rpx;
  font-weight: 600;
}

.option-line .choice-list {
  min-width: 0;
  flex: 1;
}

.choice-button {
  height: 58rpx;
  min-height: 58rpx;
  line-height: 56rpx;
}

.quality-line {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
}

.quality-head,
.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quality-head .option-label {
  width: auto;
}

.quality-value {
  color: #1f6feb;
  font-size: 23rpx;
  font-weight: 700;
}

slider {
  margin: 14rpx 0 0;
}

.enhancement-list {
  margin-top: 12rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid #edf0f5;
}

.enhancement-group {
  margin-top: 24rpx;
}

.enhancement-group-title {
  color: #25344d;
  font-size: 25rpx;
  font-weight: 700;
}

.strength-row {
  padding: 12rpx 0 6rpx;
  border-bottom: 1rpx solid #f0f2f6;
}

.strength-row:last-child {
  border-bottom: 0;
}

.strength-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.strength-head .option-label {
  width: auto;
}

.enhancement-row {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #f0f2f6;
}

.enhancement-row-copy {
  min-width: 0;
  flex: 1;
}

.enhancement-side-note {
  flex: none;
  max-width: 220rpx;
  margin-left: auto;
  color: #8290a4;
  font-size: 19rpx;
  line-height: 1.35;
  text-align: right;
}

.enhancement-row:last-child {
  border-bottom: 0;
}

.enhancement-title {
  color: #354157;
  font-size: 24rpx;
  font-weight: 600;
}

.enhancement-description {
  margin-top: 4rpx;
  color: #8b95a7;
  font-size: 20rpx;
}

.export-button {
  display: flex;
  width: 52% !important;
  height: 82rpx;
  min-height: 82rpx;
  margin-top: 22rpx;
  margin-left: auto;
  margin-right: auto;
  padding: 0;
  max-width: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 82rpx;
  text-align: center;
  white-space: nowrap;
}

.back-button {
  display: flex;
  width: 52% !important;
  height: 82rpx;
  min-height: 82rpx;
  margin-top: 14rpx;
  margin-left: auto;
  margin-right: auto;
  padding: 0;
  max-width: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 82rpx;
  text-align: center;
  white-space: nowrap;
}

.export-progress-card {
  padding-bottom: 24rpx;
}

.progress-head .section-title {
  margin-bottom: 0;
}

.progress-text {
  margin-top: 14rpx;
  color: #69778c;
  font-size: 22rpx;
  line-height: 1.5;
}

.publish-export-canvas {
  position: fixed;
  z-index: -1;
  top: -20000px;
  left: -20000px;
  opacity: 0;
  pointer-events: none;
}
