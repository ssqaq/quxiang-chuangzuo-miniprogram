          <view class="auto-face-failure-panel">
            <view
              class="usage-subsection-head auto-face-failure-subsection-head"
              data-auto-face-failure-section="daily"
              catchtap="toggleAutoFaceFailureSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{autoFaceFailureSections.daily ? '收起最近30天每日明细' : '展开最近30天每日明细'}}"
            >
              <view class="usage-subsection-title">最近30天每日明细</view>
              <view class="usage-subsection-toggle">
                <text>{{autoFaceFailureSections.daily ? '收起' : '展开'}}</text>
                <text class="usage-subsection-chevron {{autoFaceFailureSections.daily ? 'is-open' : ''}}">⌄</text>
              </view>
            </view>
            <view wx:if="{{autoFaceFailureSections.daily}}" class="auto-face-failure-panel-body">
              <view wx:if="{{autoFaceFailureStats.daily.length}}" class="auto-face-failure-daily-list">
                <view wx:for="{{autoFaceFailureStats.daily}}" wx:key="dateKey" class="auto-face-failure-daily-row">
                  <view class="auto-face-failure-daily-top">
                    <text>{{item.dateKey}}</text>
                    <text>合计 {{item.total}} 次</text>
                  </view>
                  <view class="auto-face-failure-daily-meta">
                    <text>用户 {{item.userCount}}</text>
                    <text>主要原因 {{item.topFailureTypeLabel}}</text>
                    <text>最近 {{item.lastSeenText}}</text>
                  </view>
                </view>
              </view>
              <view wx:else class="admin-empty usage-empty">最近 30 天没有每日失败记录。</view>

              <view class="auto-face-failure-subtitle">最近失败记录</view>
              <view wx:if="{{autoFaceFailureStats.recent.length}}" class="auto-face-failure-recent-list">
                <view wx:for="{{autoFaceFailureStats.recent}}" wx:key="createdAtText" class="auto-face-failure-recent-row">
                  <view class="auto-face-failure-recent-top">
                    <text>{{item.createdAtText}} · {{item.failureTypeLabel}}</text>
                    <button class="copy-error-button" data-index="{{index}}" catchtap="copyAutoFaceFailure">复制错误</button>
                  </view>
                  <view class="auto-face-failure-recent-meta">
                    <text>错误码 {{item.errorCode}}</text>
                    <text wx:if="{{item.status}}">HTTP {{item.status}}</text>
                    <text wx:if="{{item.durationMs}}">用时 {{item.durationMs}}ms</text>
                    <text wx:if="{{item.requestId}}">请求 {{item.requestId}}</text>
                  </view>
                  <view class="auto-face-failure-recent-probe">{{item.probeSummaryText}}</view>
                  <view class="auto-face-failure-recent-message">{{item.message}}</view>
                </view>
              </view>
              <view wx:else class="admin-empty usage-empty">还没有最近失败记录。</view>
            </view>
          </view>

          <view class="auto-face-failure-panel">
            <view
              class="usage-subsection-head auto-face-failure-subsection-head"
              data-auto-face-failure-section="users"
              catchtap="toggleAutoFaceFailureSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{autoFaceFailureSections.users ? '收起按用户统计' : '展开按用户统计'}}"
            >
              <view class="usage-subsection-title">按用户统计</view>
              <view class="usage-subsection-toggle">
                <text>{{autoFaceFailureSections.users ? '收起' : '展开'}}</text>
                <text class="usage-subsection-chevron {{autoFaceFailureSections.users ? 'is-open' : ''}}">⌄</text>
              </view>
            </view>
            <view wx:if="{{autoFaceFailureSections.users}}" class="auto-face-failure-panel-body">
              <view wx:if="{{autoFaceFailureStats.users.length}}" class="auto-face-failure-user-list">
                <view wx:for="{{autoFaceFailureStats.users}}" wx:key="userHash" class="auto-face-failure-user-row">
                  <view class="auto-face-failure-user-main">
                    <text class="auto-face-failure-user-name">{{item.userLabel}}</text>
                    <text class="auto-face-failure-user-meta">主要原因 {{item.topFailureTypeLabel}} · 最近 {{item.lastSeenText}}</text>
                  </view>
                  <text class="auto-face-failure-user-count">{{item.total}} 次</text>
                </view>
              </view>
              <view wx:else class="admin-empty usage-empty">还没有按用户统计数据。</view>
            </view>
          </view>

          <view class="auto-face-failure-panel">
            <view
              class="usage-subsection-head auto-face-failure-subsection-head"
              data-auto-face-failure-section="monthly"
              catchtap="toggleAutoFaceFailureSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{autoFaceFailureSections.monthly ? '收起按月统计' : '展开按月统计'}}"
            >
              <view class="usage-subsection-title">按月统计</view>
              <view class="usage-subsection-toggle">
                <text>{{autoFaceFailureSections.monthly ? '收起' : '展开'}}</text>
                <text class="usage-subsection-chevron {{autoFaceFailureSections.monthly ? 'is-open' : ''}}">⌄</text>
              </view>
            </view>
            <view wx:if="{{autoFaceFailureSections.monthly}}" class="auto-face-failure-panel-body">
              <view wx:if="{{autoFaceFailureStats.monthly.length}}" class="auto-face-failure-monthly-list">
                <view wx:for="{{autoFaceFailureStats.monthly}}" wx:key="monthKey" class="auto-face-failure-monthly-row">
                  <view class="auto-face-failure-monthly-top">
                    <text>{{item.monthKey}}</text>
                    <text>合计 {{item.total}} 次</text>
                  </view>
                  <view class="auto-face-failure-monthly-meta">
                    <text>用户 {{item.userCount}}</text>
                    <text>主要原因 {{item.topFailureTypeLabel}}</text>
                    <text>最近 {{item.lastSeenText}}</text>
                  </view>
                </view>
              </view>
              <view wx:else class="admin-empty usage-empty">还没有按月统计数据。</view>
            </view>
          </view>
        </view>
        </view>
      </view>

      <view id="monitor-section-diagnosticLogs" class="card admin-section diagnostic-admin-section monitor-fold-card {{monitorSections.diagnosticLogs ? 'is-open' : 'is-collapsed'}}">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">用户端日志</view>
            <view class="admin-section-help">仅管理员可见，保留最近72小时；超过72小时自动删除。最近更新 {{moduleStates.diagnosticLogs.updatedAtText}}</view>
          </view>
          <view class="admin-section-tools">
            <view class="config-state {{moduleStates.diagnosticLogs.status === 'failed' ? 'is-off' : 'is-ready'}}">
              {{moduleStates.diagnosticLogs.label}}
            </view>
            <button
              class="usage-refresh-button"
              catchtap="refreshDiagnosticLogs"
              loading="{{diagnosticLogsLoading}}"
              disabled="{{diagnosticLogsLoading}}"
            >{{diagnosticLogsLoading ? '读取中' : '刷新'}}</button>
            <view
              class="monitor-section-toggle-button"
              data-section="diagnosticLogs"
              catchtap="toggleMonitorSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{monitorSections.diagnosticLogs ? '收起用户端日志' : '展开用户端日志'}}"
            >
              <text>{{monitorSections.diagnosticLogs ? '收起' : '展开'}}</text>
              <text class="monitor-section-chevron {{monitorSections.diagnosticLogs ? 'is-open' : ''}}">⌄</text>
            </view>
          </view>
        </view>

        <view wx:if="{{monitorSections.diagnosticLogs}}" class="monitor-fold-body">
        <view wx:if="{{moduleStates.diagnosticLogs.status === 'loading'}}" class="usage-message">
          正在整理用户端日志...
        </view>
        <view wx:if="{{moduleStates.diagnosticLogs.status === 'failed'}}" class="usage-message is-warn">
          {{moduleStates.diagnosticLogs.message || '用户端日志读取失败，请点击刷新。'}}
        </view>
        <view wx:if="{{diagnosticLogs.message}}" class="usage-message {{diagnosticLogs.unavailable ? 'is-warn' : ''}}">
          {{diagnosticLogs.message}}
        </view>

        <view wx:if="{{moduleStates.diagnosticLogs.status === 'ready' || moduleStates.diagnosticLogs.hasData}}" class="diagnostic-admin-summary">
          <view class="diagnostic-admin-summary-item">
            <text>全部</text>
            <text>{{diagnosticLogs.summary.total}}</text>
          </view>
          <view class="diagnostic-admin-summary-item is-error">
            <text>错误</text>
            <text>{{diagnosticLogs.summary.errorCount}}</text>
          </view>
          <view class="diagnostic-admin-summary-item is-warn">
            <text>提醒</text>
            <text>{{diagnosticLogs.summary.warnCount}}</text>
          </view>
          <view class="diagnostic-admin-summary-item is-info">
            <text>正常</text>
            <text>{{diagnosticLogs.summary.infoCount}}</text>
          </view>
          <view class="diagnostic-admin-summary-item">
            <text>用户</text>
            <text>{{diagnosticLogs.summary.userCount}}</text>
          </view>
        </view>

        <view class="diagnostic-admin-filter-block">
          <view class="diagnostic-admin-filter-title">时间范围</view>
          <scroll-view class="diagnostic-admin-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="diagnostic-admin-filter-row">
              <view
                wx:for="{{diagnosticTimeRanges}}"
                wx:key="value"
                class="diagnostic-admin-filter-chip {{diagnosticHours === item.value ? 'is-active' : ''}}"
                data-hours="{{item.value}}"
                bindtap="selectDiagnosticHours"
              >{{item.label}}</view>
            </view>
          </scroll-view>
        </view>

        <view class="diagnostic-admin-filter-block">
          <view class="diagnostic-admin-filter-title">严重程度</view>
          <view class="diagnostic-admin-filter-row">
            <view
              wx:for="{{diagnosticLevels}}"
              wx:key="value"
              class="diagnostic-admin-filter-chip {{diagnosticLevel === item.value ? 'is-active' : ''}}"
              data-level="{{item.value}}"
              bindtap="selectDiagnosticLevel"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="diagnostic-admin-filter-block">
          <view class="diagnostic-admin-filter-title">业务类型</view>
          <scroll-view class="diagnostic-admin-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="diagnostic-admin-filter-row">
              <view
                wx:for="{{diagnosticCategories}}"
                wx:key="value"
                class="diagnostic-admin-filter-chip {{diagnosticCategory === item.value ? 'is-active' : ''}}"
                data-category="{{item.value}}"
                bindtap="selectDiagnosticCategory"
              >{{item.label}}</view>
            </view>
          </scroll-view>
        </view>

        <picker
          mode="selector"
          range="{{diagnosticLogs.userOptions}}"
          range-key="label"
          value="{{diagnosticUserIndex}}"
          bindchange="selectDiagnosticUser"
        >
          <view class="diagnostic-admin-user-picker">
            <text>用户筛选</text>
            <text>{{diagnosticUserLabel}} ›</text>
          </view>
        </picker>

        <view wx:if="{{diagnosticLogs.summary.categories.length}}" class="diagnostic-admin-category-summary">
          <view
            wx:for="{{diagnosticLogs.summary.categories}}"
            wx:key="category"
            class="diagnostic-admin-category-item"
          >
            <text>{{item.label}}</text>
            <text>{{item.count}} 条</text>
          </view>
        </view>

        <view wx:if="{{diagnosticLogs.logs.length}}" class="diagnostic-admin-list">
          <view
            wx:for="{{diagnosticLogs.logs}}"
            wx:key="eventId"
            class="diagnostic-admin-log level-{{item.level}}"
          >
            <view class="diagnostic-admin-log-top">
              <view class="diagnostic-admin-log-tags">
                <text class="diagnostic-admin-level">{{item.levelText}}</text>
                <text class="diagnostic-admin-category">{{item.categoryLabel}}</text>
              </view>
              <text class="diagnostic-admin-time">{{item.createdAtText}}</text>
            </view>
            <view class="diagnostic-admin-message">{{item.message}}</view>
            <view class="diagnostic-admin-meta">
              <text>用户 {{item.userHash}}</text>
              <text wx:if="{{item.route}}">页面 {{item.route}}</text>
              <text wx:if="{{item.durationMs !== null}}">耗时 {{item.durationText}}</text>
              <text wx:if="{{item.code}}">代码 {{item.code}}</text>
              <text wx:if="{{item.requestId}}">请求 {{item.requestId}}</text>
            </view>
            <view class="diagnostic-admin-log-actions">
              <button
                class="copy-error-button"
                data-index="{{index}}"
                catchtap="copyDiagnosticLog"
              >复制日志</button>
              <button
                wx:if="{{item.hasDetails}}"
                class="copy-error-button diagnostic-detail-button"
                data-index="{{index}}"
                catchtap="toggleDiagnosticLogDetail"
              >{{item.expanded ? '收起详情' : '查看详情'}}</button>
            </view>
            <view wx:if="{{item.expanded}}" class="diagnostic-admin-detail">
              <view wx:if="{{item.errorText}}">
                <text>错误详情</text>
                <text selectable>{{item.errorText}}</text>
              </view>
              <view wx:if="{{item.detailsText}}">
                <text>补充信息</text>
                <text selectable>{{item.detailsText}}</text>
              </view>
            </view>
          </view>
        </view>
        <view
          wx:elif="{{moduleStates.diagnosticLogs.status === 'ready' || moduleStates.diagnosticLogs.hasData}}"
          class="admin-empty usage-empty"
        >这个筛选条件下没有日志。</view>
        <button
          wx:if="{{diagnosticLogs.nextOffset !== null}}"
          class="user-load-more"
          bindtap="loadMoreDiagnosticLogs"
          loading="{{diagnosticLogsLoading}}"
          disabled="{{diagnosticLogsLoading}}"
        >{{diagnosticLogsLoading ? '加载中...' : '继续加载20条'}}</button>
        </view>
      </view>


    </view>
  </view>
</view>
