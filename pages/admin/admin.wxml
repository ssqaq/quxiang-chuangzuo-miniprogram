      bindtap="toggleMonitor"
      hover-class="control-tap"
      role="button"
      aria-label="{{monitorExpanded ? '收起运行监控' : '展开运行监控'}}"
    >
      <view>
        <view class="monitor-toggle-title">更多监控与历史</view>
        <view class="monitor-toggle-subtitle">探针、接口耗时、失败统计、用量和部署日志</view>
      </view>
      <text class="monitor-toggle-arrow">{{monitorExpanded ? '⌃' : '›'}}</text>
    </view>

    <view wx:if="{{monitorExpanded}}" class="monitor-content">
      <view wx:if="{{deployment}}" class="card admin-section deployment-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">当前线上部署</view>
            <view class="admin-section-help">当前云函数版本和动态配置状态。</view>
          </view>
          <text class="{{deployment.face.ready && deployment.image.ready && deployment.video.ready ? 'log-ok' : 'log-warn'}}">
            {{deployment.face.ready && deployment.image.ready && deployment.video.ready ? '运行正常' : '需要处理'}}
          </text>
        </view>
        <view class="deployment-grid">
          <view><text>云函数版本</text><text>{{deployment.buildVersion}}</text></view>
          <view><text>构建标记</text><text>{{deployment.buildMarker}}</text></view>
          <view><text>人脸状态</text><text>{{deployment.face.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>生图状态</text><text>{{deployment.image.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>视频状态</text><text>{{deployment.video.ready ? '可用' : '未就绪'}}</text></view>
          <view><text>动态配置版本</text><text>{{deployment.runtimeConfigVersion}}</text></view>
          <view><text>检查时间</text><text>{{deployment.checkedAt}}</text></view>
        </view>
      </view>

      <view wx:if="{{autoFaceProbe.available || autoFaceProbe.status === 'failed'}}" class="card admin-section auto-face-probe-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">自动贴脸探针</view>
            <view class="admin-section-help">显示线上版本、接口耗时和视觉配置状态。</view>
          </view>
          <text class="{{autoFaceProbe.status === 'ok' ? 'log-ok' : 'log-warn'}}">{{autoFaceProbe.statusText}}</text>
        </view>
        <view class="deployment-grid">
          <view><text>云函数版本</text><text>{{autoFaceProbe.buildVersion || '未知'}}</text></view>
          <view><text>构建标记</text><text>{{autoFaceProbe.buildMarker || '未知'}}</text></view>
          <view><text>视觉配置</text><text>{{autoFaceProbe.visionConfigured ? '已就绪' : '未就绪'}}</text></view>
          <view><text>Provider / Model</text><text>{{autoFaceProbe.provider || '未知'}} / {{autoFaceProbe.model || '未知'}}</text></view>
          <view><text>Node.js</text><text>{{autoFaceProbe.nodeVersion || '未知'}}</text></view>
          <view><text>接口耗时</text><text>{{autoFaceProbe.durationText}}</text></view>
          <view><text>云函数处理耗时</text><text>{{autoFaceProbe.serverDurationText}}</text></view>
          <view><text>检查时间</text><text>{{autoFaceProbe.checkedAtText}}</text></view>
        </view>
        <view wx:if="{{autoFaceProbe.message}}" class="usage-message is-warn">{{autoFaceProbe.message}}</view>
      </view>

      <view class="card admin-section auto-face-probe-history-card">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">探针历史</view>
            <view class="admin-section-help">最近 {{autoFaceProbeHistory.retentionDays}} 天，最多显示 20 条。</view>
          </view>
          <button class="usage-refresh-button" bindtap="refreshAutoFaceProbeHistory">刷新</button>
        </view>
        <view wx:if="{{moduleStates.probeHistory.status === 'loading'}}" class="usage-message">
          正在读取探针历史...
        </view>
        <view wx:if="{{autoFaceProbeHistory.message}}" class="usage-message {{autoFaceProbeHistory.unavailable ? 'is-warn' : ''}}">
          {{autoFaceProbeHistory.message}}
        </view>
        <view wx:if="{{moduleStates.probeHistory.status !== 'loading' && !autoFaceProbeHistory.history.length && !autoFaceProbeHistory.message}}" class="admin-empty">
          还没有探针历史，点击“立即检查线上部署”生成第一条。
        </view>
        <view wx:for="{{autoFaceProbeHistory.history}}" wx:key="checkedAt" class="auto-face-probe-history-row">
          <view class="auto-face-probe-history-top">
            <view>
              <text class="{{item.status === 'ok' ? 'log-ok' : 'log-warn'}}">{{item.statusText}}</text>
              <text class="auto-face-probe-history-time">{{item.checkedAtText}}</text>
            </view>
            <text class="auto-face-probe-history-duration">{{item.durationText}}</text>
          </view>
          <view class="auto-face-probe-history-meta">
            {{item.buildVersion}} · {{item.visionConfigured ? '视觉配置已就绪' : '视觉配置未就绪'}} · {{item.provider}} / {{item.model}}
          </view>
          <view class="auto-face-probe-history-meta">{{item.buildMarker}}</view>
          <view wx:if="{{item.status === 'failed' && item.errorCode}}" class="auto-face-probe-history-error">
            错误码：{{item.errorCode}}
          </view>
        </view>
      </view>

      <view class="card admin-section usage-section">
        <view class="admin-section-head">
          <view>
            <view class="admin-section-title">模型用量统计</view>
            <view class="admin-section-help">按北京时间统计调用次数、Token、视频秒数和预计成本。</view>
          </view>
          <view class="usage-toolbar">
            <button class="usage-refresh-button" bindtap="refreshModelUsage" loading="{{usageLoading}}" disabled="{{usageLoading}}">
              {{usageLoading ? '刷新中' : '刷新统计'}}
            </button>
            <button class="usage-export-button" bindtap="exportModelUsage" loading="{{usageExporting}}" disabled="{{usageExporting}}">
              {{usageExporting ? '生成中' : '导出 Excel'}}
            </button>
          </view>
        </view>

        <view wx:if="{{moduleStates.usage.status === 'loading'}}" class="usage-message">
          正在读取模型用量和成本...
        </view>
