# 星聚生产配置只能由云函数环境变量注入。这个文件不放真实密钥、商户号或回调地址。
XINGJU_API_BASE_URL=
XINGJU_PID=
XINGJU_PLATFORM_PUBLIC_KEY=
XINGJU_MERCHANT_PRIVATE_KEY=
XINGJU_NOTIFY_URL=
XINGJU_RETURN_URL=

# 默认 RSA。MD5 仅允许测试环境标记 + 单一测试商户白名单（pid）时生效。
XINGJU_SIGNATURE_MODE=rsa
XINGJU_MD5_KEY=
XINGJU_MD5_ALLOWLIST=

# 首版仅允许微信通道，且充值与通道开关默认均为 false。
PAYMENT_ORDER_CREATION_ENABLED=false
PAYMENT_CALLBACK_PROCESSING_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=false
