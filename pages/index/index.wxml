<view class="page">
  <canvas
    canvas-id="maskExportCanvas"
    class="mask-export-canvas"
    width="{{imageWidth}}"
    height="{{imageHeight}}"
    style="width: {{imageWidth}}px; height: {{imageHeight}}px;"
  ></canvas>

  <view class="hero card">
    <view class="hero-heading">
      <view class="hero-title">圈像创作</view>
      <view class="status {{cloudReady ? 'status-ok' : 'status-offline'}}">
        <view class="status-dot"></view>
        <text>{{cloudReady ? '云端已连接' : '本地预览'}}</text>
      </view>
    </view>
    <view class="hero-subtitle">区域锁定 · 人像参考 · AI 提示词</view>
  </view>

  <view wx:if="{{entryTitle}}" class="entry-hint entry-hint-{{entryTone}}">
    <view class="entry-hint-mark">{{entryTone === 'face' ? '脸' : (entryTone === 'wardrobe' ? '衣' : (entryTone === 'pose' ? '姿' : '◎'))}}</view>
    <view class="entry-hint-copy">
      <view class="entry-hint-title">本次入口：{{entryTitle}}</view>
      <view class="entry-hint-text">{{entryHint}}</view>
    </view>
  </view>

  <view class="stepper card">
    <view
      wx:for="{{steps}}"
      wx:key="index"
      class="step-item {{index === step ? 'active' : ''}} {{index < step ? 'done' : ''}}"
    >
      <view class="step-number">{{index + 1}}</view>
      <text>{{item}}</text>
    </view>
  </view>

  <view wx:if="{{step === 0 || step === 1}}" class="card">
    <view class="section-title">
      <text>{{step === 0 ? '1. 上传主图' : '2. 在主图上圈选区域'}}</text>
      <text class="badge" wx:if="{{project.mainImage}}">{{project.mainImage.width}} × {{project.mainImage.height}}</text>
    </view>
    <view class="section-subtitle">
      {{step === 0 ? '主图负责原始构图和背景。支持相册或相机。' : '用手指从任意位置向任意方向拖动画圈，圈出需要编辑的人脸区域。'}}
    </view>
    <view class="main-image-actions">
      <button class="primary-btn main-image-action-button main-image-select" bindtap="chooseMainImage">{{project.mainImage ? '重新选择主图' : '选择主图'}}</button>
      <button
        wx:if="{{project.mainImage}}"
        class="primary-btn main-image-action-button main-image-clear"
        bindtap="clearMainImage"
      >清除主图</button>
    </view>
    <view wx:if="{{project.mainImage}}" class="mask-action-row">
      <button
        class="primary-btn main-image-action-button mask-action-button"
        bindtap="autoFaceCircle"
        loading="{{analysisAction === 'faceCircle'}}"
        disabled="{{analysisAction === 'faceCircle'}}"
      >{{analysisAction === 'faceCircle' ? '识别中...' : '自动识别人脸'}}</button>
      <button
        class="primary-btn main-image-action-button mask-action-button"
        bindtap="clearCircle"
      >清除红圈</button>
    </view>
    <view wx:if="{{project.mainImage && canvasWidth}}" class="canvas-wrap">
      <view
        class="canvas-viewport"
        style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        catchtouchstart="onCanvasTouchStart"
        catchtouchmove="onCanvasTouchMove"
        catchtouchend="onCanvasTouchEnd"
        catchtouchcancel="onCanvasTouchCancel"
      >
        <view
          class="canvas-stage"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px; transform: translate({{canvasOffsetX}}px, {{canvasOffsetY}}px) scale({{canvasScale}});"
        >
          <image
            class="canvas-image"
            src="{{project.mainImage.path}}"
            mode="scaleToFill"
            style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
          ></image>
          <canvas
            canvas-id="maskCanvas"
            class="mask-canvas"
            width="{{canvasWidth}}"
            height="{{canvasHeight}}"
            style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
            disable-scroll="{{true}}"
          ></canvas>
        </view>
      </view>
      <view class="canvas-tip">
        {{canvasZoomed ? '双指拖动平移，单指从任意位置拖到任意方向绘制红圈' : (project.maskCircle ? '红圈已标记，可从任意位置重新拖动覆盖；双指可缩放' : canvasGestureTip)}}
      </view>
    </view>
    <view wx:if="{{project.mainImage && autoFaceStatus.state !== 'idle'}}" class="auto-face-diagnostics">
      <view class="auto-face-diagnostics-head">
        <view class="auto-face-diagnostics-leading">
          <view class="auto-face-diagnostics-title">自动识别人脸</view>
        </view>
        <view class="auto-face-diagnostics-status">
          <view wx:if="{{autoFaceStatus.durationText}}" class="auto-face-diagnostics-duration">{{autoFaceStatus.durationText}}</view>
          <view class="auto-face-diagnostics-state state-{{autoFaceStatus.state}}">
            {{autoFaceStatus.stateLabel}}
          </view>
        </view>
      </view>
      <view wx:if="{{autoFaceStatus.failureReason}}" class="auto-face-diagnostics-failure">
        原因：{{autoFaceStatus.failureReason}}
      </view>
      <view wx:if="{{autoFaceStatus.nextStepText}}" class="auto-face-diagnostics-next">
        下一步：{{autoFaceStatus.nextStepText}}
      </view>
    </view>
  </view>

  <view wx:if="{{step === 2}}" class="card">
    <view class="section-title">
      <text>3. 添加参考素材</text>
      <text class="badge">{{project.faceRefs.length}} / 6 人脸 · {{project.wardrobeRefs.length}} / 12 穿搭</text>
    </view>
    <view class="section-subtitle">第一张人脸参考默认作为主身份基准，穿搭参考可逐张指定目标。</view>

    <view class="subsection">
      <view class="subsection-title">人脸参考</view>
      <button class="secondary-btn" bindtap="chooseFaceImages">上传人脸参考</button>
      <view wx:if="{{!project.faceRefs.length}}" class="empty">还没有人脸参考图</view>
      <view wx:for="{{project.faceRefs}}" wx:key="id" class="asset-card">
        <view class="asset-card-main">
          <image class="asset-thumb" src="{{item.path}}" mode="aspectFill"></image>
          <view class="asset-body">
            <view class="asset-actions face-actions">
              <button class="small-btn reference-action-btn {{item.isPrimary ? 'primary-btn' : 'plain-btn'}}" data-index="{{index}}" bindtap="setPrimaryFace">
                {{item.isPrimary ? '主参考' : '设为主参考'}}
              </button>
              <button class="small-btn reference-action-btn danger-btn" data-index="{{index}}" bindtap="removeFace">删除</button>
            </view>
          </view>
        </view>
        <textarea class="asset-note" data-index="{{index}}" value="{{item.note}}" maxlength="-1" placeholder="备注：正脸、妆容、肤色等" bindinput="onFaceNoteInput"></textarea>
      </view>
    </view>

    <view class="subsection">
      <view class="subsection-title">衣物 / 配饰参考</view>
      <button class="secondary-btn" bindtap="chooseWardrobeImages">上传穿搭参考</button>
      <view wx:if="{{!project.wardrobeRefs.length}}" class="empty">没有穿搭参考也可以继续</view>
      <view wx:for="{{project.wardrobeRefs}}" wx:key="id" class="asset-card">
        <view class="asset-card-main">
          <image class="asset-thumb" src="{{item.path}}" mode="aspectFill"></image>
          <view class="asset-body">
            <picker
              class="picker-line"
              mode="selector"
              range="{{item.targetOptions}}"
              value="0"
              data-index="{{index}}"
              bindchange="onWardrobeTargetInput"
            >
              <view class="picker-box">目标：{{item.target || '整套穿搭'}}</view>
            </picker>
            <view class="kind-switch">
              <button class="small-btn reference-action-btn {{item.kind === 'clothing' ? 'primary-btn' : 'plain-btn'}}" data-index="{{index}}" data-value="0" bindtap="onWardrobeKindChange">衣物</button>
              <button class="small-btn reference-action-btn {{item.kind === 'accessory' ? 'primary-btn' : 'plain-btn'}}" data-index="{{index}}" data-value="1" bindtap="onWardrobeKindChange">配饰</button>
              <button class="small-btn reference-action-btn danger-btn" data-index="{{index}}" bindtap="removeWardrobe">删除</button>
            </view>
          </view>
        </view>
        <textarea class="asset-note" data-index="{{index}}" value="{{item.note}}" maxlength="-1" placeholder="备注：颜色、材质、保留细节" bindinput="onWardrobeNoteInput"></textarea>
      </view>
    </view>
  </view>

  <view wx:if="{{step === 3}}" class="card">
    <view class="section-title">
      <text>4. 原图理解与提示词</text>
    </view>
    <view class="analysis-actions">
      <button
        class="secondary-btn analysis-action-button"
        bindtap="analyzeMainImage"
        loading="{{analysisAction === 'main'}}"
        disabled="{{analysisAction === 'main'}}"
      >{{analysisAction === 'main' ? '分析中...' : 'AI 分析主图'}}</button>
      <button
        class="secondary-btn analysis-action-button"
        bindtap="analyzeWebPoses"
        loading="{{analysisAction === 'webPose'}}"
        disabled="{{analysisAction === 'webPose'}}"
      >{{analysisAction === 'webPose' ? '分析中...' : '参考网感分析'}}</button>
    </view>
    <view class="section-subtitle">
      <view>可以先手动填写;</view>
      <view>AI分析主图会填充四段描述，</view>
      <view>参考网感分析 会给出更上镜的姿势建议。</view>
    </view>
    <view wx:if="{{project.webPoseSuggestions.length}}" class="web-pose-panel">
      <view class="web-pose-head">
        <text>网感姿势建议</text>
        <text>请选择 1 条</text>
      </view>
      <view
        wx:for="{{project.webPoseSuggestions}}"
        wx:key="id"
        class="web-pose-option {{project.selectedWebPose && project.selectedWebPose.id === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectWebPose"
      >
        <view class="web-pose-index">{{item.id}}</view>
        <view class="web-pose-body">
          <view class="web-pose-title-row">
            <text class="web-pose-title">{{item.title}}</text>
            <text
              wx:if="{{project.selectedWebPose && project.selectedWebPose.id === item.id}}"
              class="web-pose-selected"
            >已选</text>
          </view>
          <view class="web-pose-description">{{item.description}}</view>
          <view class="web-pose-tags">
            <text>{{item.category}}</text>
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view wx:if="{{item.unsuitableReason}}" class="web-pose-warning">
            注意：{{item.unsuitableReason}}
          </view>
        </view>
      </view>
      <view wx:if="{{project.webPoseAnalysisMeta.model}}" class="web-pose-meta">
        分析模型：{{project.webPoseAnalysisMeta.model}} · 选中后只在提交生图时追加，不覆盖当前提示词
      </view>
    </view>
    <view class="field-label">场景</view>
    <textarea class="textarea compact-area" data-field="sceneDescription" value="{{project.sceneDescription}}" placeholder="请描述原图的场景地点、背景环境、时间氛围、拍摄设备感、图片画质、是否手机拍摄、是否普通生活照，以及哪些场景内容必须保持原样。" bindinput="onDescriptionInput"></textarea>
    <view class="field-label">姿态</view>
    <textarea class="textarea compact-area" data-field="poseDescription" value="{{project.poseDescription}}" placeholder="请描述原图中人物的身体姿势、手部动作、头部角度、肩颈姿态、与镜头距离、身体朝向，并说明原动作和红圈外身体部分需要完全不变。" bindinput="onDescriptionInput"></textarea>
    <view class="field-label">面部朝向</view>
    <textarea class="textarea compact-area" data-field="faceDirectionDescription" value="{{project.faceDirectionDescription}}" placeholder="请描述原图中红圈内原先的面部朝向、头部角度、眼神方向、视线落点、表情情绪、嘴唇状态和眉眼状态；替换后仍要匹配这些原图条件。" bindinput="onDescriptionInput"></textarea>
    <view class="field-label">光影、妆容与画质</view>
    <textarea class="textarea compact-area" data-field="lightingMakeupDescription" value="{{project.lightingMakeupDescription}}" placeholder="请具体描述原图红圈内面部光影：光线颜色/色温，来自画面哪一侧，落在额头、鼻梁、脸颊、下巴等位置；阴影在眼窝、鼻翼、下颌或颈部哪里，高光和肤色反射如何；同时写妆容浓淡、皮肤纹理、清晰度、噪点、压缩痕迹和普通手机拍摄画质。" bindinput="onDescriptionInput"></textarea>
    <view class="lock-panel">
      <view class="lock-panel-head">
        <view class="lock-panel-copy" bindtap="toggleLockPanel">
          <view class="lock-panel-title">选择不需要修改的内容</view>
          <view class="lock-panel-help">勾选的内容会保持原图，不参与修改。</view>
        </view>
        <view class="lock-panel-toolbar">
          <text class="lock-selection-count">已选 {{lockedSelectionCount}} 项</text>
          <view class="lock-panel-controls">
            <button class="lock-panel-control" catchtap="selectAllLockedElements">全选</button>
            <button class="lock-panel-control" catchtap="toggleLockPanel">{{lockPanelOpen ? '收起' : '展开'}}</button>
          </view>
        </view>
      </view>
      <view wx:if="{{lockPanelOpen}}" class="lock-panel-body">
        <checkbox-group class="lock-grid" bindchange="onLockedElementsChange">
          <label
            wx:for="{{lockedElementOptions}}"
            wx:key="value"
            class="lock-chip {{item.checked ? 'selected' : ''}}"
          >
            <checkbox
              class="lock-checkbox"
              value="{{item.value}}"
              checked="{{item.checked}}"
              color="#1f6feb"
            ></checkbox>
            <text>{{item.label}}</text>
          </label>
        </checkbox-group>
        <textarea
          class="textarea custom-lock-area"
          value="{{customLockText}}"
          maxlength="500"
          placeholder="添加其他要保留的内容，例如：手机壳、耳环、衣领。每行填写一项。"
          bindinput="onCustomLockInput"
        ></textarea>
      </view>
    </view>
  </view>

  <view wx:if="{{step === 4}}" class="card generation-card">
    <view class="section-title generation-title">
      <text>5. 生成并归档</text>
      <text class="badge">{{cloudReady ? '可提交云端' : '仅本地预览'}}</text>
    </view>
    <view class="generation-actions">
      <button class="primary-btn generate-button" bindtap="startGenerate" loading="{{loading}}" disabled="{{loading}}">
        {{loading ? loadingText : '提交生图并归档'}}
      </button>
      <button class="secondary-btn generation-records-button" bindtap="jumpToRecords">查看制作记录</button>
    </view>
    <view wx:if="{{loading}}" class="generation-waiting generation-waiting-{{generationStage}}">
      <view class="generation-waiting-copy">
        <view class="generation-checklist">
          <view
            wx:for="{{generationPhases}}"
            wx:key="key"
            wx:for-index="phaseIndex"
            class="generation-check-row {{phaseIndex < generationPhaseIndex ? 'is-done' : ''}} {{phaseIndex === generationPhaseIndex ? 'is-current' : ''}}"
          >
            <view class="generation-check-icon">
              <text wx:if="{{phaseIndex < generationPhaseIndex}}">✓</text>
              <text wx:elif="{{phaseIndex === generationPhaseIndex}}">•</text>
              <text wx:else>{{phaseIndex + 1}}</text>
            </view>
            <view class="generation-check-copy">
              <view class="generation-check-title">{{item.label}}</view>
              <view class="generation-check-detail">
                {{phaseIndex < generationPhaseIndex
                  ? '已完成'
                  : (phaseIndex === generationPhaseIndex
                    ? (generationStage === 'retry' ? '网络较慢，自动重试中' : loadingText)
                    : '等待上一项完成')}}
              </view>
            </view>
            <view class="generation-check-state">
              {{phaseIndex < generationPhaseIndex
                ? '完成'
                : (phaseIndex === generationPhaseIndex
                  ? (generationStage === 'timeout' ? '处理中' : (generationStage === 'retry' ? '重试中' : '进行中'))
                  : '等待')}}
            </view>
          </view>
        </view>
        <view class="generation-waiting-note">
          <view class="generation-waiting-title">
            {{generationStage === 'timeout' ? '任务仍在处理中' : (generationStage === 'retry' ? '网络有点慢' : '请稍等，系统会自动继续')}}
          </view>
          <view class="generation-waiting-text">{{generationWaitText}}</view>
          <view class="generation-waiting-footer">
            <view class="generation-waiting-elapsed">已等待 {{generationElapsedSeconds}} 秒 · 请不要重复点击</view>
            <view wx:if="{{generationRetryCount}}" class="generation-waiting-retry-count">
              已自动重试 {{generationRetryCount}} 次
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{generatedResults.length}}" class="result-grid">
      <view wx:for="{{generatedResults}}" wx:key="id" class="result-card" data-url="{{item.tempFileURL || item.path}}" bindtap="previewImage">
        <image src="{{item.tempFileURL || item.path}}" mode="aspectFill"></image>
        <text>{{item.createdAt}}</text>
        <button
          wx:if="{{item.canRepair}}"
          class="small-btn repair-result-button"
          data-id="{{item.id}}"
          catchtap="openRepair"
          disabled="{{loading}}"
        >局部修正</button>
      </view>
    </view>
  </view>

  <view class="nav-actions">
    <button wx:if="{{step === 0}}" class="primary-btn nav-action-button" bindtap="backToWorkbench">返回主页</button>
    <button wx:if="{{step > 0}}" class="primary-btn nav-action-button {{step === 4 ? 'final-prev-button' : ''}}" bindtap="prevStep">上一步</button>
    <button wx:if="{{step < steps.length - 1 && !(step === 2 && project.faceRefs.length) && step !== 3}}" class="primary-btn nav-action-button" bindtap="nextStep">下一步</button>
    <button wx:if="{{step === 2 && project.faceRefs.length}}" class="primary-btn nav-action-button" bindtap="nextStep">去填写提示词</button>
    <button wx:if="{{step === 3}}" class="primary-btn nav-action-button" bindtap="nextStep">去生成</button>
  </view>

  <view class="footer-note">版本 {{appVersion}} · {{statusText}}</view>
</view>
