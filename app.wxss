page {
  background: #f5f7fb;
  color: #1d2433;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

button.button-hover {
  opacity: 0.86;
  transform: scale(0.97);
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e7ebf2;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 49, 79, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: #182132;
  font-size: 34rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-bottom: 18rpx;
  color: #697386;
  font-size: 24rpx;
  line-height: 1.6;
}

.muted {
  color: #8b95a7;
}

.primary-btn {
  background: #1f6feb !important;
  color: #ffffff !important;
}

.secondary-btn {
  background: #edf4ff !important;
  color: #1f6feb !important;
}

.plain-btn {
  background: #f4f6fa !important;
  color: #4b5567 !important;
}

.danger-btn {
  background: #fff0f0 !important;
  color: #d33d3d !important;
}

.small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 64rpx;
}

.field-label {
  display: block;
  margin: 22rpx 0 10rpx;
  color: #4b5567;
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.textarea {
  width: 100%;
  padding: 20rpx;
  background: #f8faff;
  border: 1rpx solid #e3e9f3;
  border-radius: 16rpx;
  color: #1d2433;
  font-size: 27rpx;
}

.input {
  height: 84rpx;
  min-height: 84rpx;
  padding: 0 20rpx;
  line-height: 84rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.65;
}

.empty {
  padding: 46rpx 20rpx;
  color: #8b95a7;
  text-align: center;
  line-height: 1.7;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #1f6feb;
  font-size: 22rpx;
}

.visual-demo-control {
  position: fixed;
  right: 12px;
  bottom: calc(12px + env(safe-area-inset-bottom));
  z-index: 99;
  display: flex;
  height: 44px;
  padding: 0 10px 0 12px;
  align-items: center;
  gap: 8px;
  border: 1px solid #cfe0f7;
  border-radius: 8px;
  color: #35577f;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 6px 18px rgba(31, 49, 79, .12);
  font-size: 11px;
}

.visual-demo-control switch {
  transform: scale(.72);
  transform-origin: center;
}
