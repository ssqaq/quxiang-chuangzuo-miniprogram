<view class="workbench-page">
  <view class="workbench-hero card">
    <view class="workbench-brand-row">
      <image
        class="workbench-brand-icon"
        src="/assets/brand/brand-icon.png"
        mode="aspectFit"
      ></image>
      <view class="workbench-brand-copy">
        <view class="workbench-title">圈像创作</view>
        <view class="workbench-subtitle">圈定想改的，创作想要的。</view>
      </view>
      <view class="status {{cloudReady ? 'status-ok' : 'status-offline'}}">
        <view class="status-dot"></view>
        <text>{{cloudReady ? '云端已连接' : '本地预览'}}</text>
      </view>
    </view>

    <view class="hero-orbit hero-orbit-red"></view>
    <view class="hero-orbit hero-orbit-blue"></view>
    <view class="workbench-welcome">
      <view class="welcome-title">今天，想创作什么？</view>
      <view class="welcome-subtitle">先选入口，后面按需补素材。</view>
    </view>
  </view>

  <view
    class="card points-entry-card home-feature-card workbench-link-card"
    bindtap="openPoints"
    hover-class="workbench-link-card-hover"
    hover-start-time="0"
    hover-stay-time="70"
  >
    <view class="points-entry-copy">
      <view class="points-entry-topline">
        <view class="points-entry-title">{{pointsCopy.cardTitle}}</view>
        <view class="points-entry-balance">{{points.pointsBalance}} {{pointsCopy.pointsUnit}}</view>
      </view>
      <view class="points-entry-subtitle">
        {{pointsCopy.streakPrefix}} {{points.streakDays}} {{pointsCopy.streakSuffix}}
      </view>
      <view class="points-entry-track">
        <view
          class="points-entry-fill"
          style="width: {{points.progressPercent}}%;"
        ></view>
      </view>
      <view class="points-entry-foot">
        <text>{{pointsCopy.streakStatusPrefix}} {{points.currentStreak}} {{pointsCopy.dayUnit}} · {{points.checkedInToday ? pointsCopy.checkedIn : pointsCopy.notCheckedIn}}</text>
        <text class="points-entry-promo {{points.promoActive ? 'points-entry-promo-active' : ''}}">{{points.promoActive ? pointsCopy.promoActive : pointsCopy.freePrefix + ' ' + points.freeRemaining + ' ' + pointsCopy.freeSuffix}}</text>
      </view>
    </view>
    <button
      class="points-checkin-button"
      catchtap="checkIn"
      loading="{{checkingIn}}"
      disabled="{{checkingIn || points.checkedInToday}}"
    >
      {{points.checkedInToday ? pointsCopy.checkedInButton : pointsCopy.checkIn}}
    </button>
    <view class="home-feature-arrow points-entry-arrow">›</view>
  </view>

  <view class="workbench-feature-stack">
  <view class="common-feature-panel">
    <view class="feature-group-heading common-feature-heading">
      <view class="feature-group-title">
        <view class="feature-group-dot"></view>
        <text>常用功能</text>
      </view>
      <view class="feature-group-subtitle">先创作，再处理成片</view>
    </view>

    <view class="common-feature-list">
      <view
        wx:for="{{entryModes}}"
        wx:key="mode"
        class="entry-card entry-card-{{item.tone}} common-feature-row home-feature-card workbench-link-card"
        data-mode="{{item.mode}}"
        bindtap="startNew"
        hover-class="entry-card-hover"
        hover-start-time="0"
        hover-stay-time="70"
      >
        <view class="entry-mark">{{item.mark}}</view>
        <view class="entry-copy">
          <view class="entry-title">{{item.title}}</view>
          <view class="entry-description">{{item.description}}</view>
        </view>
        <view class="common-feature-action">开始</view>
        <view class="home-feature-arrow entry-arrow">›</view>
      </view>

      <view
        class="card recent-card common-feature-row home-feature-card workbench-link-card {{records.length ? 'recent-card-filled' : 'recent-card-empty'}}"
        catchtap="openRecords"
        hover-class="workbench-link-card-hover"
        hover-start-time="0"
        hover-stay-time="70"
      >
        <view class="feature-card-leading common-feature-row-main">
          <view class="feature-card-icon recent-card-icon">记</view>
          <view class="feature-card-copy">
            <view class="section-title">制作记录</view>
            <view class="common-feature-description">查看之前完成的作品</view>
          </view>
        </view>
        <button
          class="small-btn plain-btn recent-more recent-more-c common-feature-action-button"
          catchtap="openRecords"
        >
          <text class="recent-more-label">查看</text>
        </button>
        <view class="home-feature-arrow recent-more-arrow">›</view>

        <view wx:if="{{records.length}}" class="recent-list">
          <view
            wx:for="{{records}}"
            wx:key="id"
            class="recent-item"
            data-url="{{item.imagePath}}"
            catchtap="previewRecord"
          >
            <image
              wx:if="{{item.imagePath}}"
              class="recent-image"
              src="{{item.imagePath}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="recent-image recent-image-empty">无图</view>
            <view class="recent-info">
              <view class="recent-name">{{item.projectName}}</view>
              <view class="recent-time">{{item.createdAt}}</view>
            </view>
            <view class="recent-arrow">›</view>
          </view>
        </view>
      </view>

      <view
        class="card publish-export-entry common-feature-row home-feature-card workbench-link-card"
        bindtap="openPublishExport"
        hover-class="workbench-link-card-hover"
        hover-start-time="0"
        hover-stay-time="70"
      >
        <view class="publish-export-icon">AI</view>
        <view class="publish-export-copy">
          <view class="publish-export-title">降低 AI 痕迹</view>
          <view class="publish-export-description">导出前做一次自然度处理</view>
        </view>
        <view class="common-feature-action">去优化</view>
        <view class="home-feature-arrow publish-export-arrow">›</view>
      </view>

      <view
        class="card photo-to-video-entry common-feature-row home-feature-card workbench-link-card"
        bindtap="openPhotoToVideo"
        hover-class="workbench-link-card-hover"
        hover-start-time="0"
        hover-stay-time="70"
      >
        <view class="photo-to-video-icon">动</view>
        <view class="photo-to-video-copy">
          <view class="photo-to-video-title">照片转实况图</view>
          <view class="photo-to-video-description">生成动态视频，照片也会保留</view>
        </view>
        <view class="common-feature-action">制作</view>
        <view class="home-feature-arrow photo-to-video-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="feature-group-heading diagnostic-feature-heading">
    <view class="feature-group-title">
      <view class="feature-group-dot"></view>
      <text>其他服务</text>
    </view>
    <view class="feature-group-subtitle">作品记录、图片优化和问题反馈</view>
  </view>

  <view class="card interaction-log-card">
    <view
      class="section-head diagnostic-toggle-head"
      catchtap="toggleDiagnosticPanel"
      hover-class="diagnostic-toggle-head-hover"
    >
      <view class="feature-card-leading">
        <view class="feature-card-icon interaction-log-icon">查</view>
        <view class="feature-card-copy">
          <view class="section-kicker">服务记录</view>
          <view class="section-title">查看问题报告</view>
        </view>
      </view>
      <view class="diagnostic-toggle-summary">
        <view class="interaction-log-count">
          {{diagnosticStats.eventCount}} 条 · {{diagnosticStats.errorCount}} 错误 · {{diagnosticStats.warnCount}} 提醒
        </view>
        <view class="diagnostic-toggle-indicator">
          <text>{{diagnosticExpanded ? '收起' : '展开'}}</text>
          <text class="diagnostic-toggle-arrow {{diagnosticExpanded ? 'diagnostic-toggle-arrow-expanded' : ''}}">
            ⌄
          </text>
        </view>
      </view>
    </view>
    <view wx:if="{{diagnosticExpanded}}" class="diagnostic-expanded-content">
      <view class="diagnostic-summary diagnostic-summary-{{diagnosticSummary.tone}}">
        <view class="diagnostic-summary-main">
          <view class="diagnostic-summary-icon">{{diagnosticSummary.icon}}</view>
          <view class="diagnostic-summary-copy">
            <view class="diagnostic-summary-title">{{diagnosticSummary.title}}</view>
            <view class="diagnostic-summary-description">{{diagnosticSummary.description}}</view>
          </view>
        </view>
        <view class="diagnostic-summary-count">
          <text class="diagnostic-summary-count-number">{{diagnosticStats.eventCount}}</text>
          <text>条记录</text>
        </view>
      </view>
      <view class="interaction-log-actions interaction-log-actions-primary">
        <button
          class="small-btn plain-btn interaction-log-button interaction-log-primary-button"
          size="mini"
          catchtap="toggleDiagnosticPanel"
        >
          收起日志
        </button>
        <button
          class="small-btn plain-btn interaction-log-button diagnostic-copy-button"
          size="mini"
          bindtap="copyDiagnosticReport"
        >
          复制报告
        </button>
        <button
          class="small-btn plain-btn interaction-log-button interaction-log-clear"
          size="mini"
          bindtap="clearDiagnosticLogs"
        >
          清空
        </button>
      </view>
      <view class="interaction-log-list" data-diagnostic-events="{{diagnosticEvents}}">
        <view class="diagnostic-session-summary">
          本次会话：{{diagnosticSession.startedAtText || '刚刚'}}
        </view>
        <view wx:if="{{!diagnosticGroups.length}}" class="interaction-log-empty">
          本次启动还没有排查日志
        </view>
        <view
          wx:for="{{diagnosticGroups}}"
          wx:for-item="group"
          wx:key="key"
          class="diagnostic-group diagnostic-group-{{group.tone}}"
        >
          <view class="diagnostic-group-head">
            <view class="diagnostic-group-title-wrap">
              <view class="diagnostic-group-dot"></view>
              <view>
                <view class="diagnostic-group-title">{{group.title}}</view>
                <view class="diagnostic-group-note">{{group.note}}</view>
              </view>
            </view>
            <view class="diagnostic-group-count">{{group.count}} 条</view>
          </view>
          <view
            wx:for="{{group.events}}"
            wx:for-item="item"
            wx:key="sequence"
            class="diagnostic-event diagnostic-event-{{item.level}} {{item.expanded ? 'diagnostic-event-expanded' : ''}}"
            data-sequence="{{item.sequence}}"
            bindtap="toggleDiagnosticEvent"
          >
            <view class="diagnostic-event-head">
              <view class="diagnostic-event-leading">
                <view class="diagnostic-event-status">{{item.levelLabel}}</view>
                <view class="diagnostic-event-title-wrap">
                  <view class="diagnostic-event-title">{{item.message}}</view>
                  <view class="diagnostic-event-meta">
                    {{item.categoryLabel}} · {{item.displayTime}}
                  </view>
                </view>
              </view>
              <view class="diagnostic-event-arrow {{item.expanded ? 'diagnostic-event-arrow-expanded' : ''}}">›</view>
            </view>
            <view wx:if="{{item.expanded}}" class="diagnostic-event-detail">
              <view class="diagnostic-event-detail-title">{{item.title}}</view>
              <view wx:if="{{item.metaText}}" class="diagnostic-log-detail">
                {{item.metaText}}
              </view>
              <view wx:if="{{item.route}}" class="diagnostic-log-detail">
                页面：{{item.route}}
              </view>
              <view wx:if="{{item.detailText}}" class="diagnostic-log-detail">
                {{item.detailText}}
              </view>
              <view wx:if="{{item.errorText}}" class="diagnostic-log-error">
                {{item.errorText}}
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{adminVisible}}"
    class="card admin-entry-card home-feature-card workbench-link-card"
    bindtap="openAdmin"
    hover-class="workbench-link-card-hover"
    hover-start-time="0"
    hover-stay-time="70"
  >
    <view class="admin-entry-icon">管</view>
    <view class="admin-entry-copy">
      <view class="admin-entry-title">管理员配置</view>
      <view class="admin-entry-description">调整生图、视频模型和检查线上部署</view>
    </view>
    <view class="home-feature-arrow admin-entry-arrow">›</view>
  </view>

  <view class="card contact-author-card">
    <view
      class="contact-author-heading"
      bindtap="toggleAuthorQr"
      hover-class="contact-author-heading-hover"
    >
      <view class="contact-author-icon">联</view>
      <view class="contact-author-copy">
        <view class="section-kicker">作者微信</view>
        <view class="contact-author-title">添加微信咨询</view>
        <view wx:if="{{contactAuthorExpanded}}" class="contact-author-description">
          点击二维码可放大，长按识别添加好友
        </view>
      </view>
      <view class="contact-author-toggle">
        <text>{{contactAuthorExpanded ? '收起' : '展开'}}</text>
        <text class="contact-author-toggle-arrow">
          {{contactAuthorExpanded ? '⌃' : '⌄'}}
        </text>
      </view>
    </view>
    <view wx:if="{{contactAuthorExpanded}}" class="contact-author-body">
      <view class="contact-author-qr-shell">
        <image
          class="contact-author-qr"
          src="{{authorQrPath}}"
          mode="widthFix"
          bindtap="previewAuthorQr"
          show-menu-by-longpress="true"
        ></image>
      </view>
      <button
        class="primary-btn contact-author-save-button"
        bindtap="saveAuthorQr"
        loading="{{savingAuthorQr}}"
        disabled="{{savingAuthorQr}}"
      >
        {{savingAuthorQr ? '保存中...' : '保存二维码'}}
      </button>
    </view>
  </view>

  </view>

  <view
    wx:if="{{authorQrPreviewVisible}}"
    class="author-qr-preview-mask"
    catchtap="closeAuthorQrPreview"
    catchtouchmove="stopAuthorQrPreviewClose"
  >
    <view class="author-qr-preview-counter">1 / 1</view>
    <view wx:if="{{authorQrPreviewLoading}}" class="author-qr-preview-loading">
      正在打开二维码…
    </view>
    <image
      wx:if="{{!authorQrPreviewError}}"
      class="author-qr-preview-image"
      src="{{authorQrPath}}"
      mode="aspectFit"
      bindload="onAuthorQrPreviewLoad"
      binderror="onAuthorQrPreviewError"
      catchtap="stopAuthorQrPreviewClose"
    ></image>
    <view wx:if="{{authorQrPreviewError}}" class="author-qr-preview-error">
      二维码加载失败，请关闭后重试
    </view>
    <view class="author-qr-preview-hint">点击黑色空白处关闭</view>
  </view>

  <view class="workbench-footer">
    <view>局部创作，整体可控</view>
    <view>版本 {{appVersion}} · {{cloudReady ? '云端已连接' : '本地预览模式'}}</view>
  </view>
</view>
