<view class="operations-page">
  <view class="appbar" style="{{appbarStyle}}">
    <view class="appbar-title">{{viewTitle}}</view>
    <view wx:if="{{showDemoControl}}" class="demo-control {{loading || busy ? 'locked' : ''}}" aria-role="switch" aria-checked="{{demoMode}}" aria-label="切换演示数据" bindtap="toggleDemoMode" hover-class="tap"><text class="demo-label">演示</text><view class="demo-toggle {{demoMode ? 'on' : ''}}"><view class="demo-knob"></view></view></view>
    <view class="appbar-link" bindtap="backToDashboard" hover-class="tap">返回控制台 <text>›</text></view>
  </view>

  <scroll-view class="operations-scroll" style="{{operationsScrollStyle}}" scroll-y="true" enable-back-to-top="true">
    <view class="overview-card">
      <text class="overview-eyebrow">{{eyebrow}}</text>
      <text class="overview-title">{{viewTitle}}</text>
      <text class="overview-description">{{description}}</text>
      <view class="overview-actions"><button class="overview-button" loading="{{busy}}" disabled="{{busy}}" bindtap="refreshCurrent" hover-class="tap">{{refreshLabel}}</button><button class="overview-button" loading="{{busy}}" disabled="{{busy}}" bindtap="exportCurrent" hover-class="tap">{{exportLabel}}</button></view>
    </view>

    <view class="summary-grid">
      <view wx:for="{{summary}}" wx:key="label" class="summary-item"><text class="summary-label">{{item.label}}</text><text class="summary-value">{{item.value}}</text></view>
    </view>

    <view wx:if="{{loading}}" class="empty-note">正在读取真实数据...</view>
    <view wx:elif="{{empty}}" class="empty-note">{{footNote}}</view>
    <view wx:else class="detail-list">
      <view wx:for="{{detailRows}}" wx:key="title" class="detail-card">
        <view class="detail-head" data-index="{{index}}" bindtap="toggleRow" hover-class="tap"><view class="detail-copy"><text class="detail-title">{{item.title}}</text><text class="detail-description">{{item.detail}}</text></view><button class="detail-toggle" catchtap="toggleRow" data-index="{{index}}">{{item.expanded ? '收回' : '展开'}}⌄</button></view>
        <view wx:if="{{item.expanded}}" class="detail-body"><text wx:for="{{item.bodyLines}}" wx:key="*this" class="detail-line">{{item}}</text><text wx:if="{{!item.bodyLines.length}}" class="detail-line">暂无明细。</text></view>
      </view>
    </view>

    <view wx:if="{{!loading && !empty}}" class="foot-note">{{footNote}}</view>
    <view wx:if="{{message}}" class="message">{{message}}</view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
