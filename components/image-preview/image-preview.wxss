.image-preview-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  align-items: center;
  justify-content: center;
  background: rgba(12, 18, 29, 0.82);
}

.image-preview-panel {
  display: block;
  box-sizing: border-box;
  max-width: 680rpx;
  margin: 0 auto;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.24);
}

.image-preview-title {
  color: #1d2433;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.image-preview-stage {
  display: block;
  margin: 18rpx auto 0;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
}

.image-preview-image {
  display: block;
}

.image-preview-error {
  display: flex;
  width: 100%;
  min-height: 180rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  color: #8b96a8;
  font-size: 24rpx;
  text-align: center;
}

.image-preview-hint {
  margin-top: 14rpx;
  color: #8b96a8;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.image-preview-close {
  display: flex;
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  margin: 20rpx 0 0;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d9e2f0;
  border-radius: 16rpx;
  background: #f5f8fc;
  color: #2f70d4;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}
