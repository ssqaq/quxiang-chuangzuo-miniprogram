<view class="admin-page">
  <view class="console-header">
    <view class="console-back" bindtap="backToWorkbench" hover-class="control-tap" role="button" aria-label="返回工作台">‹</view>
    <view class="console-heading">
      <view class="console-title">控制台</view>
      <view class="console-subtitle">模型、积分与成本配置</view>
    </view>
    <view class="admin-access-badge">{{isAdmin ? '管理员' : '未授权'}}</view>
  </view>

  <view wx:if="{{loading}}" class="card admin-state-card admin-loading-card">
    <view class="admin-loading-title">正在读取管理员配置...</view>
    <view class="admin-loading-skeleton admin-loading-skeleton-title"></view>
    <view class="admin-loading-skeleton-grid">
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
    </view>
    <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
    <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
    <view wx:if="{{canRetry}}" class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && !isAdmin && canRetry}}" class="card admin-state-card">
    <view>{{message || '管理员页面暂时无法打开。'}}</view>
    <view class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && isAdmin}}" class="admin-content">
    <view wx:if="{{message}}" class="admin-message">{{message}}</view>

    <view wx:if="{{compactModelMode}}" class="compact-model-shell">
      <view class="compact-model-header">
        <view class="compact-model-back" bindtap="backToWorkbench" hover-class="control-tap" role="button" aria-label="返回工作台">‹</view>
        <view class="compact-model-heading">
          <view class="compact-model-title">模型配置</view>
          <view class="compact-model-subtitle">主模型与备用模型统一管理</view>
        </view>
        <view class="compact-provider-link" bindtap="openCompactProviderDirectory" hover-class="control-tap" role="button" aria-label="打开服务商目录">服务商目录 <text>›</text></view>
      </view>

      <view class="compact-overview-card">
        <view class="compact-card-head">
          <view>
            <view class="compact-card-title">配置总览</view>
            <view class="compact-card-caption">四项能力随时可切换</view>
          </view>
          <view class="compact-status-pill compact-status-{{compactOverview.tone}}">{{compactOverview.status}}</view>
        </view>
        <view class="compact-overview-grid">
          <view class="compact-overview-item">
            <view class="compact-overview-label">已配置能力</view>
            <view class="compact-overview-value">{{compactOverview.readyCount}} / 4</view>
          </view>
          <view class="compact-overview-item">
            <view class="compact-overview-label">备用模型</view>
            <view class="compact-overview-value">{{compactOverview.backupCount}} 个已启用</view>
          </view>
          <view class="compact-overview-item compact-overview-item-wide">
            <view class="compact-overview-label">CloudBase 环境</view>
            <view class="compact-overview-value compact-cloudbase-{{compactOverview.cloudTone}}">{{compactOverview.cloudStatus}}</view>
          </view>
        </view>
      </view>

      <view class="compact-model-tabs">
        <view class="compact-model-tabs-inner">
          <view
            wx:for="{{compactModelTabs}}"
            wx:key="value"
            class="compact-model-tab {{compactActiveSection === item.value ? 'is-active' : ''}}"
            data-section="{{item.value}}"
            bindtap="switchCompactModelTab"
            hover-class="control-tap"
            role="tab"
            aria-selected="{{compactActiveSection === item.value}}"
          >{{item.label}}</view>
        </view>
      </view>

        <view class="compact-primary-card">
        <view class="compact-section-head">
          <view>
            <view class="compact-section-title">{{compactActiveModel.title}}</view>
            <view class="compact-section-caption">{{compactActiveModel.description}}</view>
          </view>
          <view class="compact-primary-badge">主模型</view>
        </view>
        <view wx:if="{{compactActiveSection !== 'tencentFaceFusion'}}" class="compact-summary-grid">
          <view class="compact-summary-cell">
            <view class="compact-summary-label">服务商</view>
            <view class="compact-summary-value compact-ellipsis">{{compactActiveModel.provider || '未配置'}}</view>
          </view>
          <view class="compact-summary-cell">
            <view class="compact-summary-label">模型</view>
            <view class="compact-summary-value compact-ellipsis">{{compactActiveModel.model || '未配置'}}</view>
          </view>
          <view class="compact-summary-cell compact-summary-cell-wide">
            <view class="compact-summary-label">Base URL</view>
            <view class="compact-summary-value compact-ellipsis">{{compactActiveModel.baseUrl || '未配置'}}</view>
          </view>
          <view class="compact-summary-cell">
            <view class="compact-summary-label">公共 Key</view>
            <view class="compact-summary-value {{compactActiveModel.keyReady ? 'is-ready' : 'is-off'}}">{{compactActiveModel.keyText}}</view>
          </view>
          <view class="compact-summary-cell">
            <view class="compact-summary-label">超时</view>
            <view class="compact-summary-value">{{compactActiveModel.timeoutText}}</view>
          </view>
        </view>
        <view wx:else class="compact-special-note">
          腾讯融合使用独立参数。服务商资料统一在“服务商目录”维护，避免重复修改。
        </view>
        <view class="compact-card-footer">
          <view class="compact-card-footer-note">服务商资料、Key 和能力参数统一由服务商目录管理</view>
          <view class="compact-card-footer-link" data-provider-key="{{compactActiveModel.providerKey}}" data-tab="{{compactActiveSection}}" bindtap="openCompactProviderEditor" hover-class="control-tap" role="button">管理当前服务商 <text>›</text></view>
        </view>
      </view>

      <view wx:if="{{compactBackupSection}}" class="compact-failover-card">
        <view class="compact-section-head compact-failover-head">
          <view>
            <view class="compact-section-title">故障切换</view>
            <view class="compact-section-caption">主模型失败时自动尝试备用模型</view>
          </view>
          <view class="compact-section-caption">{{compactBackupEnabledText}}</view>
        </view>
        <view class="compact-backup-row" bindtap="toggleCompactBackup" hover-class="control-tap" role="button" aria-expanded="{{compactBackupExpanded}}" aria-label="{{compactBackupExpanded ? '收起备用模型参数' : '展开备用模型参数'}}">
          <view class="compact-backup-icon">↗</view>
          <view class="compact-backup-copy">
            <view class="compact-backup-title">{{compactActiveBackup.title}}</view>
            <view class="compact-backup-caption">{{compactActiveBackup.caption}}</view>
          </view>
          <view class="compact-backup-action">{{compactBackupExpanded ? '收起' : '展开'}} <text class="compact-chevron {{compactBackupExpanded ? 'is-open' : ''}}">⌄</text></view>
        </view>
        <view wx:if="{{compactBackupExpanded}}" class="compact-backup-panel">
          <view class="compact-inline-switch-row">
            <view>
              <view class="compact-field-label">启用备用模型</view>
              <view class="compact-field-hint">关闭后会保留参数，下次可直接恢复</view>
            </view>
            <switch checked="{{compactActiveBackup.enabled}}" color="#1fb984" data-section="{{compactBackupSection}}" bindchange="toggleCompactBackupEnabled" />
          </view>
          <view wx:if="{{compactActiveBackup.enabled}}" class="compact-backup-summary">
            <view class="compact-backup-summary-row"><text>当前服务商</text><text class="compact-backup-summary-value">{{compactActiveBackup.provider || '未配置'}}</text></view>
            <view class="compact-backup-summary-row"><text>备用模型</text><text class="compact-backup-summary-value">{{compactActiveBackup.model || '未配置'}}</text></view>
            <view class="compact-backup-summary-row"><text>Key 状态</text><text class="compact-backup-summary-value {{compactActiveBackup.keyReady ? 'is-ready' : 'is-off'}}">{{compactActiveBackup.keyText}}</text></view>
            <view class="compact-backup-summary-row"><text>超时</text><text class="compact-backup-summary-value">{{compactActiveBackup.timeoutText}}</text></view>
          </view>
          <view class="compact-backup-actions">
            <view class="compact-secondary-action" data-provider-key="{{compactActiveBackup.providerKey}}" data-tab="{{compactActiveSection}}" bindtap="openCompactBackupEditor" hover-class="control-tap" role="button">去服务商目录配置备用模型 <text>›</text></view>
            <view class="compact-secondary-action is-light" bindtap="startCompactProvider" hover-class="control-tap" role="button">新增服务商 <text>＋</text></view>
          </view>
        </view>
      </view>

      <view class="compact-advanced-card">
        <view class="compact-advanced-head" bindtap="toggleCompactAdvanced" hover-class="control-tap" role="button" aria-expanded="{{compactAdvancedExpanded}}">
          <view>
            <view class="compact-section-title">服务商管理</view>
            <view class="compact-section-caption">新增、编辑、删除和查看服务商档案</view>
          </view>
          <view class="compact-advanced-action">{{compactAdvancedExpanded ? '收起' : '展开'}} <text class="compact-chevron {{compactAdvancedExpanded ? 'is-open' : ''}}">⌄</text></view>
        </view>
        <view wx:if="{{compactAdvancedExpanded}}" class="compact-management-panel">
          <view class="compact-management-copy">服务商档案是唯一维护入口。这里不会重复编辑 Base URL、API Key 或模型参数，避免同一服务商在两处出现不同内容。</view>
          <view class="compact-management-actions">
            <view class="compact-secondary-action" data-provider-key="{{compactActiveModel.providerKey}}" data-tab="{{compactActiveSection}}" bindtap="openCompactProviderEditor" hover-class="control-tap" role="button">编辑当前服务商 <text>›</text></view>
            <view class="compact-secondary-action is-light" bindtap="startCompactProvider" hover-class="control-tap" role="button">新增服务商 <text>＋</text></view>
          </view>
        </view>
      </view>

      <view class="compact-save-bar">
        <view class="compact-save-hint">服务商资料请在服务商目录保存；这里的开关会保存当前能力配置</view>
        <button class="compact-save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveConfig">{{saving ? '保存中…' : '保存当前配置'}}</button>
        <view class="compact-full-link" bindtap="openCompactProviderDirectory" hover-class="control-tap" role="button">打开服务商管理 <text>›</text></view>
      </view>
    </view>

    <view wx:if="{{!compactModelMode}}" class="legacy-admin-layout">
      <view class="legacy-compact-back" bindtap="backToCompactModel" hover-class="control-tap" role="button">‹ 返回 C 配置</view>

    <view class="status-console status-{{dashboardStatus.tone}}">
      <view class="status-console-top">
        <view>
          <view class="status-console-label">线上运行状态</view>
          <view class="status-console-title">{{dashboardStatus.title}}</view>
        </view>
        <view class="status-console-dot"></view>
      </view>
      <view class="status-console-meta">
        <text>小程序 v{{appVersion}}</text>
        <text>探针 {{dashboardStatus.probeDurationText}}</text>
        <text>今日 {{todayFailureText}}</text>
      </view>
      <view class="status-console-build">
        <view class="status-console-build-row">
          <text class="status-console-build-label">云端 API</text>
          <text class="status-console-build-value">v{{onlineApiVersion || '未返回'}}</text>
        </view>
        <view class="status-console-build-row">
          <text class="status-console-build-label">构建标记</text>
          <text class="status-console-build-value status-console-build-marker" selectable="true">{{onlineBuildMarker || '未返回'}}</text>
        </view>
      </view>
      <view class="status-console-actions">
        <view
          class="status-check-button {{checking ? 'is-disabled' : ''}}"
          bindtap="checkDeployment"
          hover-class="control-tap"
          role="button"
          aria-label="立即检查线上部署"
        >
          {{checking ? '正在检查' : '检查线上部署'}}
        </view>
        <view
          class="status-check-button status-refresh-button {{refreshingAll ? 'is-disabled' : ''}}"
          bindtap="refreshAll"
          hover-class="control-tap"
          role="button"
          aria-label="一键刷新全部"
        >
          {{refreshingAll ? '正在刷新' : '一键刷新全部'}}
        </view>
        <view
          class="status-check-button status-probe-button {{modelProbing ? 'is-disabled' : ''}}"
          bindtap="probeModels"
          hover-class="control-tap"
          role="button"
          aria-label="探测四套模型接口"
        >
          {{modelProbing ? '正在探测' : '探测四套模型'}}
        </view>
      </view>
    </view>

    <view class="quick-launch-grid">
      <view
        class="quick-launch quick-face {{activeConfigSection === 'face' ? 'is-active' : ''}} {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开人脸识别模型配置"
      >
        <view class="quick-launch-icon">脸</view>
        <view class="quick-launch-name">人脸</view>
        <view class="quick-launch-state">{{entryHealth.face.label}}</view>
      </view>
      <view
        class="quick-launch quick-analysis {{activeConfigSection === 'analysis' ? 'is-active' : ''}} {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开图片分析模型配置"
      >
        <view class="quick-launch-icon">图</view>
        <view class="quick-launch-name">图片</view>
        <view class="quick-launch-state">{{entryHealth.analysis.label}}</view>
      </view>
      <view
        class="quick-launch quick-image {{activeConfigSection === 'image' ? 'is-active' : ''}} {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开生图模型配置"
      >
        <view class="quick-launch-icon">生</view>
        <view class="quick-launch-name">生图</view>
        <view class="quick-launch-state">{{entryHealth.image.label}}</view>
      </view>
      <view
        class="quick-launch quick-video {{activeConfigSection === 'video' ? 'is-active' : ''}} {{entryHealth.video.abnormal ? 'is-abnormal' : ''}}"
        data-section="video"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开视频模型配置"
      >
        <view class="quick-launch-icon">视</view>
        <view class="quick-launch-name">视频</view>
        <view class="quick-launch-state">{{entryHealth.video.label}}</view>
      </view>
      <view
        class="quick-launch quick-providers {{activeConfigSection === 'providers' ? 'is-active' : ''}}"
        data-section="providers"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开服务商目录"
      >
        <view class="quick-launch-icon">商</view>
        <view class="quick-launch-name">服务商</view>
        <view class="quick-launch-state">{{providerRows.length}} 个</view>
      </view>
      <view
        class="quick-launch quick-usage {{usageExpanded ? 'is-active' : ''}} {{entryHealth.usage.abnormal ? 'is-abnormal' : ''}}"
        bindtap="jumpToUsageSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型用量统计"
      >
        <view class="quick-launch-icon">量</view>
        <view class="quick-launch-name">用量</view>
        <view class="quick-launch-state">{{entryHealth.usage.label}}</view>
      </view>
      <view
        class="quick-launch quick-points {{activeConfigSection === 'points' ? 'is-active' : ''}} {{entryHealth.points.abnormal ? 'is-abnormal' : ''}}"
        data-section="points"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开积分规则配置"
      >
        <view class="quick-launch-icon">积</view>
        <view class="quick-launch-name">积分</view>
        <view class="quick-launch-state">{{entryHealth.points.label}}</view>
      </view>
      <view
        class="quick-launch quick-costs {{activeConfigSection === 'costs' ? 'is-active' : ''}} {{entryHealth.costs.abnormal ? 'is-abnormal' : ''}}"
        data-section="costs"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型成本配置"
      >
        <view class="quick-launch-icon">¥</view>
        <view class="quick-launch-name">成本</view>
        <view class="quick-launch-state">{{entryHealth.costs.label}}</view>
      </view>
      <view
        class="quick-launch quick-users {{activeConfigSection === 'users' ? 'is-active' : ''}} {{entryHealth.users.abnormal ? 'is-abnormal' : ''}}"
        data-section="users"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开用户统计"
      >
        <view class="quick-launch-icon">人</view>
        <view class="quick-launch-name">用户</view>
        <view class="quick-launch-state">{{entryHealth.users.label}}</view>
      </view>
    </view>

    <view class="overview-section today-section">
      <view class="overview-heading">今天</view>
      <view class="today-grid">
        <view class="today-item">
          <text class="today-value">{{usageStats.today.total}}</text>
          <text class="today-label">调用</text>
        </view>
        <view class="today-item">
          <text class="today-value {{usageStats.today.failure ? 'is-warn' : ''}}">{{usageStats.today.failure}}</text>
          <text class="today-label">失败</text>
        </view>
        <view class="today-item">
          <text class="today-value">¥{{usageStats.today.estimatedCostDisplay}}</text>
          <text class="today-label">预计成本</text>
        </view>
      </view>
    </view>

    <view class="overview-section">
      <view class="overview-heading">当前配置</view>
      <!-- 服务商入口固定放在当前配置标题与四项功能卡之间，方便直接管理目录。 -->
      <view
        class="provider-directory-row {{activeConfigSection === 'providers' ? 'is-active' : ''}}"
        data-section="providers"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开服务商目录"
      >
        <view class="current-config-main">
          <view class="current-config-title">服务商</view>
          <view class="current-config-meta">{{providerRows.length}} 个档案 · 管理人脸、分析、生图、视频及备用模型</view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{providerRows.length ? 'is-ready' : 'is-off'}}">{{providerRows.length ? '已配置' : '未配置'}}</view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{activeConfigSection === 'providers'}}" id="config-editor-providers" class="card config-editor config-editor-inline provider-manager-editor">
        <view class="config-editor-head">
          <view>
            <view class="config-editor-kicker">目录管理</view>
            <view class="config-editor-title">服务商</view>
          </view>
          <view class="config-close-button" bindtap="closeConfigSection" hover-class="control-tap" role="button" aria-label="收起服务商目录">收起</view>
        </view>
        <view class="config-helper">新增服务商只加入四项功能的选择器，不会自动替换当前线上绑定。API Key 只在这里的管理员编辑状态下读取，留空保存会保留原 Key。</view>
        <view wx:if="{{providerAutoRebound.length}}" class="provider-rebound-notice">
          删除后的自动切换：<block wx:for="{{providerAutoRebound}}" wx:key="*this"><text wx:if="{{index}}">、</text><text>{{item}}</text></block>
        </view>
        <view class="provider-secret-panel">
          <view class="provider-secret-head">
            <view>
              <view class="provider-secret-title">档案 API Key（明文）</view>
              <view class="provider-secret-desc">仅管理员页面显示；不会写入本地缓存、普通配置响应或日志。</view>
            </view>
            <view class="provider-secret-count">{{providerSecretRows.length || 0}} 个档案</view>
          </view>
          <view wx:if="{{providerSecretsLoading}}" class="provider-secret-empty">正在读取档案 Key…</view>
          <view wx:elif="{{providerSecretRows.length}}" class="provider-secret-list">
            <view wx:for="{{providerSecretRows}}" wx:key="providerKey" class="provider-secret-row">
              <view class="provider-secret-row-main">
                <view class="provider-secret-row-title">{{item.name || '未命名服务商'}}</view>
                <view class="provider-secret-row-id">{{item.id || item.providerKey}}</view>
              </view>
              <view class="provider-secret-row-key {{item.apiKey ? 'is-ready' : 'is-off'}}" selectable="true">{{item.apiKey || (item.apiKeyConfigured ? '已配置但读取失败' : '未配置')}}</view>
            </view>
          </view>
          <view wx:else class="provider-secret-empty">暂无可显示的服务商档案 Key。</view>
        </view>
        <view class="provider-manager-layout">
          <view class="provider-manager-list">
            <view class="provider-list-head">
              <view>
                <view class="provider-list-kicker">服务商目录</view>
                <view class="provider-list-count">{{providerRows.length}} 个档案</view>
                <view class="provider-list-help">点档案编辑，保存或删除后立即生效</view>
              </view>
              <view class="provider-add-button" bindtap="startAddProvider" hover-class="control-tap" role="button" aria-label="新增服务商">＋ 新增</view>
            </view>
            <view wx:if="{{!providerRows.length}}" class="provider-list-empty">还没有服务商档案，先新增一个。</view>
            <view
              wx:for="{{providerRows}}"
              wx:key="providerKey"
              class="provider-list-row {{providerEditingKey === item.providerKey ? 'is-selected' : ''}}"
              data-provider-key="{{item.providerKey}}"
              bindtap="selectProviderRow"
              hover-class="control-tap"
            >
              <view class="provider-list-row-main">
                <view class="provider-list-row-title">{{item.name}}</view>
                <view class="provider-list-row-id">{{item.id}}</view>
                <view class="provider-list-row-meta">{{item.capabilityText}} · {{item.usedText}}</view>
              </view>
              <view class="provider-list-row-actions">
                <view class="provider-list-row-state {{item.statusClass}}">{{item.status}}</view>
                <view class="provider-list-row-edit">编辑</view>
              </view>
            </view>
          </view>
          <view class="provider-manager-form">
            <view wx:if="{{providerDraft.id || providerEditingKey === ''}}">
              <view class="provider-form-title">{{providerEditingKey ? '编辑' : '新增'}}服务商{{providerDraft.name ? ' · ' + providerDraft.name : ''}}</view>
