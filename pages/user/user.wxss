.legacy-user-route {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: #f5f7fb;
}

.legacy-user-route-copy {
  color: #6d7c92;
  font-size: 28rpx;
}

.legacy-user-route-retry {
  color: #fff;
  background: #1f6feb;
  border-radius: 12rpx;
}
