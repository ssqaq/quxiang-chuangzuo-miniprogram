<view class="admin-page">
  <view class="console-header">
    <view class="console-back" bindtap="backToWorkbench" hover-class="control-tap" role="button" aria-label="返回工作台">‹</view>
    <view class="console-heading">
      <view class="console-title">控制台</view>
      <view class="console-subtitle">模型、积分与成本配置</view>
    </view>
    <view class="admin-access-badge">{{isAdmin ? '管理员' : '未授权'}}</view>
  </view>

  <view wx:if="{{loading}}" class="card admin-state-card admin-loading-card">
    <view class="admin-loading-title">正在读取管理员配置...</view>
    <view class="admin-loading-skeleton admin-loading-skeleton-title"></view>
    <view class="admin-loading-skeleton-grid">
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
    </view>
    <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
    <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
    <view wx:if="{{canRetry}}" class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && !isAdmin && canRetry}}" class="card admin-state-card">
    <view>{{message || '管理员页面暂时无法打开。'}}</view>
    <view class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && isAdmin}}" class="admin-content">
    <view wx:if="{{message}}" class="admin-message">{{message}}</view>

    <view class="status-console status-{{dashboardStatus.tone}}">
      <view class="status-console-top">
        <view>
          <view class="status-console-label">线上运行状态</view>
          <view class="status-console-title">{{dashboardStatus.title}}</view>
        </view>
        <view class="status-console-dot"></view>
      </view>
      <view class="status-console-meta">
        <text>v{{appVersion}}</text>
        <text>探针 {{dashboardStatus.probeDurationText}}</text>
        <text>今日 {{todayFailureText}}</text>
      </view>
      <view class="status-console-actions">
        <view
          class="status-check-button {{checking ? 'is-disabled' : ''}}"
          bindtap="checkDeployment"
          hover-class="control-tap"
          role="button"
          aria-label="立即检查线上部署"
        >
          {{checking ? '正在检查' : '检查线上部署'}}
        </view>
        <view
          class="status-check-button status-refresh-button {{refreshingAll ? 'is-disabled' : ''}}"
          bindtap="refreshAll"
          hover-class="control-tap"
          role="button"
          aria-label="一键刷新全部"
        >
          {{refreshingAll ? '正在刷新' : '一键刷新全部'}}
        </view>
        <view
          class="status-check-button status-probe-button {{modelProbing ? 'is-disabled' : ''}}"
          bindtap="probeModels"
          hover-class="control-tap"
          role="button"
          aria-label="探测四套模型接口"
        >
          {{modelProbing ? '正在探测' : '探测四套模型'}}
        </view>
      </view>
    </view>

    <view class="quick-launch-grid">
      <view
        class="quick-launch quick-face {{activeConfigSection === 'face' ? 'is-active' : ''}} {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开人脸识别模型配置"
      >
        <view class="quick-launch-icon">脸</view>
        <view class="quick-launch-name">人脸</view>
        <view class="quick-launch-state">{{entryHealth.face.label}}</view>
      </view>
      <view
        class="quick-launch quick-analysis {{activeConfigSection === 'analysis' ? 'is-active' : ''}} {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开图片分析模型配置"
      >
        <view class="quick-launch-icon">图</view>
        <view class="quick-launch-name">图片</view>
        <view class="quick-launch-state">{{entryHealth.analysis.label}}</view>
      </view>
      <view
        class="quick-launch quick-image {{activeConfigSection === 'image' ? 'is-active' : ''}} {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开生图模型配置"
      >
        <view class="quick-launch-icon">生</view>
        <view class="quick-launch-name">生图</view>
        <view class="quick-launch-state">{{entryHealth.image.label}}</view>
      </view>
      <view
        class="quick-launch quick-video {{activeConfigSection === 'video' ? 'is-active' : ''}} {{entryHealth.video.abnormal ? 'is-abnormal' : ''}}"
        data-section="video"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开视频模型配置"
      >
        <view class="quick-launch-icon">视</view>
        <view class="quick-launch-name">视频</view>
        <view class="quick-launch-state">{{entryHealth.video.label}}</view>
      </view>
      <view
        class="quick-launch quick-usage {{usageExpanded ? 'is-active' : ''}} {{entryHealth.usage.abnormal ? 'is-abnormal' : ''}}"
        bindtap="jumpToUsageSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型用量统计"
      >
        <view class="quick-launch-icon">量</view>
        <view class="quick-launch-name">用量</view>
        <view class="quick-launch-state">{{entryHealth.usage.label}}</view>
      </view>
      <view
        class="quick-launch quick-points {{activeConfigSection === 'points' ? 'is-active' : ''}} {{entryHealth.points.abnormal ? 'is-abnormal' : ''}}"
        data-section="points"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开积分规则配置"
      >
        <view class="quick-launch-icon">积</view>
        <view class="quick-launch-name">积分</view>
        <view class="quick-launch-state">{{entryHealth.points.label}}</view>
      </view>
      <view
        class="quick-launch quick-costs {{activeConfigSection === 'costs' ? 'is-active' : ''}} {{entryHealth.costs.abnormal ? 'is-abnormal' : ''}}"
        data-section="costs"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型成本配置"
      >
        <view class="quick-launch-icon">¥</view>
        <view class="quick-launch-name">成本</view>
        <view class="quick-launch-state">{{entryHealth.costs.label}}</view>
      </view>
      <view
        class="quick-launch quick-users {{activeConfigSection === 'users' ? 'is-active' : ''}} {{entryHealth.users.abnormal ? 'is-abnormal' : ''}}"
        data-section="users"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开用户统计"
      >
        <view class="quick-launch-icon">人</view>
        <view class="quick-launch-name">用户</view>
        <view class="quick-launch-state">{{entryHealth.users.label}}</view>
      </view>
    </view>

    <view class="overview-section today-section">
      <view class="overview-heading">今天</view>
      <view class="today-grid">
        <view class="today-item">
          <text class="today-value">{{usageStats.today.total}}</text>
          <text class="today-label">调用</text>
        </view>
        <view class="today-item">
          <text class="today-value {{usageStats.today.failure ? 'is-warn' : ''}}">{{usageStats.today.failure}}</text>
          <text class="today-label">失败</text>
        </view>
        <view class="today-item">
          <text class="today-value">¥{{usageStats.today.estimatedCostDisplay}}</text>
          <text class="today-label">预计成本</text>
        </view>
      </view>
    </view>

    <view class="overview-section">
      <view class="overview-heading">当前配置</view>
      <view class="tencent-status-card">
        <view class="tencent-status-head">
          <view>
            <view class="tencent-status-title">腾讯人脸融合专业版</view>
            <view class="tencent-status-subtitle">“开始新创作-腾讯版”独立使用，不影响普通生图</view>
          </view>
          <view class="config-state {{tencentFaceFusionStatus.configured ? 'is-ready' : 'is-off'}}">
            {{tencentFaceFusionStatus.configured ? '已配置' : '未配置'}}
          </view>
        </view>
        <view class="tencent-status-grid">
          <view><text>区域</text><text>{{tencentFaceFusionStatus.region}}</text></view>
          <view><text>接口</text><text>{{tencentFaceFusionStatus.model}}</text></view>
          <view><text>模型</text><text>{{tencentFaceFusionStatus.swapModelType}}</text></view>
          <view><text>最近调用</text><text>{{tencentFaceFusionStatus.lastCallStatus}}</text></view>
          <view><text>最近耗时</text><text>{{tencentFaceFusionStatus.lastDurationMs ? tencentFaceFusionStatus.lastDurationMs + 'ms' : '暂无'}}</text></view>
        </view>
        <view class="tencent-status-error" wx:if="{{tencentFaceFusionStatus.lastErrorMessage}}">
          最近错误：{{tencentFaceFusionStatus.lastErrorMessage}}
        </view>
        <view class="tencent-status-help">
          密钥只读取云函数环境变量，不在这里显示。未配置时请填写 TENCENT_FACEFUSION_SECRET_ID 和 TENCENT_FACEFUSION_SECRET_KEY。
        </view>
        <view class="tencent-test-title">真实测试腾讯接口</view>
        <view class="tencent-test-help">会真实调用 FuseFaceUltra，不调用 GPT Image 2、不扣小程序额度，也不会保存制作记录。</view>
        <view class="tencent-test-grid">
          <view
            class="tencent-test-upload"
            bindtap="chooseTencentTestImage"
            data-kind="template"
          >
            <image wx:if="{{tencentTestTemplate}}" src="{{tencentTestTemplate.path}}" mode="aspectFill"></image>
            <view wx:else class="tencent-test-empty">＋<text>模板图</text></view>
          </view>
          <view
            class="tencent-test-upload is-face"
            bindtap="chooseTencentTestImage"
            data-kind="face"
          >
            <image wx:if="{{tencentTestFace}}" src="{{tencentTestFace.path}}" mode="aspectFill"></image>
            <view wx:else class="tencent-test-empty">＋<text>参考脸</text></view>
          </view>
        </view>
        <view
          class="tencent-test-button {{tencentTestLoading ? 'is-disabled' : ''}}"
          bindtap="runTencentRealTest"
          role="button"
          aria-label="真实测试腾讯接口"
        >{{tencentTestLoading ? '正在真实调用腾讯接口…' : '真实测试腾讯接口'}}</view>
      </view>
      <view
        class="current-config-row {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看人脸识别模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">人脸识别模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.face}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{faceConfigSummary.ready ? 'is-ready' : 'is-off'}}">
            {{faceConfigSummary.ready ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{activeConfigSection === 'face'}}" id="config-editor-face" class="card config-editor config-editor-inline">
        <view class="config-editor-head">
          <view>
            <view class="config-editor-kicker">正在配置</view>
            <view class="config-editor-title">{{activeConfigTitle}}</view>
          </view>
          <view class="config-close-button" bindtap="closeConfigSection" hover-class="control-tap" role="button" aria-label="收起配置">收起</view>
        </view>
        <view class="config-editor-focus-tip">
          <view class="config-editor-focus-dot"></view>
          <view class="config-editor-focus-copy">
            <view class="config-editor-focus-label">当前正在配置</view>
            <view class="config-editor-focus-name">{{activeConfigTitle}}</view>
          </view>
          <view class="config-editor-focus-help">下面的修改只作用于这一项</view>
        </view>
        <view class="config-editor-body">
          <view class="config-helper">API Key 只在服务端保存，页面不会回显真实内容；输入框留空并保存，会继续使用原来的密钥。</view>
          <view class="config-model-actions">
            <view
              class="config-model-button config-model-test"
              data-model-type="face"
              bindtap="testModelConnection"
              hover-class="control-tap"
              role="button"
              aria-label="测试人脸识别模型连接"
            >{{modelActionType === 'face' && modelActionKind === 'test' ? '测试中...' : '测试连接'}}</view>
            <view
              class="config-model-button config-model-list"
              data-model-type="face"
              bindtap="getModelOptions"
              hover-class="control-tap"
              role="button"
              aria-label="获取人脸识别模型列表"
            >{{modelActionType === 'face' && modelActionKind === 'list' ? '读取中...' : '获取模型'}}</view>
          </view>
          <view class="admin-grid">
            <view class="admin-field"><text>服务商</text><input value="{{form.face.provider}}" data-section="face" data-key="provider" bindinput="onInput" /></view>
            <view class="admin-field"><text>使用的模型</text><input value="{{form.face.model}}" data-section="face" data-key="model" bindinput="onInput" /></view>
            <view class="admin-field admin-field-wide"><text>接口地址</text><input value="{{form.face.baseUrl}}" data-section="face" data-key="baseUrl" bindinput="onInput" /></view>
            <view class="admin-field admin-field-wide"><text>API Key</text><input password value="{{form.face.apiKey}}" data-section="face" data-key="apiKey" placeholder="{{effective.face.apiKeyConfigured ? '已配置，留空继续使用' : '填写后可测试并保存'}}" bindinput="onInput" /></view>
            <view class="admin-field"><text>超时毫秒</text><input type="number" value="{{form.face.timeoutMs}}" data-section="face" data-key="timeoutMs" bindinput="onInput" /></view>
          </view>
        </view>
        <view wx:if="{{activeConfigSection !== 'users'}}" class="admin-actions">
          <view
            class="admin-action-button primary-btn admin-save-button {{saving ? 'is-disabled' : ''}}"
            bindtap="saveConfig"
            hover-class="control-tap"
            role="button"
            aria-label="保存全部配置"
          >
            {{saving ? '保存中...' : '保存全部配置'}}
          </view>
          <view
            class="admin-action-button secondary-btn admin-close-button"
            bindtap="closeConfigSection"
            hover-class="control-tap"
            role="button"
            aria-label="暂不修改并收起"
          >暂不修改</view>
        </view>
      </view>

      <view
        class="current-config-row {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看图片分析模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">图片分析模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.analysis}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{entryHealth.analysis.abnormal ? 'is-off' : 'is-ready'}}">
            {{entryHealth.analysis.label}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{activeConfigSection === 'analysis'}}" id="config-editor-analysis" class="card config-editor config-editor-inline">
        <view class="config-editor-head">
          <view>
            <view class="config-editor-kicker">正在配置</view>
            <view class="config-editor-title">{{activeConfigTitle}}</view>
          </view>
          <view class="config-close-button" bindtap="closeConfigSection" hover-class="control-tap" role="button" aria-label="收起配置">收起</view>
        </view>
        <view class="config-editor-focus-tip">
          <view class="config-editor-focus-dot"></view>
          <view class="config-editor-focus-copy">
            <view class="config-editor-focus-label">当前正在配置</view>
            <view class="config-editor-focus-name">{{activeConfigTitle}}</view>
          </view>
          <view class="config-editor-focus-help">下面的修改只作用于这一项</view>
        </view>
        <view class="config-editor-body">
          <view class="config-helper">图片分析模型独立保存服务商、接口地址、API Key、使用的模型和超时；真实 Key 不会回显，留空保存会继续使用原来的密钥。</view>
          <view class="config-editor-tools config-model-actions">
            <view
              class="config-tool-button"
              bindtap="copyFaceConfigToAnalysis"
              hover-class="control-tap"
              role="button"
              aria-label="复制人脸识别配置到图片分析"
            >复制人脸配置</view>
            <view
              class="config-model-button config-model-test"
              data-model-type="analysis"
              bindtap="testModelConnection"
              hover-class="control-tap"
              role="button"
              aria-label="测试图片分析模型连接"
            >{{modelActionType === 'analysis' && modelActionKind === 'test' ? '测试中...' : '测试连接'}}</view>
            <view
              class="config-model-button config-model-list"
              data-model-type="analysis"
              bindtap="getModelOptions"
              hover-class="control-tap"
              role="button"
              aria-label="获取图片分析模型列表"
            >{{modelActionType === 'analysis' && modelActionKind === 'list' ? '读取中...' : '获取模型'}}</view>
          </view>
          <view class="admin-grid">
            <view class="admin-field"><text>服务商</text><input value="{{form.analysis.provider}}" data-section="analysis" data-key="provider" bindinput="onInput" /></view>
            <view class="admin-field"><text>使用的模型</text><input value="{{form.analysis.model}}" data-section="analysis" data-key="model" bindinput="onInput" /></view>
            <view class="admin-field admin-field-wide"><text>接口地址</text><input value="{{form.analysis.baseUrl}}" data-section="analysis" data-key="baseUrl" bindinput="onInput" /></view>
            <view class="admin-field admin-field-wide"><text>API Key</text><input password value="{{form.analysis.apiKey}}" data-section="analysis" data-key="apiKey" placeholder="{{effective.analysis.apiKeyConfigured ? '已配置，留空继续使用' : '填写后可测试并保存'}}" bindinput="onInput" /></view>
            <view class="admin-field"><text>超时毫秒</text><input type="number" value="{{form.analysis.timeoutMs}}" data-section="analysis" data-key="timeoutMs" bindinput="onInput" /></view>
          </view>
        </view>
        <view wx:if="{{activeConfigSection !== 'users'}}" class="admin-actions">
          <view
            class="admin-action-button primary-btn admin-save-button {{saving ? 'is-disabled' : ''}}"
            bindtap="saveConfig"
            hover-class="control-tap"
            role="button"
            aria-label="保存全部配置"
          >
            {{saving ? '保存中...' : '保存全部配置'}}
          </view>
          <view
            class="admin-action-button secondary-btn admin-close-button"
            bindtap="closeConfigSection"
            hover-class="control-tap"
            role="button"
            aria-label="暂不修改并收起"
          >暂不修改</view>
        </view>
      </view>

      <view
        class="current-config-row {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看生图模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">生图模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.image}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{effective.image.apiKeyConfigured ? 'is-ready' : 'is-off'}}">
            {{effective.image.apiKeyConfigured ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{activeConfigSection === 'image'}}" id="config-editor-image" class="card config-editor config-editor-inline">
        <view class="config-editor-head">
          <view>
            <view class="config-editor-kicker">正在配置</view>
            <view class="config-editor-title">{{activeConfigTitle}}</view>
          </view>
          <view class="config-close-button" bindtap="closeConfigSection" hover-class="control-tap" role="button" aria-label="收起配置">收起</view>
        </view>
        <view class="config-editor-focus-tip">
          <view class="config-editor-focus-dot"></view>
          <view class="config-editor-focus-copy">
            <view class="config-editor-focus-label">当前正在配置</view>
            <view class="config-editor-focus-name">{{activeConfigTitle}}</view>
          </view>
          <view class="config-editor-focus-help">下面的修改只作用于这一项</view>
        </view>
        <view class="config-editor-body">
          <view class="config-helper">API Key 只在服务端保存，页面不会回显真实内容；输入框留空并保存，会继续使用原来的密钥。</view>
          <view class="config-model-actions">
            <view
              class="config-model-button config-model-test"
              data-model-type="image"
              bindtap="testModelConnection"
              hover-class="control-tap"
              role="button"
              aria-label="测试生图模型连接"
            >{{modelActionType === 'image' && modelActionKind === 'test' ? '测试中...' : '测试连接'}}</view>
            <view
              class="config-model-button config-model-list"
              data-model-type="image"
              bindtap="getModelOptions"
              hover-class="control-tap"
              role="button"
              aria-label="获取生图模型列表"
            >{{modelActionType === 'image' && modelActionKind === 'list' ? '读取中...' : '获取模型'}}</view>
            <view
              class="config-model-button config-image-edit-probe {{imageEditCapabilityLoading ? 'is-disabled' : ''}}"
              bindtap="runImageEditCapabilityProbe"
              hover-class="control-tap"
              role="button"
              aria-label="不扣费检查图片编辑配置"
            >{{imageEditCapabilityLoading ? '检查中...' : '检查图片编辑配置'}}</view>
          </view>
          <view
            wx:if="{{imageEditCapabilityProbe.checked}}"
            class="image-edit-probe-card is-{{imageEditCapabilityProbe.tone}}"
          >
            <view class="image-edit-probe-head">
              <view>
                <view class="image-edit-probe-title">{{imageEditCapabilityProbe.statusText}}</view>
                <view class="image-edit-probe-subtitle">
                  {{imageEditCapabilityProbe.billingRiskText}} · {{imageEditCapabilityProbe.liveVerifiedText}}
                </view>
              </view>
              <view class="config-state {{imageEditCapabilityProbe.ready ? 'is-ready' : 'is-off'}}">
                {{imageEditCapabilityProbe.ready ? '配置完整' : '需要处理'}}
              </view>
            </view>
            <view class="image-edit-probe-grid">
