<view wx:if="{{loading}}" class="points-skeleton">
  <view class="skeleton-card skeleton-hero">
    <view class="skeleton-block skeleton-kicker"></view>
    <view class="skeleton-block skeleton-title"></view>
    <view class="skeleton-block skeleton-subtitle"></view>
    <view class="skeleton-metric-grid">
      <view class="skeleton-block skeleton-metric"></view>
      <view class="skeleton-block skeleton-metric"></view>
      <view class="skeleton-block skeleton-metric"></view>
      <view class="skeleton-block skeleton-metric"></view>
    </view>
  </view>
  <view class="skeleton-card">
    <view class="skeleton-block skeleton-section-title"></view>
    <view class="skeleton-block skeleton-progress"></view>
    <view class="skeleton-block skeleton-button"></view>
  </view>
  <view class="skeleton-card">
    <view class="skeleton-block skeleton-section-title"></view>
    <view class="skeleton-metric-grid">
      <view class="skeleton-block skeleton-usage"></view>
      <view class="skeleton-block skeleton-usage"></view>
      <view class="skeleton-block skeleton-usage"></view>
    </view>
  </view>
  <view class="skeleton-card skeleton-ledger">
    <view class="skeleton-block skeleton-section-title"></view>
    <view class="skeleton-block skeleton-row"></view>
    <view class="skeleton-block skeleton-row"></view>
    <view class="skeleton-block skeleton-row"></view>
  </view>
</view>

<view wx:else class="points-page points-dashboard-page">
  <view class="points-hero card">
    <view class="points-hero-head">
      <view class="points-heading">
        <view class="points-kicker">{{pointsCopy.pointsKicker}}</view>
        <view class="points-title">积分仪表盘</view>
        <view class="points-subtitle">{{points.boundMessage}}</view>
      </view>
      <view class="points-balance">
        <text class="points-balance-number">{{animatedPointsBalance}}</text>
        <text class="points-balance-label">{{pointsCopy.currentPointsLabel}}</text>
      </view>
    </view>

    <view class="dashboard-metric-grid">
      <view class="dashboard-metric dashboard-metric-blue">
        <text class="dashboard-metric-label">{{pointsCopy.currentPointsLabel}}</text>
        <text class="dashboard-metric-value">{{animatedPointsBalance}}</text>
      </view>
      <view class="dashboard-metric dashboard-metric-green">
        <text class="dashboard-metric-label">连续签到</text>
        <text class="dashboard-metric-value">{{animatedCurrentStreak}} {{pointsCopy.dayUnit}}</text>
      </view>
      <view class="dashboard-metric dashboard-metric-orange">
        <text class="dashboard-metric-label">{{pointsCopy.todayFreeLabel}}</text>
        <text class="dashboard-metric-value">{{animatedFreeRemaining}} / {{points.freeLimit}}</text>
      </view>
      <view class="dashboard-metric dashboard-metric-purple">
        <text class="dashboard-metric-label">{{pointsCopy.ledgerTotalPrefix}}</text>
        <text class="dashboard-metric-value">{{animatedTotalEarned}}</text>
      </view>
    </view>

    <view wx:if="{{points.promoActive}}" class="points-promo">
      {{pointsCopy.pointsPromo}}
    </view>
  </view>

  <view class="card streak-card">
    <view class="streak-head">
      <view class="streak-heading">
        <view class="section-title">{{pointsCopy.pointsSectionTitle}}</view>
        <view class="section-subtitle">{{pointsCopy.streakRewardPrefix}} {{points.streakDays}} {{pointsCopy.streakRewardMiddle}} {{points.streakBonus}} {{pointsCopy.pointsUnit}}</view>
      </view>
      <view class="streak-count">
        <text>{{points.currentStreak}}</text>
        <text>{{pointsCopy.dayUnit}}</text>
      </view>
    </view>
    <view class="streak-progress-track">
      <view
        class="streak-progress-fill"
        style="width: {{(points.progress / points.streakDays) * 100}}%;"
      ></view>
    </view>
    <view class="streak-progress-foot">
      <text>{{pointsCopy.progressPrefix}} {{points.progress}} {{pointsCopy.dayUnit}}</text>
      <text>{{pointsCopy.targetPrefix}} {{points.streakDays}} {{pointsCopy.dayUnit}}</text>
    </view>
    <button
      class="primary-btn checkin-button"
      bindtap="checkIn"
      loading="{{checkingIn}}"
      disabled="{{checkingIn || points.checkedInToday}}"
    >
      {{points.checkedInToday ? pointsCopy.checkedIn : (points.accountBound ? pointsCopy.checkInWithRewardPrefix + points.nextCheckinReward + pointsCopy.checkInWithRewardSuffix : pointsCopy.bindAndCheckIn)}}
    </button>
    <view class="checkin-hint">
      {{pointsCopy.checkInHintPrefix}} {{points.checkinPoints}} {{pointsCopy.checkInHintSuffix}}
    </view>
    <view wx:if="{{checkinCelebrationVisible}}" class="checkin-celebration">
      <view class="checkin-celebration-icon">✓</view>
      <view class="checkin-celebration-copy">
        <view class="checkin-celebration-title">签到成功</view>
        <view class="checkin-celebration-text">{{checkinCelebrationText}}</view>
      </view>
    </view>
  </view>

  <view class="card usage-card">
    <view class="section-head">
      <view class="section-title">{{pointsCopy.usageTitle}}</view>
      <view class="section-meta">按次扣除</view>
    </view>
    <view class="usage-grid">
      <view class="usage-item">
        <text class="usage-label">{{pointsCopy.todayFreeLabel}}</text>
        <text class="usage-value">{{points.freeRemaining}} / {{points.freeLimit}}</text>
      </view>
      <view class="usage-item">
        <text class="usage-label">{{pointsCopy.imageCostLabel}}</text>
        <text class="usage-value">{{points.imageCost}} {{pointsCopy.pointsUnit}}</text>
      </view>
      <view class="usage-item">
        <text class="usage-label">{{pointsCopy.videoCostLabel}}</text>
        <text class="usage-value">{{points.videoCost}} {{pointsCopy.pointsUnit}}</text>
      </view>
    </view>
    <view class="free-usage-progress">
      <view class="free-usage-progress-head">
        <text>今日免费次数使用情况</text>
        <text>{{points.freeUsed}} / {{points.freeLimit}} 次</text>
      </view>
      <view class="free-usage-track">
        <view class="free-usage-fill" style="width: {{points.freeUsagePercent}}%;"></view>
      </view>
      <view class="free-usage-foot">
        <text>还可使用 {{points.freeRemaining}} 次</text>
        <text>用完后扣积分</text>
      </view>
    </view>
    <view class="usage-note">{{pointsCopy.usageNote}}</view>
  </view>

  <view class="card ledger-card">
    <view class="ledger-head">
      <view class="section-title">{{pointsCopy.ledgerTitle}}</view>
      <view class="ledger-summary">
        <view class="ledger-summary-item">
          <text>累计获得</text>
          <text class="ledger-summary-value ledger-summary-income">{{points.totalEarned}}</text>
        </view>
        <view class="ledger-summary-item">
          <text>累计使用</text>
          <text class="ledger-summary-value ledger-summary-expense">{{points.totalSpent}}</text>
        </view>
      </view>
    </view>
    <view class="ledger-filter-bar">
      <view
        class="ledger-filter-chip {{ledgerFilter === 'all' ? 'ledger-filter-chip-active' : ''}}"
        data-filter="all"
        bindtap="onLedgerFilterTap"
      >全部</view>
      <view
        class="ledger-filter-chip {{ledgerFilter === 'income' ? 'ledger-filter-chip-active' : ''}}"
        data-filter="income"
        bindtap="onLedgerFilterTap"
      >获得</view>
      <view
        class="ledger-filter-chip {{ledgerFilter === 'expense' ? 'ledger-filter-chip-active' : ''}}"
        data-filter="expense"
        bindtap="onLedgerFilterTap"
      >使用</view>
    </view>
    <view wx:if="{{!visibleLedger.length}}" class="empty-ledger">
      {{ledgerFilter === 'all' ? pointsCopy.emptyLedger : '暂无符合条件的记录'}}
    </view>
    <view wx:for="{{visibleLedger}}" wx:key="id" class="ledger-row">
      <view class="ledger-copy">
        <view class="ledger-description">{{item.description}}</view>
        <view class="ledger-time">{{item.createdAt}}</view>
      </view>
      <text class="ledger-amount {{item.amountClass}}">{{item.amountText}}</text>
    </view>
  </view>

  <view wx:if="{{message}}" class="points-message">{{message}}</view>
  <button class="primary-btn back-button" bindtap="backToWorkbench">{{pointsCopy.backToWorkbench}}</button>
</view>
