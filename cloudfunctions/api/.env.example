# 视觉能力优先读取 AI_VISION_*；缺失时兼容回退旧 AI_*。
AI_VISION_PROVIDER=dashscope
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_API_KEY=不要把真实密钥提交到代码仓库
AI_VISION_MODEL=qwen3-vl-flash
AI_FACE_MODEL=qwen3-vl-flash
AI_VISION_TIMEOUT_MS=25000
AI_VISION_MAX_IMAGE_BYTES=5242880

# 旧配置兼容项。AI_* 只作为旧配置回退，新部署请使用下面的图片主备配置。
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=不要把真实密钥提交到代码仓库

# 图片编辑主模型：星炬。单次 150 秒，临时失败后由主备编排再调用 1 次。
AI_IMAGE_PRIMARY_PROVIDER=xingju
AI_IMAGE_PRIMARY_API_KEY=不要把真实密钥提交到代码仓库
AI_IMAGE_PRIMARY_BASE_URL=https://newapi.akiyo.fun/v1
AI_IMAGE_PRIMARY_ENDPOINT=https://newapi.akiyo.fun/v1/images/edits
AI_IMAGE_PRIMARY_MODEL=jw-gpt-image-2
AI_IMAGE_PRIMARY_MODE=edits
AI_IMAGE_PRIMARY_TIMEOUT_MS=150000
AI_IMAGE_PRIMARY_MAX_RETRIES=1

# 图片编辑备用模型：凌云。只在主模型两次未成功后调用 1 次。
AI_IMAGE_BACKUP_PROVIDER=lingyun
AI_IMAGE_BACKUP_API_KEY=不要把真实密钥提交到代码仓库
AI_IMAGE_BACKUP_BASE_URL=https://api.lingyunapi.xyz/v1
AI_IMAGE_BACKUP_ENDPOINT=https://api.lingyunapi.xyz/v1/images/edits
AI_IMAGE_BACKUP_MODEL=gpt-image-2
AI_IMAGE_BACKUP_MODE=edits
AI_IMAGE_BACKUP_TIMEOUT_MS=150000

AI_IMAGE_SIZE=1024x1024
AI_TIMEOUT_MS=90000
DAILY_GENERATION_LIMIT=5
AI_IMAGE_MODE=edits
AI_IMAGE_MAIN_FIELD=image
AI_IMAGE_MASK_FIELD=mask
AI_IMAGE_REFERENCE_FIELD=image[]
AI_MASK_INVERT=false
AI_MAX_RETRIES=2
AI_IMAGE_RETRY_ENABLED=true

# 腾讯版自动换脸专用。真实密钥只填写云函数环境变量，不要写进前端或提交到仓库。
TENCENT_FACEFUSION_SECRET_ID=不要把真实密钥提交到代码仓库
TENCENT_FACEFUSION_SECRET_KEY=不要把真实密钥提交到代码仓库
TENCENT_FACEFUSION_REGION=ap-guangzhou
TENCENT_FACEFUSION_SWAP_MODEL_TYPE=4
TENCENT_FACEFUSION_LOGO_ADD=false
TENCENT_FACEFUSION_TIMEOUT_MS=75000
TENCENT_FACEFUSION_MAX_IMAGE_BYTES=5242880

# 转实况/动态视频专用：凌云中转站 + Grok 异步视频协议
AI_VIDEO_PROVIDER=lingyun
AI_VIDEO_BASE_URL=https://api.lingyunapi.xyz
AI_VIDEO_ENDPOINT=
AI_VIDEO_QUERY_ENDPOINT=
AI_VIDEO_MODEL=grok-imagine-video-1.5
AI_VIDEO_API_KEY=不要把真实密钥提交到代码仓库
AI_VIDEO_CREATE_PATH=/v1/videos/generations
AI_VIDEO_QUERY_PATH=/v1/videos/{taskId}
AI_VIDEO_RESOLUTION=720p
AI_VIDEO_ASPECT_RATIO=
AI_VIDEO_TIMEOUT_MS=90000

# 管理员白名单：只放微信 OpenID，支持逗号或换行分隔。
# 不要把真实 OpenID 写进前端源码或发布包。
ADMIN_OPENIDS=你的管理员OpenID

# 如果中转站路径与标准路径不同，可以单独填写：
# AI_VISION_ENDPOINT=https://example.com/v1/chat/completions
# AI_IMAGE_PRIMARY_ENDPOINT=https://example.com/v1/images/edits
# AI_IMAGE_BACKUP_ENDPOINT=https://backup.example.com/v1/images/edits
