<view class="page publish-export-page">
  <view class="card publish-export-intro">
    <view class="section-title">降低AI识别率再导出</view>
  </view>

  <view class="card source-upload-card">
    <view class="section-title">1. 导入照片</view>
    <view class="section-subtitle">从手机相册选择照片导入</view>
    <button class="primary-btn upload-main-button" bindtap="chooseDevicePhotos">
      {{deviceRecords.length ? '重新选择照片' : '选择照片'}}
    </button>
    <view wx:if="{{deviceRecords.length}}" class="device-photo-preview-list">
      <image
        wx:for="{{deviceRecords}}"
        wx:key="id"
        class="device-photo-preview"
        src="{{item.path}}"
        mode="aspectFill"
        data-url="{{item.path}}"
        bindtap="previewRecord"
      ></image>
    </view>
    <view wx:if="{{deviceRecords.length}}" class="device-photo-hint">
      已导入 {{deviceRecords.length}} 张照片，当前将导出这些照片。
    </view>
  </view>

  <view class="card">
    <view class="section-title">2. 选择制作记录</view>
    <view class="scope-switch">
      <button
        wx:for="{{scopeOptions}}"
        wx:key="value"
        class="scope-button {{scope === item.value ? 'scope-button-active' : ''}}"
        data-scope="{{item.value}}"
        bindtap="changeScope"
      >
        {{item.label}}
      </button>
    </view>

    <view wx:if="{{loading}}" class="empty publish-export-empty">正在读取制作记录...</view>
    <view wx:elif="{{usingDevicePhotos && !deviceRecords.length}}" class="empty publish-export-empty">
      还没有导入照片。
      <button class="small-btn secondary-btn" bindtap="chooseDevicePhotos">导入照片</button>
    </view>
    <view wx:elif="{{!records.length}}" class="empty publish-export-empty">
      还没有可导出的制作记录。
      <button class="primary-btn upload-main-button" bindtap="goToCreate">去制作一张</button>
    </view>
    <view wx:else>
      <view class="selection-summary">
        已选择 {{selectedCount}} 张
        <text wx:if="{{usingDevicePhotos}}">（已导入照片）</text>
        <text wx:elif="{{scope === 'latest'}}">（默认使用最新一张）</text>
        <text wx:else>（全部记录）</text>
      </view>
      <view class="publish-record-list">
        <view
          wx:for="{{records}}"
          wx:key="id"
          class="publish-record {{item.selected ? 'publish-record-selected' : ''}}"
          data-url="{{item.tempFileURL || item.path}}"
          bindtap="previewRecord"
        >
          <image
            wx:if="{{item.tempFileURL || item.path}}"
            class="publish-record-image"
            src="{{item.tempFileURL || item.path}}"
            mode="aspectFill"
          ></image>
          <view wx:else class="publish-record-image publish-record-image-empty">无图</view>
          <view class="publish-record-info">
            <view class="publish-record-title">{{item.projectName}}</view>
            <view class="publish-record-time">{{item.createdAt}}</view>
            <view class="publish-record-state">{{item.selected ? '将导出' : '不导出'}}</view>
          </view>
          <view class="publish-record-check">{{item.selected ? '✓' : ''}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{records.length}}" class="card export-options-card">
    <view class="section-title">导出设置</view>

    <view class="option-line">
      <view class="option-label">文件格式</view>
      <view class="choice-list">
        <button
          wx:for="{{formatOptions}}"
          wx:key="value"
          class="choice-button {{format === item.value ? 'choice-button-active' : ''}}"
          data-format="{{item.value}}"
          bindtap="changeFormat"
        >
          {{item.label}}
        </button>
      </view>
    </view>

    <view wx:if="{{format === 'jpg'}}" class="quality-line">
      <view class="quality-head">
        <text class="option-label">JPG 品质</text>
        <text class="quality-value">{{quality}}%</text>
      </view>
      <slider
        value="{{quality}}"
        min="60"
        max="100"
        step="1"
        activeColor="#1f6feb"
        backgroundColor="#dfe7f3"
        block-size="22"
        bindchanging="changeQuality"
        bindchange="changeQuality"
      ></slider>
    </view>

    <view class="enhancement-group">
      <view class="enhancement-group-title">画面处理</view>
      <view class="enhancement-list">
        <view class="enhancement-row">
          <view>
            <view class="enhancement-title">基础色彩校正</view>
            <view class="enhancement-description">让颜色看起来自然</view>
          </view>
          <switch checked="{{colorCorrect}}" color="#1f6feb" data-key="colorCorrect" bindchange="toggleEnhancement"></switch>
        </view>
        <view class="enhancement-row">
          <view>
            <view class="enhancement-title">轻度降噪</view>
            <view class="enhancement-description">减少图片上的小杂点</view>
          </view>
          <switch checked="{{denoise}}" color="#1f6feb" data-key="denoise" bindchange="toggleEnhancement"></switch>
        </view>
        <view class="enhancement-row">
          <view>
            <view class="enhancement-title">清晰补偿</view>
            <view class="enhancement-description">让图片看起来更清楚</view>
          </view>
          <switch checked="{{sharpen}}" color="#1f6feb" data-key="sharpen" bindchange="toggleEnhancement"></switch>
        </view>
      </view>
    </view>

    <view class="enhancement-group">
      <view class="enhancement-group-title">相机质感</view>
      <view class="enhancement-list">
        <view class="enhancement-row">
          <view class="enhancement-row-copy">
            <view class="enhancement-title">固定相机颗粒</view>
            <view class="enhancement-description">加一点相机拍出的质感</view>
          </view>
          <view class="enhancement-side-note">增加颗粒感</view>
          <switch checked="{{cameraNoise}}" color="#1f6feb" data-key="cameraNoise" bindchange="toggleAdvanced"></switch>
        </view>
        <view class="strength-row">
          <view class="strength-head">
            <text class="option-label">颗粒强度</text>
            <text class="quality-value">{{cameraNoiseStrengthPreview}}</text>
          </view>
          <slider value="{{cameraNoiseStrength}}" min="1" max="5" step="0.1" activeColor="#1f6feb" backgroundColor="#dfe7f3" block-size="22" data-key="cameraNoiseStrength" bindchanging="previewAdvancedStrength" bindchange="commitAdvancedStrength"></slider>
        </view>
      </view>
    </view>

    <view class="enhancement-group">
      <view class="enhancement-group-title">高级画面处理</view>
      <view class="enhancement-list">
        <view class="enhancement-row">
          <view class="enhancement-row-copy">
            <view class="enhancement-title">频域扰动</view>
            <view class="enhancement-description">轻微改变图片细节</view>
          </view>
          <view class="enhancement-side-note">调整图片细节</view>
          <switch checked="{{frequencyPerturb}}" color="#1f6feb" data-key="frequencyPerturb" bindchange="toggleAdvanced"></switch>
        </view>
        <view class="enhancement-row">
          <view>
            <view class="enhancement-title">反向重采样</view>
            <view class="enhancement-description">重新处理图片，尺寸不变</view>
          </view>
          <switch checked="{{resamplePerturb}}" color="#1f6feb" data-key="resamplePerturb" bindchange="toggleAdvanced"></switch>
        </view>
        <view class="enhancement-row">
          <view class="enhancement-row-copy">
            <view class="enhancement-title">可见标记淡化</view>
            <view class="enhancement-description">让看得到的水印、文字或标记等信息变淡</view>
          </view>
          <view class="enhancement-side-note">水印文字变淡</view>
        </view>
        <view class="strength-row">
          <view class="strength-head">
            <text class="option-label">淡化强度</text>
            <text class="quality-value">{{watermarkStrengthPreview}}</text>
          </view>
          <slider value="{{watermarkStrength}}" min="1" max="5" step="0.1" activeColor="#1f6feb" backgroundColor="#dfe7f3" block-size="22" data-key="watermarkStrength" bindchanging="previewAdvancedStrength" bindchange="commitAdvancedStrength"></slider>
        </view>
        <view class="strength-row">
          <view class="strength-head">
            <text class="option-label">扰动强度</text>
            <text class="quality-value">{{frequencyStrengthPreview}}</text>
          </view>
          <slider value="{{frequencyStrength}}" min="1" max="5" step="0.1" activeColor="#1f6feb" backgroundColor="#dfe7f3" block-size="22" data-key="frequencyStrength" bindchanging="previewAdvancedStrength" bindchange="commitAdvancedStrength"></slider>
        </view>
      </view>
    </view>

    <button
      class="primary-btn export-button"
      loading="{{processing}}"
      disabled="{{processing || !selectedCount}}"
      bindtap="startExport"
    >
      {{processing ? '正在导出...' : '开始导出并保存到相册'}}
    </button>
    <button class="plain-btn back-button" bindtap="backToWorkbench">返回工作台</button>
  </view>

  <view wx:if="{{processing}}" class="card export-progress-card">
    <view class="progress-head">
      <view class="section-title">正在处理</view>
      <text class="quality-value">{{progressValue}}%</text>
    </view>
    <progress
      percent="{{progressValue}}"
      active
      activeColor="#1f6feb"
      backgroundColor="#e6edf7"
      stroke-width="8"
    ></progress>
    <view class="progress-text">{{progressText}}</view>
  </view>

  <canvas
    canvas-id="publish-export-canvas"
    id="publish-export-canvas"
    class="publish-export-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>
</view>
