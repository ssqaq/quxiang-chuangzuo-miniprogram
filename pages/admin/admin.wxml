        <view wx:if="{{moduleStates.autoFaceFailure.status !== 'loading'}}" class="auto-face-failure-subtitle">探针汇总</view>
        <view wx:if="{{moduleStates.autoFaceFailure.status !== 'loading'}}" class="auto-face-probe-hint">
