page {
  background: #f5f7fb;
}

.admin-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  color: #1d2433;
}

.card {
  border: 1rpx solid #e7ebf2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(31, 49, 79, 0.05);
}

.admin-hero {
  padding: 28rpx;
  background: linear-gradient(135deg, #eef5ff 0%, #ffffff 74%);
}

.admin-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.admin-kicker {
  color: #1f6feb;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.admin-title {
  margin-top: 8rpx;
  color: #182132;
  font-size: 40rpx;
  font-weight: 800;
}

.admin-subtitle,
.admin-section-help {
  margin-top: 8rpx;
  color: #718096;
  font-size: 22rpx;
  line-height: 34rpx;
}

.admin-access-badge,
.admin-config-state {
  flex: none;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #23834b;
  background: #eaf8ef;
  font-size: 20rpx;
}

.admin-config-state.is-off {
  color: #ae6b13;
  background: #fff5e8;
}

.admin-back-button {
  width: 100%;
  height: 68rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  color: #1f6feb;
  background: #e8f1ff;
  font-size: 26rpx;
  line-height: 68rpx;
}

.admin-back-button::after {
  border: 0;
}

.admin-content {
  margin-top: 18rpx;
}

.admin-message {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #31506e;
  background: #eef6ff;
  font-size: 23rpx;
  line-height: 34rpx;
}

.admin-state-card,
.admin-section {
  padding: 24rpx;
}

.admin-section {
  margin-bottom: 18rpx;
}

.usage-section {
  overflow: hidden;
}

.admin-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.admin-section-title {
  color: #1b2638;
  font-size: 30rpx;
  font-weight: 800;
}

.usage-refresh-button {
  flex: none;
  width: 142rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #cfe0f8;
  border-radius: 14rpx;
  color: #1f6feb;
  background: #eef5ff;
  font-size: 20rpx;
  line-height: 54rpx;
}

.usage-refresh-button::after {
  border: 0;
}

.usage-toolbar {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.usage-export-button {
  flex: none;
  width: 142rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d8c89a;
  border-radius: 14rpx;
  color: #8a6517;
  background: #fff8df;
  font-size: 20rpx;
  line-height: 54rpx;
}

.usage-export-button::after {
  border: 0;
}

.usage-message {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #31506e;
  background: #eef6ff;
  font-size: 21rpx;
  line-height: 30rpx;
}

.usage-message.is-warn {
  color: #9a631b;
  background: #fff6e9;
}

.usage-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.usage-summary-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  text-align: center;
}

.usage-summary-item text {
  display: block;
  color: #7d899b;
  font-size: 20rpx;
  line-height: 28rpx;
}

.usage-summary-item text + text {
  margin-top: 4rpx;
  color: #1e2d43;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.usage-summary-item text:last-child {
  color: #8a96a8;
  font-size: 18rpx;
  line-height: 26rpx;
}

.usage-cost-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.usage-cost-item {
  min-width: 0;
  padding: 16rpx 14rpx;
  border: 1rpx solid #f0e2b6;
  border-radius: 16rpx;
  background: #fffaf0;
}

.usage-cost-item text {
  display: block;
  color: #8b7440;
  font-size: 19rpx;
  line-height: 28rpx;
}

.usage-cost-item text + text {
  margin-top: 4rpx;
  color: #9b6f0a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.usage-cost-item text:last-child {
  overflow: hidden;
  color: #9a8960;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.usage-type-card {
  min-width: 0;
  padding: 16rpx 14rpx;
  border: 1rpx solid #e5ebf4;
  border-radius: 18rpx;
  background: #ffffff;
}

.usage-type-image {
  border-color: #d7e7ff;
  background: #f7fbff;
}

.usage-type-face {
  border-color: #e6def9;
  background: #fbf9ff;
}

.usage-type-video {
  border-color: #d9eee7;
  background: #f7fcfa;
}

.usage-type-top {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.usage-type-icon {
  display: flex;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #1f6feb;
  background: #e7f0ff;
  font-size: 20rpx;
  font-weight: 800;
}

.usage-type-face .usage-type-icon {
  color: #7653bd;
  background: #eee8ff;
}

.usage-type-video .usage-type-icon {
  color: #23834b;
  background: #e4f6ed;
}

.usage-type-title {
  min-width: 0;
  overflow: hidden;
  color: #334258;
  font-size: 20rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-type-total {
  margin-top: 12rpx;
  color: #1e2d43;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.usage-type-label,
.usage-type-result,
.usage-model-text,
.usage-daily-result {
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.usage-type-result {
  display: flex;
  gap: 10rpx;
  margin-top: 4rpx;
}

.usage-type-result text:first-child {
  color: #23834b;
}

.usage-type-result text:last-child {
  color: #b36d18;
}

.usage-model-text {
  overflow: hidden;
  margin-top: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-failure-panel {
  margin-top: 18rpx;
  padding-top: 2rpx;
}

.usage-failure-heading {
  margin-top: 0;
}

.usage-failure-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 10rpx;
}

.usage-failure-summary-item {
  min-width: 0;
  padding: 14rpx 12rpx;
  border: 1rpx solid #f1d8d8;
  border-radius: 16rpx;
  background: #fff9f9;
}

.usage-failure-summary-item text {
  display: block;
  overflow: hidden;
  color: #9a6d74;
  font-size: 18rpx;
  line-height: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-failure-summary-item text + text {
  margin-top: 4rpx;
  color: #b43e4b;
  font-size: 30rpx;
  font-weight: 800;
}

.usage-failure-summary-model text + text {
  color: #8d5560;
  font-size: 20rpx;
  font-weight: 700;
}

.usage-failure-list {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #fffafa;
}

.usage-failure-list-title {
  color: #7f3c47;
  font-size: 21rpx;
  font-weight: 800;
}

.usage-failure-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2e4e4;
}

.usage-failure-row:last-child {
  border-bottom: 0;
}

.usage-failure-row-top,
.usage-failure-row-detail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.usage-failure-label {
  min-width: 0;
  overflow: hidden;
  color: #4a2f35;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-failure-count,
.usage-failure-row-detail text {
  flex: none;
  color: #a36c74;
  font-size: 18rpx;
  line-height: 26rpx;
}

.usage-failure-row-detail {
  justify-content: flex-start;
  margin-top: 4rpx;
  flex-wrap: wrap;
}

.usage-daily-title {
  margin-top: 22rpx;
  color: #334258;
  font-size: 24rpx;
  font-weight: 800;
}

.usage-daily-list {
  max-height: 620rpx;
  margin-top: 10rpx;
}

.usage-daily-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.usage-daily-row:last-child {
  border-bottom: 0;
}

.usage-daily-date,
.usage-daily-values {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.usage-daily-date text:first-child {
  color: #334258;
  font-size: 21rpx;
  font-weight: 700;
}

.usage-daily-date text:last-child,
.usage-daily-values text,
.usage-daily-result {
  color: #7d899b;
  font-size: 19rpx;
  line-height: 28rpx;
}

.usage-daily-values {
  justify-content: flex-start;
  margin-top: 5rpx;
}

.usage-daily-values text {
  min-width: 112rpx;
}

.usage-daily-result {
  margin-top: 3rpx;
}

.usage-empty {
  padding-bottom: 0;
}

.auto-face-failure-section {
  overflow: hidden;
}

.auto-face-failure-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.auto-face-failure-summary-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border: 1rpx solid #f1d8d8;
  border-radius: 16rpx;
  background: #fff9f9;
  text-align: center;
}

.auto-face-failure-summary-item text {
  display: block;
  color: #9a6d74;
  font-size: 19rpx;
  line-height: 28rpx;
}

.auto-face-failure-summary-item text + text {
  margin-top: 4rpx;
  color: #b43e4b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.auto-face-failure-summary-item text:last-child {
  color: #a7838a;
  font-size: 18rpx;
  line-height: 26rpx;
}

.auto-face-probe-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.auto-face-probe-summary-item {
  min-width: 0;
  padding: 14rpx 12rpx;
  border: 1rpx solid #dce8f6;
  border-radius: 14rpx;
  background: #f7fbff;
}

.auto-face-probe-summary-wide {
  grid-column: 1 / -1;
}

.auto-face-probe-summary-item text,
.auto-face-probe-hint text {
  display: block;
  overflow: hidden;
  color: #6c7f96;
  font-size: 18rpx;
  line-height: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-face-probe-summary-item text + text {
  margin-top: 3rpx;
  color: #2f659d;
  font-size: 25rpx;
  font-weight: 800;
}

.auto-face-probe-hint {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  margin-top: 10rpx;
}

.auto-face-probe-hint text {
  color: #71859e;
}

.auto-face-failure-subtitle {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
  color: #6f3e47;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.auto-face-failure-type-list,
.auto-face-failure-recent-list {
  margin-top: 8rpx;
}

.auto-face-failure-type-row,
.auto-face-failure-recent-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2e4e4;
}

.auto-face-failure-type-row:last-child,
.auto-face-failure-recent-row:last-child {
  border-bottom: 0;
}

.auto-face-failure-type-row,
.auto-face-failure-recent-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.auto-face-failure-type-label {
  display: block;
  color: #4a2f35;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.auto-face-failure-type-last {
  display: block;
  margin-top: 3rpx;
  color: #a36c74;
  font-size: 18rpx;
  line-height: 26rpx;
}

.auto-face-failure-type-count,
.auto-face-failure-recent-top text:last-child {
  flex: none;
  color: #b43e4b;
  font-size: 20rpx;
  font-weight: 700;
}

.auto-face-failure-recent-top text:first-child {
  min-width: 0;
  overflow: hidden;
  color: #4a2f35;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-face-failure-recent-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  margin-top: 5rpx;
  color: #a36c74;
  font-size: 18rpx;
  line-height: 26rpx;
}

.auto-face-failure-recent-message {
  margin-top: 5rpx;
  overflow: hidden;
  color: #6f4a51;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-face-failure-recent-probe {
  margin-top: 5rpx;
  overflow: hidden;
  color: #3974a8;
  font-size: 18rpx;
  line-height: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-subsection-title {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
  color: #334258;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.usage-user-list,
.usage-model-list,
.usage-monthly-list {
  margin-top: 8rpx;
}

.usage-monthly-list {
  max-height: 560rpx;
}

.usage-user-row,
.usage-model-row,
.usage-monthly-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.usage-user-row:last-child,
.usage-model-row:last-child,
.usage-monthly-row:last-child {
  border-bottom: 0;
}

.usage-user-top,
.usage-model-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.usage-user-top text:first-child,
.usage-model-top text:first-child {
  min-width: 0;
  overflow: hidden;
  color: #334258;
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-user-top text:last-child,
.usage-model-top text:last-child {
  flex: none;
  color: #9b6f0a;
  font-size: 19rpx;
}

.usage-user-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  margin-top: 6rpx;
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.admin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.admin-field {
  min-width: 0;
}

.admin-field-wide {
  grid-column: 1 / -1;
}

.admin-field > text {
  display: block;
  margin-bottom: 8rpx;
  color: #68768a;
  font-size: 21rpx;
}

.admin-field input {
  box-sizing: border-box;
  width: 100%;
  height: 70rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  color: #1d2433;
  background: #fbfcfe;
  font-size: 23rpx;
}

.admin-checkbox-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #405069;
  font-size: 23rpx;
}

.admin-checkbox-row checkbox {
  margin-right: 10rpx;
}

.admin-actions {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.admin-actions button {
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 76rpx;
}

.admin-save-button {
  color: #ffffff !important;
  background: #1f6feb !important;
}

.admin-check-button {
  color: #1f6feb !important;
  background: #e8f1ff !important;
}

.deployment-card {
  margin-top: 0;
}

.auto-face-probe-card {
  margin-top: 0;
}

.deployment-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.deployment-grid view {
  min-width: 0;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.deployment-grid text {
  display: block;
  overflow: hidden;
  color: #7d899b;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deployment-grid text + text {
  margin-top: 4rpx;
  color: #26354b;
  font-size: 22rpx;
}

.admin-log-count {
  color: #7b8ba1;
  font-size: 21rpx;
}

.admin-empty {
  padding: 22rpx 0 4rpx;
  color: #8390a3;
  font-size: 22rpx;
}

.admin-log-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.admin-log-item:last-child {
  border-bottom: 0;
}

.admin-log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334258;
  font-size: 22rpx;
}

.admin-log-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-ok {
  color: #23834b;
}

.log-warn {
  color: #b36d18;
}

@media (max-width: 360px) {
  .admin-grid,
  .deployment-grid {
    grid-template-columns: 1fr;
  }

  .admin-field-wide {
    grid-column: auto;
  }

  .admin-actions {
    flex-direction: column;
  }

  .usage-summary-grid,
  .usage-type-grid,
  .usage-cost-summary,
  .usage-failure-summary,
  .auto-face-failure-summary {
    grid-template-columns: 1fr;
  }

  .usage-toolbar {
    width: 100%;
    margin-top: 10rpx;
  }

  .usage-refresh-button {
    flex: 1;
    width: auto;
    font-size: 18rpx;
  }

  .usage-export-button {
    flex: 1;
    width: auto;
    font-size: 18rpx;
  }
}
