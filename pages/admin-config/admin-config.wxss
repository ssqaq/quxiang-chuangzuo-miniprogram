page { background:#f4f8fe; color:#10294b; font-family:"Microsoft YaHei","PingFang SC","SimHei",sans-serif; font-weight:600; }
.config-page { min-height:100vh; background:#f4f8fe; }
.appbar { height:112rpx; padding:0 28rpx 22rpx; display:flex; align-items:flex-end; gap:14rpx; box-sizing:border-box; background:#fff; border-bottom:1rpx solid #d9e4f2; }
.back { width:38rpx; height:40rpx; color:#2f73ee; font-size:50rpx; line-height:33rpx; text-align:center; }
.appbar-title { flex:1; color:#10294b; font-size:38rpx; line-height:1; font-weight:900; }
.appbar-link { color:#2f73ee; font-size:23rpx; line-height:1; font-weight:900; }
.appbar-link text { font-size:30rpx; }
.config-scroll { height:calc(100vh - 112rpx); padding:24rpx; box-sizing:border-box; }
.group-stack { display:grid; gap:12rpx; }
.group-row { padding:16rpx; border:1rpx solid #c8dbf3; border-radius:20rpx; background:#fff; }
.group-row-top { display:flex; align-items:flex-end; justify-content:space-between; gap:10rpx; margin-bottom:12rpx; }
.group-title { color:#10294b; font-size:25rpx; font-weight:900; }
.group-note { color:#61799a; font-size:17rpx; }
.tab-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; }
.tab-grid.one-tab { grid-template-columns:minmax(0,1fr); }
.tab { min-height:104rpx; padding:8rpx 3rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5rpx; border:1rpx solid #d2e1f4; border-radius:15rpx; background:#edf5ff; color:#10294b; text-align:center; }
.tab.active { border-color:#2f73ee; background:#2f73ee; color:#fff; box-shadow:0 6rpx 15rpx rgba(47,115,238,.2); }
.tab-icon { width:42rpx; height:42rpx; display:grid; place-items:center; border-radius:12rpx; background:#fff; color:#2f73ee; font-size:18rpx; font-weight:900; }
.tab.active .tab-icon { color:#2f73ee; }
.tab text:nth-child(2) { font-size:17rpx; line-height:1.15; font-weight:900; }
.tab-status { color:#0e9e6e; font-size:15rpx; font-weight:900; }
.tab-status.pending { color:#b06a00; }
.tab.active .tab-status { color:#d7ffe9; }
.shared-group .tab { min-height:82rpx; flex-direction:row; justify-content:flex-start; padding:10rpx 16rpx; gap:12rpx; }
.shared-group .tab-status { margin-left:auto; }
.summary-card,.model-card,.failure-card,.advanced-card { margin-top:14rpx; padding:18rpx; border:1rpx solid #c8dbf3; border-radius:20rpx; background:#fff; }
.summary-top,.failure-head,.advanced-head,.card-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.summary-title,.card-title { display:block; color:#10294b; font-size:26rpx; font-weight:900; }
.summary-subtitle,.helper { display:block; margin-top:4rpx; color:#61799a; font-size:17rpx; line-height:1.35; }
.summary-status,.card-state { padding:6rpx 10rpx; border-radius:999rpx; background:#e5f8f1; color:#07875c; font-size:16rpx; font-weight:900; white-space:nowrap; }
.summary-status.pending,.card-state.pending { background:#fff2db; color:#aa6300; }
.summary-stats { display:grid; grid-template-columns:1fr 1fr; gap:10rpx; margin-top:16rpx; }
.summary-stats view { min-height:86rpx; padding:12rpx; display:flex; flex-direction:column; justify-content:space-between; border-radius:14rpx; background:#edf5ff; }
.summary-stats text:first-child { color:#61799a; font-size:16rpx; }
.summary-number { color:#10294b; font-size:28rpx; font-weight:900; }
.model-card.pending { border-color:#f0d3a4; }
.toggle-link { flex:0 0 auto; color:#2f73ee; font-size:18rpx; font-weight:900; }
.toggle-link text { font-size:24rpx; }
.main-body,.accordion-body,.advanced-body { margin-top:14rpx; padding:12rpx; border:1rpx dashed #9ec5f7; border-radius:16rpx; background:#f9fbff; }
.two-fields { display:grid; grid-template-columns:1fr 1fr; gap:9rpx; }
.field { min-width:0; margin-bottom:9rpx; padding:11rpx 12rpx; border:1rpx solid #c8dbf3; border-radius:13rpx; background:#fff; }
.field:last-child { margin-bottom:0; }
.field.center { text-align:center; }
.field-label { display:block; margin-bottom:5rpx; color:#61799a; font-size:16rpx; line-height:1.1; font-weight:800; }
.picker-value { min-width:0; overflow:hidden; color:#10294b; font-size:19rpx; font-weight:900; line-height:44rpx; text-overflow:ellipsis; white-space:nowrap; }
.picker-value text { float:right; color:#2f73ee; font-size:23rpx; }
.field-value { display:block; min-width:0; overflow:hidden; color:#10294b; font-size:19rpx; font-weight:900; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.field-value.multiline { white-space:normal; }
.wrap-field .field-value,.key-field .field-value { overflow:visible; overflow-wrap:anywhere; text-overflow:clip; white-space:normal; word-break:break-all; }
.key-field { border-color:#89ddb9; background:#f0fbf7; }
.failure-card { background:#fff; }
.accordion-head { min-height:78rpx; margin-top:12rpx; padding:12rpx 14rpx; display:grid; grid-template-columns:minmax(0,1fr) auto auto; align-items:center; gap:8rpx; border:1rpx solid #a9cbf8; border-radius:15rpx; background:#f2f7ff; }
.accordion-title { display:block; color:#10294b; font-size:22rpx; font-weight:900; }
.accordion-subtitle { display:block; margin-top:4rpx; color:#61799a; font-size:15rpx; }
.backup-status { color:#078a5d; font-size:16rpx; font-weight:900; white-space:nowrap; }
.backup-status.off { color:#75879c; }
.chev { color:#2f73ee; font-size:24rpx; font-weight:900; }
.backup-line { min-height:54rpx; display:flex; align-items:center; justify-content:space-between; color:#10294b; font-size:18rpx; }
.advanced-card { margin-bottom:14rpx; }
.advanced-head { min-height:54rpx; }
.input-unit { display:flex; align-items:center; gap:8rpx; }
.input-unit input { flex:1; width:0; height:46rpx; padding:0 8rpx; border:1rpx solid #c9dcf3; border-radius:9rpx; background:#fbfdff; color:#10294b; font-size:19rpx; font-weight:900; text-align:center; }
.input-unit text { color:#61799a; font-size:17rpx; }
.strategy-field .field-value { min-height:46rpx; display:flex; align-items:center; color:#10294b; font-size:17rpx; line-height:1.35; }
.message { margin-top:12rpx; padding:11rpx 14rpx; border-radius:12rpx; background:#e5f8f1; color:#07875c; font-size:17rpx; line-height:1.4; }
.save-btn { width:100%; height:76rpx; margin:14rpx 0 0; border-radius:15rpx; background:#2f73ee; color:#fff; font-size:24rpx; line-height:76rpx; font-weight:900; }
.bottom-space { height:64rpx; }
.tap { opacity:.78; }
@media (max-width:700rpx) {
  .config-scroll { padding-left:18rpx; padding-right:18rpx; }
  .tab text:nth-child(2) { font-size:16rpx; }
  .tab-status { font-size:14rpx; }
  .field-value,.picker-value { font-size:17rpx; }
}
