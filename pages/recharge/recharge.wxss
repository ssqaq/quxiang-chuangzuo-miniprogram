page {
  background: #f5f7fb;
  overflow-x: hidden;
}

.recharge-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 35.5rpx 26.63rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  color: #1d2433;
  background: #f5f7fb;
}

.skeleton {
  margin-bottom: 16rpx;
  border-radius: 28.85rpx;
  background: linear-gradient(100deg, #edf1f7 15%, #f8faff 38%, #edf1f7 62%);
  background-size: 300% 100%;
  animation: skeleton-shimmer 1.25s ease-in-out infinite;
}
.skeleton-balance { height: 110rpx; }
.skeleton-packages { height: 224rpx; }
.skeleton-channel { height: 113rpx; }
.skeleton-button { height: 98rpx; }
@keyframes skeleton-shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }

.recharge-balance {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 110rpx;
  padding: 26.63rpx 31.07rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 28.85rpx;
  color: #2c4d7b;
  background: #eaf3ff;
}
.expected-label { font-size: 9px; line-height: 14px; }
.expected-value { display: flex; align-items: baseline; color: #1f6feb; font-size: 17px; line-height: 24px; font-weight: 800; }
.expected-unit { margin-left: 5px; font-size: 8px; line-height: 12px; }

.mini-block-title {
  display: flex;
  margin: 35rpx 4.44rpx 24.05rpx;
  align-items: baseline;
  color: #2d3b54;
  font-size: 11px;
  line-height: 16px;
  font-weight: 800;
}
.payment-title-note { margin-left: 7px; color: #93a0b2; font-size: 7px; line-height: 11px; font-weight: 400; }

.package-grid {
  display: flex;
  width: 100%;
  height: 224.12rpx;
  gap: 13.31rpx;
}
.package-hit {
  display: flex;
  width: 0;
  min-width: 0;
  height: 224.12rpx;
  flex: 1 1 0;
}
.package-card {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 224.12rpx;
  padding: 22.19rpx 8.88rpx 17.75rpx;
  align-items: center;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #dfe6ef;
  border-radius: 28.85rpx;
  background: #ffffff;
}
.package-card-selected {
  border-color: #1f6feb;
  background: #f5f9ff;
  box-shadow: 0 0 0 2px rgba(31, 111, 235, .1);
}
.package-tag {
  position: absolute;
  top: -1px;
  right: -1px;
  padding: 2px 5px;
  border-radius: 0 12px 0 7px;
  color: #ffffff;
  background: #1f6feb;
  font-size: 6px;
  line-height: 9px;
}
.package-points { color: #1f6feb; font-size: 21px; line-height: 30px; font-weight: 800; }
.package-unit { color: #8290a4; font-size: 7px; line-height: 10px; }
.package-price { margin-top: 8px; color: #26334a; font-size: 11px; line-height: 16px; font-weight: 800; }
.package-extra { margin-top: 3px; overflow: hidden; color: #d87d32; font-size: 7px; line-height: 10px; text-overflow: ellipsis; white-space: nowrap; }

.channel-list { width: 100%; }
.channel-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 113.16rpx;
  padding: 19.97rpx 22.19rpx;
  align-items: center;
  border: 1px solid #e0e7f0;
  border-radius: 26.63rpx;
  background: #ffffff;
}
.channel-row-selected { border-color: #8fb9f4; background: #f7faff; }
.channel-row-disabled { color: #69778a; background: #f2f4f7; }
.channel-icon { display: flex; width: 68.79rpx; height: 68.79rpx; flex: none; align-items: center; justify-content: center; border-radius: 19.97rpx; color: #ffffff; background: #16a56a; font-size: 9px; font-weight: 800; }
.channel-copy { min-width: 0; margin-left: 19.97rpx; flex: 1; }
.channel-title { overflow: hidden; color: #2d3b54; font-size: 10px; line-height: 15px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.channel-description { margin-top: 3px; overflow: hidden; color: #8b99aa; font-size: 7px; line-height: 11px; text-overflow: ellipsis; white-space: nowrap; }
.channel-check { display: flex; width: 35.5rpx; height: 35.5rpx; flex: none; align-items: center; justify-content: center; border: 1px solid #1f6feb; border-radius: 50%; color: #ffffff; background: #1f6feb; font-size: 8px; font-weight: 800; }
.channel-row-disabled .channel-check { border-color: #cbd4e0; color: #8492a6; background: #e5eaf1; }

.pay-hit {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 44px;
  min-height: 44px;
  margin: 16px 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  flex: 0 0 100%;
  border: 0;
  background: transparent;
  line-height: normal;
}
.pay-hit::after { display: none; border: 0; }
.pay-button {
  display: flex;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 38.5px;
  flex: 0 0 100%;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  color: #ffffff;
  background: #1f6feb;
  box-shadow: 0 9px 18px rgba(31, 111, 235, .22);
  font-size: 11px;
  line-height: 16px;
  font-weight: 800;
}
.pay-button-disabled { color: #eef2f7; background: #9ba9bb; box-shadow: none; }

.payment-note { display: flex; margin-top: 14px; align-items: flex-start; justify-content: center; color: #8c99aa; font-size: 7px; line-height: 11px; text-align: center; }
.payment-note-icon {
  position: relative;
  width: 13px;
  height: 11px;
  flex: none;
  margin: 2px 4px 0 0;
  box-sizing: border-box;
  border: 1px solid #7f91a9;
  border-radius: 2px;
}
.payment-note-icon::before {
  position: absolute;
  top: -6px;
  left: 2px;
  width: 7px;
  height: 7px;
  box-sizing: border-box;
  border: 1px solid #7f91a9;
  border-bottom: 0;
  border-radius: 5px 5px 0 0;
  content: "";
}

.state-panel,
.payment-status,
.empty-panel {
  box-sizing: border-box;
  width: 100%;
  border-radius: 22rpx;
}
.state-panel { display: flex; min-height: 118rpx; padding: 22rpx; align-items: center; }
.state-panel-error { color: #a93d3d; background: #fff0f0; }
.state-panel-disabled { margin-top: 16px; color: #627087; background: #edf1f6; }
.state-icon { display: flex; width: 58rpx; height: 58rpx; flex: none; align-items: center; justify-content: center; border-radius: 18rpx; background: rgba(255,255,255,.7); font-size: 12px; font-weight: 800; }
.state-copy { min-width: 0; margin-left: 16rpx; flex: 1; }
.state-title { font-size: 12px; line-height: 18px; font-weight: 800; }
.state-description { margin-top: 3px; font-size: 9px; line-height: 14px; opacity: .82; }
.state-action { width: 58px; height: 44px; min-height: 44px; margin-left: 10px; padding: 0; border-radius: 10px; color: #a93d3d; background: #ffffff; font-size: 10px; line-height: 44px; }

.empty-panel { min-height: 120px; padding: 34px 16px; text-align: center; background: #ffffff; }
.empty-title { color: #46546a; font-size: 12px; line-height: 18px; font-weight: 800; }
.empty-description { margin-top: 5px; color: #929eae; font-size: 9px; line-height: 14px; }

.payment-status { display: flex; min-height: 78px; margin-top: 10px; padding: 12px; align-items: center; color: #315d99; background: #edf4ff; }
.payment-status-success { color: #19764c; background: #e9f8f0; }
.payment-status-failed { color: #ad4242; background: #fff0f0; }
.payment-status-canceled { color: #7a6640; background: #fff8e8; }
.payment-status-icon { display: flex; width: 31px; height: 31px; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.78); font-size: 12px; font-weight: 900; }
.payment-status-copy { min-width: 0; margin-left: 9px; flex: 1; }
.payment-status-title { font-size: 11px; line-height: 16px; font-weight: 800; }
.payment-status-description { margin-top: 3px; font-size: 8px; line-height: 12px; opacity: .82; }
.payment-status-balance { margin-top: 4px; font-size: 9px; font-weight: 800; }
.records-link { width: 52px; height: 44px; min-height: 44px; margin-left: 8px; padding: 0; border-radius: 9px; color: #19764c; background: #ffffff; font-size: 9px; line-height: 44px; }

@media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
