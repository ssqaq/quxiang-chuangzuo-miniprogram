<view class="media-parser-page">
  <view class="media-parser-topline"></view>

  <view class="media-parser-hero">
    <view class="hero-kicker">媒体解析 · 文案提取</view>
    <view class="media-parser-heading">一个链接，媒体文案全提取</view>
    <view class="media-parser-subheading">粘贴平台分享链接，同时获取高清媒体和作品原始文案。</view>
  </view>

  <view class="input-card">
    <view class="input-card-heading">
      <view class="section-label">粘贴分享链接或分享文本</view>
      <button class="paste-button" bindtap="pasteFromClipboard">一键粘贴</button>
    </view>
    <textarea
      class="media-input"
      value="{{inputText}}"
      bindinput="onInput"
      maxlength="4096"
      placeholder="粘贴包含 http 或 https 链接的分享文本"
      placeholder-class="media-input-placeholder"
      auto-height
    ></textarea>
    <view class="input-footer">
      <view class="privacy-note">
        <text class="privacy-check">✓</text>
        <text>不会保存原始分享文本</text>
      </view>
      <text>{{inputText.length}} / 4096</text>
    </view>

    <view class="feature-row">
      <view class="feature-option">
        <view class="feature-icon feature-icon-media">
          <view class="media-play-icon"></view>
        </view>
        <view class="feature-copy">
          <view class="feature-title">解析高清媒体</view>
          <view class="feature-subtitle">视频 / 图片 / 实况</view>
        </view>
        <view class="feature-check">✓</view>
      </view>
      <view class="feature-option">
        <view class="feature-icon feature-icon-copy">
          <view class="copy-lines-icon">
            <view class="copy-line"></view>
            <view class="copy-line"></view>
            <view class="copy-line copy-line-short"></view>
          </view>
        </view>
        <view class="feature-copy">
          <view class="feature-title">提取作品文案</view>
          <view class="feature-subtitle">标题 / 正文 / 标签</view>
        </view>
        <view class="feature-check">✓</view>
      </view>
    </view>
  </view>

  <button
    class="primary-btn parse-button"
    bindtap="parseMedia"
    loading="{{parsing}}"
    disabled="{{parsing}}"
  >
    {{parsing ? '正在解析并提取...' : '一键解析并提取'}}
    <text wx:if="{{!parsing}}" class="button-arrow">→</text>
  </button>

  <view wx:if="{{status === 'idle'}}" class="page-note">
    <text class="note-dot"></text>
    <text>自动识别链接</text>
    <text class="note-divider">·</text>
    <text>媒体与文案一次完成</text>
  </view>

  <view wx:if="{{status === 'parsing'}}" class="state-card state-loading">
    <view class="state-loading-head">
      <view class="state-spinner"></view>
      <view>
        <view class="state-title">{{retrying ? '连接不稳，正在重试' : '正在整理你的内容'}}</view>
        <view class="state-text">{{retrying ? '第一次请求没有完成，正在自动再试一次。' : '识别链接、提取媒体并同步整理作品文案。'}}</view>
      </view>
    </view>
    <view class="stage-list">
      <view class="stage-item {{parseStage === 0 ? 'is-current' : 'is-done'}}">
        <view class="stage-node">{{parseStage === 0 ? '1' : '✓'}}</view>
        <text>识别分享链接</text>
      </view>
      <view class="stage-item {{parseStage > 1 ? 'is-done' : (parseStage === 1 ? 'is-current' : '')}}">
        <view class="stage-node">{{parseStage > 1 ? '✓' : '2'}}</view>
        <text>提取高清媒体</text>
      </view>
      <view class="stage-item {{parseStage > 2 ? 'is-done' : (parseStage === 2 ? 'is-current' : '')}}">
        <view class="stage-node">{{parseStage > 2 ? '✓' : '3'}}</view>
        <text>整理作品文案</text>
      </view>
    </view>
  </view>

  <view wx:if="{{status === 'error'}}" class="state-card state-error">
    <view class="state-icon">×</view>
    <view class="state-content">
      <view class="state-title">{{errorTitle}}</view>
      <view class="state-text">{{errorMessage}}</view>
      <button class="text-button" bindtap="resetResult">清空后重试</button>
    </view>
  </view>

  <view wx:if="{{result}}" class="result-card">
    <view class="result-head">
      <view class="result-heading-copy">
        <view class="result-kicker">解析与提取完成</view>
        <view class="result-title">{{result.title}}</view>
      </view>
      <view wx:if="{{result.demo}}" class="result-badge result-badge-demo">演示数据</view>
      <view wx:else class="result-badge result-badge-real">真实结果</view>
    </view>

    <view class="result-meta">
      <text class="result-type-chip">{{result.typeLabel}}</text>
      <text class="result-platform">{{result.platformLabel}}</text>
      <text wx:if="{{result.author}}" class="result-author">· {{result.author}}</text>
    </view>

    <video
      wx:if="{{result.contentType === 'video'}}"
      class="result-video"
      src="{{result.mediaUrl}}"
      poster="{{result.coverUrl}}"
      controls
      show-center-play-btn
      object-fit="contain"
    ></video>

    <view wx:elif="{{result.contentType === 'image' && result.mediaCount > 1}}" class="media-grid">
      <block wx:for="{{result.mediaItems}}" wx:key="url">
        <image class="media-grid-image" src="{{item.url}}" mode="aspectFill"></image>
      </block>
    </view>

    <image
      wx:elif="{{result.contentType === 'image'}}"
      class="result-image"
      src="{{result.mediaUrl}}"
      mode="aspectFit"
    ></image>

    <view wx:elif="{{result.contentType === 'live_photo'}}" class="live-photo-grid">
      <block wx:for="{{result.livePhotoItems}}" wx:key="imageUrl">
        <view class="live-photo-item">
          <image class="media-grid-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <text class="live-photo-label">第{{index + 1}}组</text>
        </view>
      </block>
    </view>

    <view wx:if="{{result.demo}}" class="result-hint">当前云函数显式启用了 Mock，这不是平台真实解析结果。</view>
    <view wx:elif="{{result.contentType === 'live_photo'}}" class="result-hint">已取到实况的静态图片和动态视频；当前会分别保存。</view>
    <view wx:elif="{{result.contentType === 'image' && result.mediaCount > 1}}" class="result-hint">共 {{result.mediaCount}} 张图片，保存按钮会一次处理全部媒体。</view>
    <view wx:else class="result-hint">媒体文件和作品文案已经整理好，可以分别复制或保存。</view>

    <view class="copywriting-card">
      <view class="copywriting-head">
        <view>
          <view class="copywriting-kicker">作品文案</view>
          <view class="copywriting-title">已提取文本</view>
        </view>
        <button
          class="copy-button{{copiedTarget === 'all' ? ' copy-feedback-active' : ''}}"
          bindtap="copyCopywriting"
        >{{copiedTarget === 'all' ? '已复制' : '复制文案'}}</button>
      </view>
      <view class="copywriting-section">
        <view class="copywriting-section-head">
          <view class="copywriting-label">标题</view>
          <button
            wx:if="{{result.copywritingTitle}}"
            class="copywriting-action{{copiedTarget === 'title' ? ' copy-feedback-active' : ''}}"
            bindtap="copyCopywritingTitle"
          >{{copiedTarget === 'title' ? '已复制' : '复制标题'}}</button>
        </view>
        <view wx:if="{{result.copywritingTitle}}" class="copywriting-body copywriting-title-body">{{result.copywritingTitle}}</view>
        <view wx:else class="copywriting-empty">未提取到标题。</view>
      </view>
      <view class="copywriting-section">
        <view class="copywriting-section-head">
          <view class="copywriting-label">正文</view>
          <view wx:if="{{result.copywritingBody}}" class="copywriting-actions">
            <button
              class="copywriting-action{{copiedTarget === 'body' ? ' copy-feedback-active' : ''}}"
              bindtap="copyCopywritingBody"
            >{{copiedTarget === 'body' ? '已复制' : '复制正文'}}</button>
            <button
              wx:if="{{result.copywritingBodyCollapsible}}"
              class="copywriting-action copywriting-toggle"
              bindtap="toggleCopywritingExpanded"
            >{{copywritingExpanded ? '收起' : '展开'}}</button>
          </view>
        </view>
        <view wx:if="{{result.copywritingBody}}" class="copywriting-body-shell">
          <view
            class="copywriting-body copywriting-body-in-shell{{result.copywritingBodyCollapsible && !copywritingExpanded ? ' copywriting-body-collapsed' : ''}}"
          >{{result.copywritingBody}}</view>
          <view
            wx:if="{{result.copywritingBodyCollapsible && !copywritingExpanded}}"
            class="copywriting-fade"
            bindtap="toggleCopywritingExpanded"
          >
            <text>展开查看全部</text>
          </view>
        </view>
        <view wx:else class="copywriting-empty">服务商暂未返回正文文案。</view>
      </view>
      <view class="copywriting-section">
        <view class="copywriting-section-head">
          <view class="copywriting-label">标签</view>
          <button
            wx:if="{{result.copywritingTags.length}}"
            class="copywriting-action{{copiedTarget === 'tags' ? ' copy-feedback-active' : ''}}"
            bindtap="copyCopywritingTags"
          >{{copiedTarget === 'tags' ? '已复制' : '复制标签'}}</button>
        </view>
        <view wx:if="{{result.copywritingTags.length}}" class="copywriting-tag-box">
          <text wx:for="{{result.copywritingTags}}" wx:key="*this" class="copywriting-tag-chip">#{{item}}</text>
        </view>
        <view wx:else class="copywriting-empty">暂未提取到标签。</view>
      </view>
      <view class="copywriting-footer">
        <text>{{result.copywritingLength || 0}} 字</text>
        <text>可分区复制，也可一键复制全文</text>
      </view>
    </view>

    <button
      class="primary-btn save-button"
      bindtap="saveMedia"
      loading="{{saving}}"
      disabled="{{saving}}"
    >
      {{saving ? '保存中...' : (result.contentType === 'live_photo' ? '保存图片和动态视频' : (result.contentType === 'image' && result.mediaCount > 1 ? '保存全部媒体' : '保存媒体'))}}
    </button>
    <button class="secondary-btn reset-button" bindtap="resetResult">重新解析</button>
  </view>

  <view class="bottom-link" bindtap="backToWorkbench">返回工作台</view>
</view>
