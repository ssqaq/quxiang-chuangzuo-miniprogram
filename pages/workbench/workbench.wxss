}

.diagnostic-toggle-summary {
  display: flex;
  flex: none;
  align-items: flex-end;
  flex-direction: column;
  gap: 6rpx;
  margin-left: 12rpx;
}

.diagnostic-toggle-indicator {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #6d82aa;
  font-size: 19rpx;
  line-height: 26rpx;
}

.diagnostic-toggle-arrow {
  display: inline-block;
  font-size: 25rpx;
  line-height: 22rpx;
  transform: translateY(-2rpx);
  transition: transform 160ms ease;
}

.diagnostic-toggle-arrow-expanded {
