<view class="points-page">
  <view class="points-hero card">
    <view class="points-hero-head">
      <view>
        <view class="points-kicker">POINTS CENTER</view>
        <view class="points-title">{{pointsCopy.pointsTitle}}</view>
        <view class="points-subtitle">{{points.boundMessage}}</view>
      </view>
      <view class="points-balance">
        <text class="points-balance-number">{{points.pointsBalance}}</text>
        <text class="points-balance-label">当前积分</text>
      </view>
    </view>
    <view wx:if="{{points.promoActive}}" class="points-promo">
      {{pointsCopy.pointsPromo}}
    </view>
  </view>

  <view class="card streak-card">
    <view class="streak-head">
      <view>
        <view class="section-title">{{pointsCopy.pointsSectionTitle}}</view>
        <view class="section-subtitle">连续满 {{points.streakDays}} 天，额外奖励 {{points.streakBonus}} 积分</view>
      </view>
      <view class="streak-count">
        <text>{{points.currentStreak}}</text>
        <text>天</text>
      </view>
    </view>
    <view class="streak-progress-track">
      <view
        class="streak-progress-fill"
        style="width: {{(points.progress / points.streakDays) * 100}}%;"
      ></view>
    </view>
    <view class="streak-progress-foot">
      <text>本轮已连续 {{points.progress}} 天</text>
      <text>目标 {{points.streakDays}} 天</text>
    </view>
    <button
      class="primary-btn checkin-button"
      bindtap="checkIn"
      loading="{{checkingIn}}"
      disabled="{{checkingIn || points.checkedInToday}}"
    >
      {{points.checkedInToday ? pointsCopy.checkedIn : (points.accountBound ? pointsCopy.checkInWithRewardPrefix + points.nextCheckinReward + pointsCopy.checkInWithRewardSuffix : pointsCopy.bindAndCheckIn)}}
    </button>
    <view class="checkin-hint">
      {{pointsCopy.checkInHintPrefix}} {{points.checkinPoints}} {{pointsCopy.checkInHintSuffix}}
    </view>
  </view>

  <view class="card usage-card">
    <view class="section-title">使用说明</view>
    <view class="usage-grid">
      <view class="usage-item">
        <text class="usage-label">今日免费</text>
        <text class="usage-value">{{points.freeRemaining}} / {{points.freeLimit}}</text>
      </view>
      <view class="usage-item">
        <text class="usage-label">生图扣除</text>
        <text class="usage-value">{{points.imageCost}} 积分</text>
      </view>
      <view class="usage-item">
        <text class="usage-label">视频扣除</text>
        <text class="usage-value">{{points.videoCost}} 积分</text>
      </view>
    </view>
    <view class="usage-note">每日免费次数用完后，提交时会提示并自动从积分中扣除。</view>
  </view>

  <view class="card ledger-card">
    <view class="ledger-head">
      <view class="section-title">积分明细</view>
      <text class="ledger-total">累计获得 {{points.totalEarned}}</text>
    </view>
    <view wx:if="{{!ledger.length}}" class="empty-ledger">还没有积分记录，今天先签到吧。</view>
    <view wx:for="{{ledger}}" wx:key="id" class="ledger-row">
      <view class="ledger-copy">
        <view class="ledger-description">{{item.description}}</view>
        <view class="ledger-time">{{item.createdAt}}</view>
      </view>
      <text class="ledger-amount {{item.amountClass}}">{{item.amountText}}</text>
    </view>
  </view>

  <button class="plain-btn back-button" bindtap="backToWorkbench">返回工作台</button>
</view>
