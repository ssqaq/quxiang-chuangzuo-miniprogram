              <view class="usage-type-icon">{{item.icon}}</view>
              <view class="usage-type-title">{{item.title}}</view>
            </view>
            <view class="usage-type-total">{{item.total}}</view>
            <view class="usage-type-label">总调用次数</view>
            <view class="usage-type-result">
              <text>成功 {{item.success}}</text>
              <text>失败 {{item.failure}}</text>
            </view>
            <view class="usage-model-text">{{item.modelText}}</view>
          </view>
        </view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-failure-panel">
          <view class="usage-subsection-title usage-failure-heading">失败情况</view>
          <view class="usage-failure-summary">
            <view class="usage-failure-summary-item">
              <text>失败次数</text>
              <text>{{usageStats.failureStats.total}}</text>
            </view>
