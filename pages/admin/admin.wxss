  align-items: center;
  margin-top: 20rpx;
  color: #405069;
  font-size: 23rpx;
}

.admin-checkbox-row checkbox {
  margin-right: 10rpx;
}

.admin-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}

.admin-actions button {
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 76rpx;
}

.admin-action-button {
  display: flex;
  height: 76rpx;
  min-width: 0;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.control-tap {
  opacity: 0.82;
}

.admin-save-button {
  color: #ffffff !important;
  background: #1f6feb !important;
}

.admin-check-button {
  color: #1f6feb !important;
  background: #e8f1ff !important;
}

.deployment-card {
  margin-top: 0;
}

.auto-face-probe-card {
  margin-top: 0;
}

.model-probe-card {
  margin-top: 0;
}

.model-probe-list {
  margin-top: 16rpx;
}

.model-probe-row {
  display: flex;
  padding: 18rpx 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.model-probe-row:last-child {
  border-bottom: 0;
}

.model-probe-main {
  min-width: 0;
  flex: 1;
}

.model-probe-title {
  color: #1d2a3e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.model-probe-meta,
.model-probe-message {
  margin-top: 5rpx;
  overflow: hidden;
  color: #718096;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
}

.model-probe-meta {
  white-space: nowrap;
}

.model-probe-message {
  white-space: normal;
}

.model-probe-side {
  display: flex;
  flex: none;
  min-width: 112rpx;
  align-items: flex-end;
  flex-direction: column;
  gap: 6rpx;
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.auto-face-probe-history-card {
  margin-top: 0;
}

.auto-face-probe-history-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.auto-face-probe-history-row:last-child {
  border-bottom: 0;
}

.auto-face-probe-history-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.auto-face-probe-history-top view {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.auto-face-probe-history-time {
  color: #7a879a;
  font-size: 19rpx;
}

.auto-face-probe-history-duration {
  flex: none;
  color: #2f659d;
  font-size: 20rpx;
  font-weight: 700;
}

.auto-face-probe-history-meta,
.auto-face-probe-history-error {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-face-probe-history-error {
  color: #b36d18;
}

.deployment-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.deployment-grid view {
  min-width: 0;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.deployment-grid text {
  display: block;
  overflow: hidden;
  color: #7d899b;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deployment-grid text + text {
  margin-top: 4rpx;
  color: #26354b;
  font-size: 22rpx;
}

.admin-log-count {
  color: #7b8ba1;
  font-size: 21rpx;
}

.admin-empty {
  padding: 22rpx 0 4rpx;
  color: #8390a3;
  font-size: 22rpx;
}

.admin-log-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.admin-log-item:last-child {
  border-bottom: 0;
}

.admin-log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334258;
  font-size: 22rpx;
}

.admin-log-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-ok {
  color: #23834b;
}

.log-warn {
  color: #b36d18;
}

@media (max-width: 360px) {
  .admin-grid,
  .deployment-grid {
    grid-template-columns: 1fr;
  }

  .admin-field-wide {
    grid-column: auto;
  }

  .admin-actions {
    flex-direction: column;
  }

  .usage-summary-grid,
  .usage-type-grid,
  .usage-cost-summary,
  .usage-failure-summary,
  .auto-face-failure-summary {
    grid-template-columns: 1fr;
  }

  .usage-toolbar {
    width: 100%;
    margin-top: 10rpx;
  }

  .usage-refresh-button {
    flex: 1;
    width: auto;
    font-size: 18rpx;
  }

  .usage-export-button {
    flex: 1;
    width: auto;
    font-size: 18rpx;
  }

  .user-stats-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .user-stats-actions {
    width: 100%;
  }

  .user-stats-d-action {
    flex: 1;
    width: auto;
  }

  .user-stats-d-overview {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }

  .user-stats-d-donut {
    width: 148rpx;
    height: 148rpx;
  }
}
