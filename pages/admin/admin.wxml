<view class="admin-page">
  <view class="console-header">
    <view class="console-back" bindtap="backToWorkbench" hover-class="control-tap" role="button" aria-label="返回工作台">‹</view>
    <view class="console-heading">
      <view class="console-title">控制台</view>
      <view class="console-subtitle">模型、积分与成本配置</view>
    </view>
    <view class="admin-access-badge">{{isAdmin ? '管理员' : '未授权'}}</view>
  </view>

  <view wx:if="{{loading}}" class="card admin-state-card admin-loading-card">
    <view class="admin-loading-title">正在读取管理员配置...</view>
    <view class="admin-loading-skeleton admin-loading-skeleton-title"></view>
    <view class="admin-loading-skeleton-grid">
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
      <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
    </view>
    <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
    <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
    <view wx:if="{{canRetry}}" class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && !isAdmin && canRetry}}" class="card admin-state-card">
    <view>{{message || '管理员页面暂时无法打开。'}}</view>
    <view class="admin-retry-button" bindtap="loadAdminPage">重新读取</view>
  </view>

  <view wx:if="{{!loading && isAdmin}}" class="admin-content">
    <view wx:if="{{message}}" class="admin-message">{{message}}</view>

    <view class="status-console status-{{dashboardStatus.tone}}">
      <view class="status-console-top">
        <view>
          <view class="status-console-label">线上运行状态</view>
          <view class="status-console-title">{{dashboardStatus.title}}</view>
        </view>
        <view class="status-console-dot"></view>
      </view>
      <view class="status-console-meta">
        <text>v{{appVersion}}</text>
        <text>探针 {{dashboardStatus.probeDurationText}}</text>
        <text>今日 {{todayFailureText}}</text>
      </view>
      <view class="status-console-actions">
        <view
          class="status-check-button {{checking ? 'is-disabled' : ''}}"
          bindtap="checkDeployment"
          hover-class="control-tap"
          role="button"
          aria-label="立即检查线上部署"
        >
          {{checking ? '正在检查' : '检查线上部署'}}
        </view>
        <view
          class="status-check-button status-refresh-button {{refreshingAll ? 'is-disabled' : ''}}"
          bindtap="refreshAll"
          hover-class="control-tap"
          role="button"
          aria-label="一键刷新全部"
        >
          {{refreshingAll ? '正在刷新' : '一键刷新全部'}}
        </view>
        <view
          class="status-check-button status-probe-button {{modelProbing ? 'is-disabled' : ''}}"
          bindtap="probeModels"
          hover-class="control-tap"
          role="button"
          aria-label="探测四套模型接口"
        >
          {{modelProbing ? '正在探测' : '探测四套模型'}}
        </view>
      </view>
    </view>

    <view class="quick-launch-grid">
      <view
        class="quick-launch quick-face {{activeConfigSection === 'face' ? 'is-active' : ''}} {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开人脸识别模型配置"
      >
        <view class="quick-launch-icon">脸</view>
        <view class="quick-launch-name">人脸</view>
        <view class="quick-launch-state">{{entryHealth.face.label}}</view>
      </view>
      <view
        class="quick-launch quick-analysis {{activeConfigSection === 'analysis' ? 'is-active' : ''}} {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开图片分析模型配置"
      >
        <view class="quick-launch-icon">图</view>
        <view class="quick-launch-name">图片</view>
        <view class="quick-launch-state">{{entryHealth.analysis.label}}</view>
      </view>
      <view
        class="quick-launch quick-image {{activeConfigSection === 'image' ? 'is-active' : ''}} {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开生图模型配置"
      >
        <view class="quick-launch-icon">生</view>
        <view class="quick-launch-name">生图</view>
        <view class="quick-launch-state">{{entryHealth.image.label}}</view>
      </view>
      <view
        class="quick-launch quick-video {{activeConfigSection === 'video' ? 'is-active' : ''}} {{entryHealth.video.abnormal ? 'is-abnormal' : ''}}"
        data-section="video"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开视频模型配置"
      >
        <view class="quick-launch-icon">视</view>
        <view class="quick-launch-name">视频</view>
        <view class="quick-launch-state">{{entryHealth.video.label}}</view>
      </view>
      <view
        class="quick-launch quick-usage {{usageExpanded ? 'is-active' : ''}} {{entryHealth.usage.abnormal ? 'is-abnormal' : ''}}"
        bindtap="jumpToUsageSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型用量统计"
      >
        <view class="quick-launch-icon">量</view>
        <view class="quick-launch-name">用量</view>
        <view class="quick-launch-state">{{entryHealth.usage.label}}</view>
      </view>
      <view
        class="quick-launch quick-points {{activeConfigSection === 'points' ? 'is-active' : ''}} {{entryHealth.points.abnormal ? 'is-abnormal' : ''}}"
        data-section="points"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开积分规则配置"
      >
        <view class="quick-launch-icon">积</view>
        <view class="quick-launch-name">积分</view>
        <view class="quick-launch-state">{{entryHealth.points.label}}</view>
      </view>
      <view
        class="quick-launch quick-costs {{activeConfigSection === 'costs' ? 'is-active' : ''}} {{entryHealth.costs.abnormal ? 'is-abnormal' : ''}}"
        data-section="costs"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开模型成本配置"
      >
        <view class="quick-launch-icon">¥</view>
        <view class="quick-launch-name">成本</view>
        <view class="quick-launch-state">{{entryHealth.costs.label}}</view>
      </view>
      <view
        class="quick-launch quick-users {{activeConfigSection === 'users' ? 'is-active' : ''}} {{entryHealth.users.abnormal ? 'is-abnormal' : ''}}"
        data-section="users"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="打开用户统计"
      >
        <view class="quick-launch-icon">人</view>
        <view class="quick-launch-name">用户</view>
        <view class="quick-launch-state">{{entryHealth.users.label}}</view>
      </view>
    </view>

    <view class="overview-section">
      <view class="overview-heading">当前配置</view>
      <view
        class="current-config-row {{entryHealth.face.abnormal ? 'is-abnormal' : ''}}"
        data-section="face"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看人脸识别模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">人脸识别模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.face}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{faceConfigSummary.ready ? 'is-ready' : 'is-off'}}">
            {{faceConfigSummary.ready ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view
        class="current-config-row {{entryHealth.analysis.abnormal ? 'is-abnormal' : ''}}"
        data-section="analysis"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看图片分析模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">图片分析模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.analysis}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{entryHealth.analysis.abnormal ? 'is-off' : 'is-ready'}}">
            {{entryHealth.analysis.label}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view
        class="current-config-row {{entryHealth.image.abnormal ? 'is-abnormal' : ''}}"
        data-section="image"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看生图模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">生图模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.image}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{effective.image.apiKeyConfigured ? 'is-ready' : 'is-off'}}">
            {{effective.image.apiKeyConfigured ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
      <view
        class="current-config-row {{entryHealth.video.abnormal ? 'is-abnormal' : ''}}"
        data-section="video"
        bindtap="toggleConfigSection"
        hover-class="control-tap"
        role="button"
        aria-label="查看视频模型配置"
      >
          <view class="current-config-main">
            <view class="current-config-title">视频模型</view>
            <view class="current-config-meta">
              {{currentConfigModels.video}}
            </view>
        </view>
        <view class="current-config-side">
          <view class="config-state {{effective.video.apiKeyConfigured ? 'is-ready' : 'is-off'}}">
            {{effective.video.apiKeyConfigured ? '正常' : '未就绪'}}
          </view>
          <text class="current-config-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="overview-section today-section">
      <view class="overview-heading">今天</view>
      <view class="today-grid">
        <view class="today-item">
          <text class="today-value">{{usageStats.today.total}}</text>
          <text class="today-label">调用</text>
        </view>
        <view class="today-item">
          <text class="today-value {{usageStats.today.failure ? 'is-warn' : ''}}">{{usageStats.today.failure}}</text>
          <text class="today-label">失败</text>
        </view>
        <view class="today-item">
          <text class="today-value">¥{{usageStats.today.estimatedCostDisplay}}</text>
          <text class="today-label">预计成本</text>
        </view>
      </view>
    </view>

    <view id="usage-section" class="card admin-section usage-section monitor-fold-card {{usageExpanded ? 'is-open' : 'is-collapsed'}}">
      <view class="admin-section-head">
        <view>
          <view class="admin-section-title">模型用量统计</view>
          <view class="admin-section-help">按北京时间统计调用次数、Token、视频秒数和预计成本。最近更新 {{moduleStates.usage.updatedAtText}}</view>
        </view>
        <view class="usage-toolbar">
          <view class="usage-primary-actions">
            <button class="usage-refresh-button" bindtap="refreshModelUsage" loading="{{usageLoading}}" disabled="{{usageLoading}}">
              {{usageLoading ? '刷新中' : '刷新统计'}}
            </button>
            <button class="usage-export-button" bindtap="exportModelUsage" loading="{{usageExporting}}" disabled="{{usageExporting}}">
              {{usageExporting ? '生成中' : '导出 Excel'}}
            </button>
            <view class="admin-action-slot">
              <view
                class="monitor-section-toggle-button"
                data-usage-card="1"
                catchtap="toggleUsageCard"
                hover-class="control-tap"
                role="button"
                aria-label="{{usageExpanded ? '收起模型用量统计' : '展开模型用量统计'}}"
              >
                <text>{{usageExpanded ? '收起' : '展开'}}</text>
                <text class="monitor-section-chevron {{usageExpanded ? 'is-open' : ''}}">⌄</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{usageExpanded}}" class="monitor-fold-body usage-fold-body {{moduleStates.usage.status === 'loading' ? 'is-loading' : ''}}">
      <view wx:if="{{moduleStates.usage.status === 'loading'}}" class="usage-message">
        正在读取模型用量和成本...
      </view>
      <view wx:if="{{moduleStates.usage.status === 'loading'}}" class="module-loading-placeholder">
        <view class="admin-loading-skeleton admin-loading-skeleton-row"></view>
        <view class="admin-loading-skeleton-grid">
          <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
          <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
          <view class="admin-loading-skeleton admin-loading-skeleton-tile"></view>
        </view>
        <view class="admin-loading-skeleton admin-loading-skeleton-panel"></view>
      </view>
      <view wx:if="{{moduleStates.usage.status === 'failed'}}" class="usage-message is-warn">
        {{moduleStates.usage.message || '模型用量和成本读取失败，请点击刷新统计。'}}
      </view>
      <view wx:if="{{usageStats.message}}" class="usage-message {{usageStats.unavailable ? 'is-warn' : ''}}">
        {{usageStats.message}}
      </view>

      <view wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData)}}" class="usage-summary-grid">
        <view class="usage-summary-item">
          <text>今天</text>
          <text>{{usageStats.today.total}}</text>
          <text>成功 {{usageStats.today.success}} · 失败 {{usageStats.today.failure}}</text>
        </view>
        <view class="usage-summary-item">
          <text>最近7天</text>
          <text>{{usageStats.last7d.total}}</text>
          <text>成功 {{usageStats.last7d.success}} · 失败 {{usageStats.last7d.failure}}</text>
        </view>
        <view class="usage-summary-item">
          <text>最近30天</text>
          <text>{{usageStats.last30d.total}}</text>
          <text>成功 {{usageStats.last30d.success}} · 失败 {{usageStats.last30d.failure}}</text>
        </view>
      </view>

      <view wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData)}}" class="usage-cost-summary">
        <view class="usage-cost-item">
          <text>今日预计成本</text>
          <text>¥{{usageStats.today.estimatedCostDisplay}}</text>
          <text class="usage-cost-meta-line">已计算 {{usageStats.today.pricedCount}} 次，共 {{usageStats.today.pricedCostDisplay}} 元</text>
          <text class="usage-cost-meta-line">未计算 {{usageStats.today.unavailableCostCount}} 次</text>
        </view>
        <view class="usage-cost-item">
          <text>最近7天预计成本</text>
          <text>¥{{usageStats.last7d.estimatedCostDisplay}}</text>
          <text class="usage-cost-meta-line">Token {{usageStats.last7d.totalTokens}}</text>
          <text class="usage-cost-meta-line">视频 {{usageStats.last7d.videoDurationSeconds}} 秒</text>
        </view>
        <view class="usage-cost-item">
          <text>最近30天预计成本</text>
          <text>¥{{usageStats.last30d.estimatedCostDisplay}}</text>
          <text class="usage-cost-meta-line">Token {{usageStats.last30d.totalTokens}}</text>
          <text class="usage-cost-meta-line">视频 {{usageStats.last30d.videoDurationSeconds}} 秒</text>
        </view>
      </view>

      <view wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData)}}" class="usage-type-grid">
        <view wx:for="{{usageStats.cards}}" wx:key="key" class="usage-type-card usage-type-{{item.key}}">
          <view class="usage-type-top">
            <view class="usage-type-icon">{{item.icon}}</view>
            <view class="usage-type-title">{{item.title}}</view>
          </view>
          <view class="usage-type-total">{{item.total}}</view>
          <view class="usage-type-label">总调用次数</view>
          <view class="usage-type-result">
            <text>成功 {{item.success}}</text>
            <text>失败 {{item.failure}}</text>
          </view>
          <view class="usage-model-text">
            <text wx:for="{{item.modelLines}}" wx:key="*this" class="usage-model-line">{{item}}</text>
          </view>
        </view>
      </view>

      <view
        wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData)}}"
        class="usage-collapsed-statistics-card"
      >
        <view class="usage-subsection-head">
          <view class="usage-subsection-title">按模型名称分组</view>
          <view class="admin-action-slot">
            <view
              class="usage-subsection-toggle"
              data-usage-section="models"
              catchtap="toggleUsageSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{usageSections.models ? '收起按模型名称分组' : '展开按模型名称分组'}}"
            >
              <text>{{usageSections.models ? '收起' : '展开'}}</text>
              <text class="usage-subsection-chevron {{usageSections.models ? 'is-open' : ''}}">⌄</text>
            </view>
          </view>
        </view>
      <view
        wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData) && usageSections.models}}"
        class="usage-subsection-body"
      >
      <view wx:if="{{usageStats.models.length}}" class="usage-model-list">
        <view wx:for="{{usageStats.models}}" wx:key="model" class="usage-model-row">
          <view class="usage-model-top">
            <text>{{item.modelDisplay}}</text>
            <text>¥{{item.estimatedCostDisplay}} · {{item.total}} 次</text>
          </view>
          <view class="usage-user-detail">
            <text>{{item.usageType}}</text>
            <text>成功 {{item.success}}</text>
            <text>失败 {{item.failure}}</text>
            <text>Token {{item.totalTokens}}</text>
            <text>视频 {{item.videoDurationSeconds}} 秒</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!usageStats.models.length}}" class="admin-empty usage-empty">还没有按模型分组的数据。</view>
      </view>

        <view class="usage-subsection-head">
          <view class="usage-subsection-title">按用户统计</view>
          <view class="admin-action-slot">
            <view
              class="usage-subsection-toggle"
              data-usage-section="users"
              catchtap="toggleUsageSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{usageSections.users ? '收起按用户统计' : '展开按用户统计'}}"
            >
              <text>{{usageSections.users ? '收起' : '展开'}}</text>
              <text class="usage-subsection-chevron {{usageSections.users ? 'is-open' : ''}}">⌄</text>
            </view>
          </view>
        </view>
      <view
        wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData) && usageSections.users}}"
        class="usage-subsection-body"
      >
      <view wx:if="{{usageStats.users.length}}" class="usage-user-list">
        <view wx:for="{{usageStats.users}}" wx:key="userHash" class="usage-user-row">
          <view class="usage-user-top">
            <text>用户 {{item.userHash}}</text>
            <text>¥{{item.estimatedCostDisplay}} · {{item.total}} 次</text>
          </view>
          <view class="usage-user-detail">
            <text>图片 {{item.byType.analysis.total}}</text>
            <text>生图 {{item.byType.image.total}}</text>
            <text>人脸 {{item.byType.face.total}}</text>
            <text>视频 {{item.byType.video.total}}</text>
            <text>Token {{item.totalTokens}}</text>
            <text>视频 {{item.videoDurationSeconds}} 秒</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!usageStats.users.length}}" class="admin-empty usage-empty">还没有按用户统计的数据。</view>
      </view>

        <view class="usage-subsection-head">
          <view class="usage-subsection-title">按月份统计</view>
          <view class="admin-action-slot">
            <view
              class="usage-subsection-toggle"
              data-usage-section="monthly"
              catchtap="toggleUsageSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{usageSections.monthly ? '收起按月份统计' : '展开按月份统计'}}"
            >
              <text>{{usageSections.monthly ? '收起' : '展开'}}</text>
              <text class="usage-subsection-chevron {{usageSections.monthly ? 'is-open' : ''}}">⌄</text>
            </view>
          </view>
        </view>
      <view
        wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData) && usageSections.monthly}}"
        class="usage-subsection-body"
      >
      <scroll-view wx:if="{{usageStats.monthly.length}}" class="usage-monthly-list" scroll-y>
        <view wx:for="{{usageStats.monthly}}" wx:key="monthKey" class="usage-monthly-row">
          <view class="usage-daily-date">
            <text>{{item.monthKey}}</text>
            <text>预计 ¥{{item.estimatedCostDisplay}} · {{item.total}} 次</text>
          </view>
          <view class="usage-daily-values">
            <text>图片 ¥{{item.analysis.estimatedCostDisplay}}</text>
            <text>人脸 ¥{{item.face.estimatedCostDisplay}}</text>
            <text>生图 ¥{{item.image.estimatedCostDisplay}}</text>
            <text>视频 ¥{{item.video.estimatedCostDisplay}}</text>
          </view>
          <view class="usage-daily-result">Token {{item.totalTokens}} · 视频 {{item.videoDurationSeconds}} 秒</view>
        </view>
      </scroll-view>
      <view wx:if="{{!usageStats.monthly.length}}" class="admin-empty usage-empty">还没有月度统计数据。</view>
      </view>

        <view class="usage-subsection-head">
          <view class="usage-subsection-title usage-daily-title">最近{{usageStats.days}}天每日明细</view>
          <view class="admin-action-slot">
            <view
              class="usage-subsection-toggle"
              data-usage-section="daily"
              catchtap="toggleUsageSection"
              hover-class="control-tap"
              role="button"
              aria-label="{{usageSections.daily ? '收起每日明细' : '展开每日明细'}}"
            >
              <text>{{usageSections.daily ? '收起' : '展开'}}</text>
              <text class="usage-subsection-chevron {{usageSections.daily ? 'is-open' : ''}}">⌄</text>
            </view>
          </view>
        </view>
      <view
        wx:if="{{(moduleStates.usage.status === 'ready' || moduleStates.usage.hasData) && usageSections.daily}}"
        class="usage-subsection-body"
      >
      <scroll-view wx:if="{{usageStats.daily.length}}" class="usage-daily-list" scroll-y>
        <view wx:for="{{usageStats.daily}}" wx:key="dateKey" class="usage-daily-row">
          <view class="usage-daily-date">
            <text>{{item.dateLabel}}</text>
            <text>合计 {{item.total}} 次</text>
          </view>
          <view class="usage-daily-values">
            <text>图片 {{item.analysis.total}}</text>
