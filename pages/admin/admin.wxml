            <text>成功 {{usageStats.today.success}} · 失败 {{usageStats.today.failure}}</text>
          </view>
          <view class="usage-summary-item">
            <text>最近7天</text>
            <text>{{usageStats.last7d.total}}</text>
            <text>成功 {{usageStats.last7d.success}} · 失败 {{usageStats.last7d.failure}}</text>
          </view>
          <view class="usage-summary-item">
            <text>最近30天</text>
            <text>{{usageStats.last30d.total}}</text>
            <text>成功 {{usageStats.last30d.success}} · 失败 {{usageStats.last30d.failure}}</text>
          </view>
        </view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-cost-summary">
          <view class="usage-cost-item">
            <text>今日预计成本</text>
            <text>¥{{usageStats.today.estimatedCost}}</text>
            <text>已计算 {{usageStats.today.pricedCost}} 元 · 未计算 {{usageStats.today.unavailableCostCount}} 条</text>
          </view>
          <view class="usage-cost-item">
            <text>最近7天预计成本</text>
            <text>¥{{usageStats.last7d.estimatedCost}}</text>
            <text>Token {{usageStats.last7d.totalTokens}} · 视频 {{usageStats.last7d.videoDurationSeconds}} 秒</text>
          </view>
          <view class="usage-cost-item">
            <text>最近30天预计成本</text>
            <text>¥{{usageStats.last30d.estimatedCost}}</text>
            <text>Token {{usageStats.last30d.totalTokens}} · 视频 {{usageStats.last30d.videoDurationSeconds}} 秒</text>
          </view>
        </view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-type-grid">
