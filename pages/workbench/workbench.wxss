page {
  background: #f5f7fb;
}

.workbench-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  color: #1d2433;
  animation: workbench-page-enter 180ms ease-out both;
}

@keyframes workbench-page-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  border: 1rpx solid #e7ebf2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(31, 49, 79, 0.05);
}

.workbench-hero {
  position: relative;
  min-height: 284rpx;
  padding: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #eef5ff 0%, #ffffff 72%);
}

.workbench-brand-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.workbench-brand-icon {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 235, 0.12);
}

.workbench-brand-copy {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.workbench-title {
  color: #182132;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.workbench-subtitle {
  margin-top: 6rpx;
  color: #718096;
  font-size: 22rpx;
}

.status {
  display: flex;
  flex: none;
  align-items: center;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.status-ok {
  background: #eaf8ef;
  color: #23834b;
}

.status-offline {
  background: #fff5e8;
  color: #ae6b13;
}

.status-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.workbench-welcome {
  position: relative;
  z-index: 2;
  margin-top: 56rpx;
}

.welcome-title {
  color: #182132;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.welcome-subtitle {
  margin-top: 12rpx;
  color: #66738a;
  font-size: 25rpx;
}

.hero-orbit {
  position: absolute;
  z-index: 1;
  border-radius: 50%;
  pointer-events: none;
}

.hero-orbit-red {
  right: -50rpx;
  bottom: -86rpx;
  width: 228rpx;
  height: 228rpx;
  border: 9rpx solid rgba(255, 77, 85, 0.18);
}

.hero-orbit-blue {
  right: 32rpx;
  bottom: 26rpx;
  width: 36rpx;
  height: 36rpx;
  background: #1f6feb;
  box-shadow: 0 0 0 12rpx rgba(31, 111, 235, 0.08);
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 0;
}

.workbench-feature-stack {
  display: flex;
  margin-top: 16rpx;
  flex-direction: column;
}

.workbench-feature-stack .entry-grid,
.workbench-feature-stack .recent-card,
.workbench-feature-stack .publish-export-entry {
  margin-top: 16rpx;
}

.feature-group-heading {
  margin-bottom: 6rpx;
  padding: 0 4rpx;
}

.feature-group-title {
  display: flex;
  align-items: center;
  color: #26334a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.feature-group-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #1f6feb;
  box-shadow: 0 0 0 6rpx rgba(31, 111, 235, 0.1);
}

.feature-group-subtitle {
  margin-top: 6rpx;
  color: #7a879a;
  font-size: 22rpx;
  line-height: 32rpx;
}

.entry-card {
  position: relative;
  display: flex;
  width: calc(50% - 8rpx);
  min-height: 178rpx;
  padding: 22rpx;
  overflow: hidden;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid #e7ebf2;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(31, 49, 79, 0.04);
  transition: transform 0.08s ease, box-shadow 0.08s ease, opacity 0.08s ease;
}

.entry-card:active {
  opacity: 0.92;
  transform: scale(0.985);
  box-shadow: 0 6rpx 14rpx rgba(31, 49, 79, 0.08);
}

.entry-card-hover {
  opacity: 0.92;
  transform: scale(0.985);
  box-shadow: 0 6rpx 14rpx rgba(31, 49, 79, 0.08);
}

.entry-card-face {
  border-top: 6rpx solid #ff4d55;
}

.entry-card-wardrobe {
  border-top: 6rpx solid #7357d8;
}

.entry-card-pose {
  border-top: 6rpx solid #16a085;
}

.entry-card-custom {
  width: 100%;
  min-height: 148rpx;
  padding: 22rpx;
  align-items: center;
  flex-direction: row;
  justify-content: flex-start;
  border-top: 0;
  background: linear-gradient(135deg, #eef5ff 0%, #ffffff 76%);
}

.entry-card-custom .entry-mark {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  font-size: 42rpx;
}

.entry-card-custom .entry-copy {
  margin-top: 0;
  margin-left: 18rpx;
  padding-right: 26rpx;
}

.entry-card-custom .entry-title {
  font-size: 30rpx;
  line-height: 40rpx;
}

.entry-card-custom .entry-description {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.entry-card-custom .entry-arrow {
  color: #7c9ed5;
}

.entry-mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
