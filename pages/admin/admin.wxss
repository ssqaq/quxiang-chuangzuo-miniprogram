page {
  background: #f2f5fa;
}

.admin-page {
  min-height: 100vh;
  padding: 22rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  color: #152033;
}

.card {
  border: 1rpx solid #dce4ef;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(35, 55, 86, 0.06);
}

.console-header {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: 18rpx;
}

.console-back {
  display: flex;
  flex: none;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 0 5rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e3e9f2;
  border-radius: 20rpx;
  color: #25344b;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(27, 45, 73, 0.08);
  font-size: 44rpx;
  font-weight: 400;
  line-height: 60rpx;
}

.console-back::after,
.quick-launch::after,
.current-config-row::after,
.config-close-button::after,
.status-check-button::after,
.monitor-toggle::after {
  border: 0;
}

.console-heading {
  min-width: 0;
  flex: 1;
}

.console-title {
  color: #111d31;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.console-subtitle {
  margin-top: 2rpx;
  overflow: hidden;
  color: #7a879b;
  font-size: 20rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-console {
  margin-top: 24rpx;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 28rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 16%, rgba(86, 137, 214, 0.38), transparent 34%),
    linear-gradient(145deg, #1c2e4b 0%, #29476f 100%);
  box-shadow: 0 18rpx 42rpx rgba(25, 48, 82, 0.2);
}

.status-console-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.status-console-label {
  color: #b8c7da;
  font-size: 20rpx;
  line-height: 28rpx;
}

.status-console-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.status-console-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 7rpx;
  border: 6rpx solid rgba(101, 223, 161, 0.16);
  border-radius: 50%;
  background: #65dfa1;
  box-shadow: 0 0 0 8rpx rgba(101, 223, 161, 0.07);
}

.status-warn .status-console-dot {
  border-color: rgba(255, 193, 92, 0.18);
  background: #ffc15c;
  box-shadow: 0 0 0 8rpx rgba(255, 193, 92, 0.08);
}

.status-neutral .status-console-dot {
  border-color: rgba(166, 191, 226, 0.18);
  background: #a6bfe2;
  box-shadow: 0 0 0 8rpx rgba(166, 191, 226, 0.08);
}

.status-console-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 6rpx;
  color: #cbd7e6;
  font-size: 19rpx;
  line-height: 30rpx;
}

.status-console-meta text {
  position: relative;
}

.status-console-meta text + text {
  padding-left: 16rpx;
}

.status-console-meta text + text::before {
  position: absolute;
  top: 12rpx;
  left: 0;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #8298b6;
  content: "";
}

.status-check-button {
  display: flex;
  width: auto;
  height: 68rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 18rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.11);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.status-console-actions {
  display: flex;
  width: 100%;
  gap: 12rpx;
  margin-top: 22rpx;
}

.status-refresh-button {
  border-color: rgba(126, 205, 255, 0.32);
  background: rgba(71, 151, 218, 0.2);
}

.status-probe-button {
  border-color: rgba(132, 229, 190, 0.32);
  background: rgba(44, 165, 113, 0.18);
}

.status-check-button.is-disabled,
.admin-action-button.is-disabled {
  opacity: 0.7;
}

.status-check-button.is-disabled {
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.07);
}

.quick-launch-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.quick-launch {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 136rpx;
  margin: 0;
  padding: 14rpx 8rpx 12rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 22rpx;
  color: #26344a;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(36, 58, 91, 0.04);
  line-height: normal;
}

.quick-launch.is-active {
  border-color: #8fb2ed;
  box-shadow: 0 0 0 3rpx rgba(55, 105, 198, 0.1);
}

.quick-launch.is-abnormal {
  border-color: #e58d96;
  background: #fff6f7;
  box-shadow: 0 0 0 3rpx rgba(191, 58, 73, 0.08);
}

.quick-launch.is-abnormal .quick-launch-name,
.quick-launch.is-abnormal .quick-launch-state {
  color: #b33f4c;
}

.quick-launch-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #326ad0;
  background: #eaf1ff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.quick-face .quick-launch-icon {
  color: #4f63bc;
  background: #eceffd;
}

.quick-analysis .quick-launch-icon {
  color: #2f74b5;
  background: #e8f4ff;
}

.quick-video .quick-launch-icon {
  color: #14815a;
  background: #e8f7f0;
}

.quick-points .quick-launch-icon {
  color: #7950bb;
  background: #f1eafe;
}

.quick-costs .quick-launch-icon {
  color: #a46b10;
  background: #fff4dd;
}

.quick-users .quick-launch-icon {
  color: #a94770;
  background: #fdeaf2;
}

.quick-launch-name {
  margin-top: 8rpx;
  color: #25344a;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.quick-launch-state {
  margin-top: 1rpx;
  overflow: hidden;
  color: #268157;
  font-size: 16rpx;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-section {
  margin-top: 24rpx;
}

.overview-heading {
  margin-bottom: 12rpx;
  padding-left: 4rpx;
  color: #50617a;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.current-config-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  margin: 0 0 12rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid #dce4ef;
  border-radius: 24rpx;
  color: #152033;
  background: #ffffff;
  box-shadow: 0 9rpx 24rpx rgba(35, 55, 86, 0.05);
  line-height: normal;
  text-align: left;
}

.current-config-row.is-abnormal {
  border-color: #e5a0a7;
  background: #fff8f8;
}

.current-config-static {
  cursor: default;
}

.current-config-main {
  min-width: 0;
  flex: 1;
}

.current-config-title {
  color: #152033;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.current-config-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #72829a;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-config-side {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.config-state {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #16764e;
  background: #e8f7f0;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
}

.config-state.is-off {
  color: #9a6217;
  background: #fff3df;
}

.current-config-arrow {
  color: #2869d7;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.today-section {
  margin-top: 20rpx;
}

.today-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.today-item {
  min-width: 0;
  padding: 20rpx 10rpx 18rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
}

.today-value,
.today-label {
  display: block;
}

.today-value {
  overflow: hidden;
  color: #132039;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-value.is-warn {
  color: #b24c47;
}

.today-label {
  margin-top: 5rpx;
  color: #8290a3;
  font-size: 18rpx;
  line-height: 26rpx;
}

.config-editor {
  margin-top: 22rpx;
  padding: 24rpx;
  border-color: #cad8eb;
}

.config-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8edf4;
}

.config-editor-kicker {
  color: #5d76a1;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 26rpx;
}

.config-editor-title {
  margin-top: 4rpx;
  color: #142139;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.config-close-button {
  display: flex;
  flex: none;
  width: 106rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce5f0;
  border-radius: 16rpx;
  color: #53647b;
  background: #f4f7fb;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
}

.config-editor-body {
  padding-top: 18rpx;
}

.config-editor-tools {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.config-tool-button {
  display: flex;
  min-width: 190rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #bdd0ef;
  border-radius: 16rpx;
  color: #245fd4;
  background: #eef5ff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.config-helper {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #526985;
  background: #eef4fb;
  font-size: 20rpx;
  line-height: 30rpx;
}

.admin-close-button {
  color: #566980 !important;
  background: #f0f4f9 !important;
}

.monitor-toggle {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin: 22rpx 0 0;
  padding: 18rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 1rpx solid #dce4ef;
  border-radius: 24rpx;
  color: #17243a;
  background: #ffffff;
  box-shadow: 0 9rpx 24rpx rgba(35, 55, 86, 0.05);
  line-height: normal;
  text-align: left;
}

.monitor-toggle.is-open {
  border-color: #aec4e5;
}

.monitor-toggle-title {
  color: #17243a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.monitor-toggle-subtitle {
  margin-top: 3rpx;
  color: #7d8a9e;
  font-size: 18rpx;
  line-height: 27rpx;
}

.monitor-toggle-arrow {
  flex: none;
  color: #6480a8;
  font-size: 34rpx;
  line-height: 40rpx;
}

.monitor-content {
  margin-top: 18rpx;
}

.admin-hero {
  padding: 28rpx;
  background: linear-gradient(135deg, #eef5ff 0%, #ffffff 74%);
}

.admin-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.admin-kicker {
  color: #1f6feb;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.admin-title {
  margin-top: 8rpx;
  color: #182132;
  font-size: 40rpx;
  font-weight: 800;
}

.admin-subtitle,
.admin-section-help {
  margin-top: 8rpx;
  color: #718096;
  font-size: 22rpx;
  line-height: 34rpx;
}

.admin-access-badge,
.admin-config-state {
  flex: none;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #23834b;
  background: #eaf8ef;
  font-size: 20rpx;
}

.admin-config-state.is-off {
  color: #ae6b13;
  background: #fff5e8;
}

.admin-back-button {
  width: 100%;
  height: 68rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  color: #1f6feb;
  background: #e8f1ff;
  font-size: 26rpx;
  line-height: 68rpx;
}

.admin-back-button::after {
  border: 0;
}

.admin-content {
  margin-top: 18rpx;
}

.admin-message {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #31506e;
  background: #eef6ff;
  font-size: 23rpx;
  line-height: 34rpx;
}

.admin-state-card,
.admin-section {
  padding: 24rpx;
}

.admin-state-card {
  margin-top: 24rpx;
}

.admin-retry-button {
  display: flex;
  width: 100%;
  height: 64rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b9cbea;
  border-radius: 16rpx;
  color: #245fd4;
  background: #f3f7ff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.admin-section {
  margin-bottom: 18rpx;
}

.usage-section {
  overflow: hidden;
}

.admin-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.admin-section-tools {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.admin-section-title {
  color: #1b2638;
  font-size: 30rpx;
  font-weight: 800;
}

.usage-refresh-button {
  flex: none;
  width: 142rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #cfe0f8;
  border-radius: 14rpx;
  color: #1f6feb;
  background: #eef5ff;
  font-size: 20rpx;
  line-height: 54rpx;
}

.usage-refresh-button::after {
  border: 0;
}

.usage-toolbar {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.usage-export-button {
  flex: none;
  width: 142rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d8c89a;
  border-radius: 14rpx;
  color: #8a6517;
  background: #fff8df;
  font-size: 20rpx;
  line-height: 54rpx;
}

.usage-export-button::after {
  border: 0;
}

.usage-message {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #31506e;
  background: #eef6ff;
  font-size: 21rpx;
  line-height: 30rpx;
}

.usage-message.is-warn {
  color: #9a631b;
  background: #fff6e9;
}

.usage-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.usage-summary-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  text-align: center;
}

.usage-summary-item text {
  display: block;
  color: #7d899b;
  font-size: 20rpx;
  line-height: 28rpx;
}

.usage-summary-item text + text {
  margin-top: 4rpx;
  color: #1e2d43;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.usage-summary-item text:last-child {
  color: #8a96a8;
  font-size: 18rpx;
  line-height: 26rpx;
}

.usage-cost-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.usage-cost-item {
  display: flex;
  min-width: 0;
  min-height: 122rpx;
  padding: 16rpx 14rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #f0e2b6;
  border-radius: 16rpx;
  background: #fffaf0;
  text-align: center;
}

.usage-cost-item text {
  display: block;
  color: #8b7440;
  font-size: 19rpx;
  line-height: 28rpx;
}

.usage-cost-item text + text {
  margin-top: 4rpx;
  color: #9b6f0a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.usage-cost-item text:last-child {
  overflow: hidden;
  color: #9a8960;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.usage-type-card {
  display: flex;
  min-width: 0;
  min-height: 212rpx;
  padding: 16rpx 14rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e5ebf4;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.usage-type-image {
  border-color: #d7e7ff;
  background: #f7fbff;
}

.usage-type-face {
  border-color: #e6def9;
  background: #fbf9ff;
}

.usage-type-analysis {
  border-color: #d7e7ff;
  background: #f7fbff;
}

.usage-type-video {
  border-color: #d9eee7;
  background: #f7fcfa;
}

.usage-type-top {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.usage-type-icon {
  display: flex;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #1f6feb;
  background: #e7f0ff;
  font-size: 20rpx;
  font-weight: 800;
}

.usage-type-face .usage-type-icon {
  color: #7653bd;
  background: #eee8ff;
}

.usage-type-analysis .usage-type-icon {
  color: #2f74b5;
  background: #e8f4ff;
}

.usage-type-video .usage-type-icon {
  color: #23834b;
  background: #e4f6ed;
}

.usage-type-title {
  min-width: 0;
  overflow: hidden;
  color: #334258;
  font-size: 20rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-type-total {
  margin-top: 12rpx;
  color: #1e2d43;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.usage-type-label,
.usage-type-result,
.usage-model-text,
.usage-daily-result {
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.usage-type-result {
  display: flex;
  width: 100%;
  justify-content: center;
  gap: 10rpx;
  margin-top: 4rpx;
}

.usage-type-result text:first-child {
  color: #23834b;
}

.usage-type-result text:last-child {
  color: #b36d18;
}

.usage-model-text {
  overflow: hidden;
  margin-top: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-failure-panel {
  margin-top: 18rpx;
  padding-top: 2rpx;
}

.usage-failure-heading {
  margin-top: 0;
}

.usage-failure-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 10rpx;
}

.usage-failure-summary-item {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
