page { background:#f4f8fe; color:#10294b; font-family:"Microsoft YaHei","PingFang SC","SimHei",system-ui,sans-serif; }
.dashboard-page { min-height:100vh; overflow-x:hidden; background:#f4f8fe; }
.appbar { width:100%; min-height:0; padding:0 30rpx 24rpx; display:flex; align-items:flex-end; justify-content:space-between; box-sizing:border-box; background:#fff; border-bottom:2rpx solid #d9e4f2; }
.appbar-tools { flex:0 0 auto; min-width:0; display:flex; align-items:center; gap:14rpx; }
.demo-control { display:flex; align-items:center; gap:2rpx; color:#61799a; font-size:17rpx; font-weight:900; }
.demo-control.locked { opacity:.48; }
.demo-toggle { width:56rpx; height:32rpx; margin-left:5rpx; padding:3rpx; box-sizing:border-box; border-radius:18rpx; background:#cbd6e4; }
.demo-toggle.on { background:#2f73ee; }
.demo-knob { width:26rpx; height:26rpx; border-radius:50%; background:#fff; box-shadow:0 2rpx 6rpx rgba(16,41,75,.18); transform:translateX(0); transition:transform .16s ease; }
.demo-toggle.on .demo-knob { transform:translateX(24rpx); }

.appbar-title { color:#10294b; font-size:42rpx; font-weight:900; line-height:1; }
.appbar-link { color:#2f73ee; font-size:25rpx; font-weight:900; line-height:1; }
.appbar-link text { margin-left:4rpx; font-size:32rpx; }
.dashboard-scroll { width:calc(100% - 48rpx); min-height:0; margin:0 24rpx; box-sizing:border-box; padding:24rpx 0 calc(48rpx + env(safe-area-inset-bottom)); overflow-x:hidden; }
.hero-card { padding:27rpx; border-radius:28rpx; background:linear-gradient(145deg,#18375d 0%,#2c568a 100%); color:#fff; box-shadow:0 18rpx 44rpx rgba(26,67,113,.18); }
.hero-head { display:flex; align-items:flex-start; justify-content:space-between; }
.hero-kicker { color:#bcd4f2; font-size:19rpx; }
.hero-title { margin:6rpx 0 4rpx; font-size:42rpx; line-height:1.1; font-weight:900; }
.hero-note { color:#c8dced; font-size:19rpx; }
.hero-dot { width:18rpx; height:18rpx; margin-top:10rpx; border-radius:50%; background:#50e4ad; box-shadow:0 0 0 10rpx rgba(80,228,173,.14); }
.hero-dot.warning { background:#ffc263; box-shadow:0 0 0 10rpx rgba(255,194,99,.14); }
.hero-meta { margin-top:20rpx; padding:17rpx 19rpx; display:grid; gap:12rpx; border:1rpx solid rgba(255,255,255,.18); border-radius:17rpx; background:rgba(5,24,48,.18); font-size:19rpx; }
.hero-meta view { display:flex; justify-content:space-between; gap:16rpx; color:#c6d9ed; }
.hero-value { color:#fff; font-weight:900; }
.hero-actions { margin-top:17rpx; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; }
.hero-actions button { box-sizing:border-box; display:block; width:100%; min-width:0; height:70rpx; margin:0; padding:0 2rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.3); border-radius:14rpx; background:rgba(255,255,255,.1); color:#fff; font-size:18rpx; font-weight:900; line-height:70rpx; text-overflow:clip; white-space:nowrap; }
.management-strip { min-height:104rpx; margin-top:20rpx; padding:17rpx 19rpx; display:grid; grid-template-columns:65rpx minmax(0,1fr) auto; align-items:center; gap:17rpx; border:1rpx solid #c8dcf4; border-radius:23rpx; background:#fff; }
.management-icon { width:65rpx; height:65rpx; display:grid; place-items:center; border-radius:18rpx; background:#e8f1ff; color:#2f73ee; font-size:27rpx; font-weight:900; }
.management-copy { min-width:0; display:flex; flex-direction:column; gap:5rpx; }
.management-title { font-size:23rpx; color:#10294b; font-weight:900; }
.management-subtitle { color:#61799a; font-size:16rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.management-arrow { color:#2f73ee; font-size:32rpx; font-weight:900; }
.section { margin-top:24rpx; }
.section-head { margin:0 2rpx 12rpx; display:flex; align-items:flex-end; justify-content:space-between; }
.section-title { color:#10294b; font-size:27rpx; font-weight:900; }
.section-hint { color:#61799a; font-size:17rpx; }
.section-note { margin:0 2rpx 12rpx; color:#61799a; font-size:18rpx; line-height:1.45; }
.section-note.warning { color:#a66509; font-weight:800; }
.entry-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12rpx; }
.entry { min-height:150rpx; padding:14rpx 5rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7rpx; border:1rpx solid #d2e1f4; border-radius:20rpx; background:#fff; text-align:center; }
.entry.pending { border-color:#f0d3a4; background:#fffaf2; }
.entry-icon { width:54rpx; height:54rpx; display:grid; place-items:center; border-radius:16rpx; background:#e8f1ff; color:#2f73ee; font-size:23rpx; font-weight:900; }
.entry.pending .entry-icon { background:#fff0d9; color:#b06a00; }
.entry-label { color:#10294b; font-size:20rpx; line-height:1.2; font-weight:900; }
.entry-status { color:#16a16f; font-size:15rpx; font-weight:900; }
.entry.pending .entry-status { color:#a66509; }
.shared-card { min-height:108rpx; padding:21rpx; display:grid; grid-template-columns:minmax(0,1fr) 177rpx; gap:19rpx; align-items:center; border:1rpx solid #c8dcf4; border-radius:23rpx; background:#fff; }
.shared-copy { min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.shared-title { color:#10294b; font-size:27rpx; font-weight:900; }
.shared-subtitle { color:#61799a; font-size:18rpx; }
.shared-action { height:73rpx; display:flex; align-items:center; justify-content:center; gap:5rpx; border-radius:14rpx; background:#2f73ee; color:#fff; font-size:21rpx; font-weight:900; }
.shared-action text { font-size:30rpx; }
.metrics-section { margin-bottom:0; }
.metric-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12rpx; }
.metric { min-height:129rpx; padding:15rpx 6rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; border:1rpx solid #d3e1f2; border-radius:21rpx; background:#fff; text-align:center; }
.metric-label { color:#10294b; font-size:25rpx; font-weight:900; }
.metric-detail { color:#2f73ee; font-size:17rpx; font-weight:900; }
.bottom-space { height:60rpx; }
.tap { opacity:.78; }
@media (max-width:700rpx) {
  .dashboard-scroll { margin-left:24rpx; margin-right:24rpx; padding-left:0; padding-right:0; }
  .hero-actions button { font-size:18rpx; }
  .management-subtitle { font-size:18rpx; }
  .entry-label { font-size:18rpx; }
}
