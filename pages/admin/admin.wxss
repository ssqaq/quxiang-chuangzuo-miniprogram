  align-items: flex-end;
  flex-direction: column;
  gap: 4rpx;
}

.auto-face-failure-user-detail-link {
  color: #2f70d4;
  font-size: 17rpx;
  line-height: 24rpx;
}

.failure-type-tag {
  display: inline-flex;
  min-height: 28rpx;
  padding: 2rpx 8rpx;
  align-items: center;
  border-radius: 8rpx;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 24rpx;
}

.failure-type-tag.is-danger {
  color: #b42332;
  background: #fff0f1;
}

.failure-type-tag.is-warning {
  color: #a26008;
  background: #fff6df;
}

.failure-type-tag.is-violet {
  color: #7043a2;
  background: #f3ecff;
}

.failure-type-tag.is-info {
  color: #286b9c;
  background: #eaf6ff;
}

.failure-type-tag.is-neutral {
  color: #667085;
  background: #f1f3f6;
}

.auto-face-month-picker {
  display: inline-flex;
  min-height: 44rpx;
  padding: 0 12rpx;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid #d8e3f3;
  border-radius: 10rpx;
  color: #2f70d4;
  background: #f5f8fd;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
}

.auto-face-failure-monthly-row.is-selected {
  margin: 0 -10rpx;
  padding-right: 10rpx;
  padding-left: 10rpx;
  border-radius: 10rpx;
  background: #f5f8fd;
}

.auto-face-detail-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 80rpx 22rpx 40rpx;
  background: rgba(18, 27, 44, 0.42);
}

.auto-face-detail-dialog {
  max-height: 86vh;
  padding: 22rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(22, 37, 63, 0.2);
}

.auto-face-detail-head {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.auto-face-detail-title {
  color: #1b2638;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.auto-face-detail-subtitle {
  margin-top: 4rpx;
  color: #7a879a;
  font-size: 18rpx;
  line-height: 26rpx;
}

.auto-face-detail-close {
  flex: none;
  color: #2f70d4;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.auto-face-detail-list {
  max-height: 72vh;
  overflow-y: auto;
}

.auto-face-detail-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.auto-face-detail-row:last-child {
  border-bottom: 0;
}

.auto-face-detail-row-top,
.auto-face-detail-meta {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.auto-face-detail-row-top text:first-child {
  color: #334258;
  font-size: 19rpx;
  line-height: 28rpx;
}

.auto-face-detail-meta {
  justify-content: flex-start;
  flex-wrap: wrap;
  margin-top: 6rpx;
  color: #7a879a;
  font-size: 17rpx;
  line-height: 26rpx;
}

.auto-face-detail-message {
  margin-top: 6rpx;
  color: #5c687a;
  font-size: 18rpx;
  line-height: 28rpx;
}

.auto-face-detail-request {
  margin-top: 4rpx;
  color: #3974a8;
  font-size: 17rpx;
  line-height: 24rpx;
}

.usage-subsection-title {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
  color: #334258;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.usage-user-list,
.usage-model-list,
.usage-monthly-list {
  margin-top: 8rpx;
}

.usage-monthly-list {
  max-height: 560rpx;
}

.usage-user-row,
.usage-model-row,
.usage-monthly-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.usage-user-row:last-child,
.usage-model-row:last-child,
.usage-monthly-row:last-child {
  border-bottom: 0;
}

.usage-user-top,
.usage-model-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.usage-user-top text:first-child {
  min-width: 0;
  overflow: hidden;
  color: #334258;
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-model-top {
  align-items: flex-start;
}

.usage-model-top text:first-child {
  flex: 1;
  min-width: 0;
  overflow: visible;
  color: #334258;
  font-size: 21rpx;
  font-weight: 700;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.usage-user-top text:last-child,
.usage-model-top text:last-child {
  flex: none;
  color: #9b6f0a;
  font-size: 19rpx;
}

.usage-user-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  margin-top: 6rpx;
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.admin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.admin-field {
  min-width: 0;
}

.admin-field-wide {
  grid-column: 1 / -1;
}

.admin-field > text {
  display: block;
  margin-bottom: 8rpx;
  color: #68768a;
  font-size: 21rpx;
}

.admin-field input {
  box-sizing: border-box;
  width: 100%;
  height: 70rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  color: #1d2433;
  background: #fbfcfe;
  font-size: 23rpx;
}

.admin-checkbox-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #405069;
  font-size: 23rpx;
}

.admin-checkbox-row checkbox {
  margin-right: 10rpx;
}

.admin-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}

.admin-actions button {
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 76rpx;
}

.admin-action-button {
  display: flex;
  height: 76rpx;
  min-width: 0;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.control-tap {
  opacity: 0.82;
}

.admin-save-button {
  color: #ffffff !important;
  background: #1f6feb !important;
}

.admin-check-button {
  color: #1f6feb !important;
  background: #e8f1ff !important;
}

.deployment-card {
  margin-top: 0;
}

.auto-face-probe-card {
  margin-top: 0;
}

.model-probe-card {
  margin-top: 0;
}

.model-probe-list {
  margin-top: 16rpx;
}

.model-probe-row {
  display: flex;
  padding: 18rpx 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.model-probe-row:last-child {
  border-bottom: 0;
}

.model-probe-main {
  min-width: 0;
  flex: 1;
}

.model-probe-title {
  color: #1d2a3e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.model-probe-meta,
.model-probe-message {
  margin-top: 5rpx;
  overflow: hidden;
  color: #718096;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
}

.model-probe-meta {
  white-space: nowrap;
}

.model-probe-message {
  white-space: normal;
}

.model-probe-side {
  display: flex;
  flex: none;
  min-width: 112rpx;
  align-items: flex-end;
  flex-direction: column;
  gap: 6rpx;
  color: #7d899b;
  font-size: 18rpx;
  line-height: 26rpx;
}

.model-probe-single-button {
  display: flex;
  min-width: 108rpx;
  height: 48rpx;
  margin-top: 4rpx;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c8d8ee;
  border-radius: 14rpx;
  color: #2869d7;
  background: #eef5ff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.model-probe-single-button.is-disabled {
  color: #8a99ad;
  background: #f3f5f8;
  opacity: 0.75;
}

.auto-face-probe-history-card {
  margin-top: 0;
}

.auto-face-probe-history-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.auto-face-probe-history-row:last-child {
  border-bottom: 0;
}

.auto-face-probe-history-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.auto-face-probe-history-top view {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.auto-face-probe-history-time {
  color: #7a879a;
  font-size: 19rpx;
}

.auto-face-probe-history-duration {
  flex: none;
  color: #2f659d;
  font-size: 20rpx;
  font-weight: 700;
}

.auto-face-probe-history-meta,
.auto-face-probe-history-error {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auto-face-probe-history-error {
  color: #b36d18;
}

.deployment-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.deployment-grid view {
  min-width: 0;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.deployment-grid text {
  display: block;
  overflow: hidden;
  color: #7d899b;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deployment-grid text + text {
  margin-top: 4rpx;
  color: #26354b;
  font-size: 22rpx;
}

.admin-log-count {
  color: #7b8ba1;
  font-size: 21rpx;
}

.diagnostic-admin-section {
  overflow: hidden;
}

.diagnostic-admin-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.diagnostic-admin-summary-item {
  min-width: 0;
  padding: 16rpx 8rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 14rpx;
  background: #f8fafc;
  text-align: center;
}

.diagnostic-admin-summary-item text {
  display: block;
  color: #7b8798;
  font-size: 18rpx;
}

.diagnostic-admin-summary-item text + text {
  margin-top: 6rpx;
  color: #21334d;
  font-size: 28rpx;
  font-weight: 800;
}

.diagnostic-admin-summary-item.is-error {
  border-color: #f0caca;
  background: #fff6f6;
}

.diagnostic-admin-summary-item.is-error text + text {
  color: #bd3d3d;
}

.diagnostic-admin-summary-item.is-warn {
  border-color: #f1d7ad;
  background: #fff9ef;
}

.diagnostic-admin-summary-item.is-warn text + text {
  color: #aa681b;
}

.diagnostic-admin-summary-item.is-info text + text {
  color: #267849;
}

.diagnostic-admin-filter-block {
  margin-top: 20rpx;
}

.diagnostic-admin-filter-title {
  margin-bottom: 10rpx;
  color: #617086;
  font-size: 20rpx;
  font-weight: 700;
}

.diagnostic-admin-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.diagnostic-admin-filter-row {
  display: flex;
  width: max-content;
  min-width: 100%;
  gap: 10rpx;
}

.diagnostic-admin-filter-chip {
  display: flex;
  flex: none;
  min-width: 78rpx;
  height: 54rpx;
  padding: 0 16rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  color: #627087;
  background: #f7f9fc;
  font-size: 19rpx;
  font-weight: 700;
}

.diagnostic-admin-filter-chip.is-active {
  border-color: #3977dc;
  color: #ffffff;
  background: #3977dc;
}

.diagnostic-admin-user-picker {
  display: flex;
  margin-top: 20rpx;
  padding: 17rpx 18rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  color: #53627a;
  background: #f8fafc;
  font-size: 20rpx;
}

.diagnostic-admin-user-picker text + text {
  max-width: 68%;
  overflow: hidden;
  color: #2868c9;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diagnostic-admin-category-summary {
  display: flex;
  margin-top: 18rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.diagnostic-admin-category-item {
  display: flex;
  padding: 10rpx 14rpx;
  align-items: center;
  gap: 8rpx;
  border-radius: 12rpx;
  color: #617087;
  background: #eef3f9;
  font-size: 18rpx;
}

.diagnostic-admin-category-item text + text {
  color: #2c5f9f;
  font-weight: 800;
}

.diagnostic-admin-list {
  margin-top: 18rpx;
}

.diagnostic-admin-log {
  margin-top: 12rpx;
  padding: 18rpx;
  border: 1rpx solid #dfe6ef;
  border-left: 6rpx solid #7ea7df;
  border-radius: 16rpx;
  background: #ffffff;
}

.diagnostic-admin-log.level-error {
  border-color: #f0cccc;
  border-left-color: #d55353;
  background: #fffafa;
}

.diagnostic-admin-log.level-warn {
  border-color: #f0d8b4;
  border-left-color: #d18a2e;
  background: #fffcf6;
}

.diagnostic-admin-log.level-info {
  border-left-color: #55a679;
}

.diagnostic-admin-log-top,
.diagnostic-admin-log-tags,
.diagnostic-admin-log-actions {
  display: flex;
  align-items: center;
}

.diagnostic-admin-log-top {
  justify-content: space-between;
  gap: 12rpx;
}

.diagnostic-admin-log-tags,
.diagnostic-admin-log-actions {
  gap: 10rpx;
}

.diagnostic-admin-level,
.diagnostic-admin-category {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  color: #ffffff;
  background: #617994;
  font-size: 17rpx;
  font-weight: 800;
}

.level-error .diagnostic-admin-level {
  background: #c84848;
}

.level-warn .diagnostic-admin-level {
  background: #bd7624;
}

.level-info .diagnostic-admin-level {
  background: #3b9061;
}

.diagnostic-admin-category {
  color: #47617f;
  background: #eaf0f7;
}

.diagnostic-admin-time {
  flex: none;
  color: #7b8797;
  font-size: 18rpx;
}

.diagnostic-admin-message {
  margin-top: 14rpx;
  color: #24344b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.diagnostic-admin-meta {
  display: flex;
  margin-top: 10rpx;
  flex-wrap: wrap;
  gap: 6rpx 14rpx;
  color: #748196;
  font-size: 18rpx;
  line-height: 28rpx;
}

.diagnostic-admin-log-actions {
  margin-top: 14rpx;
}

.diagnostic-detail-button {
  color: #426b9c;
  background: #edf3fa;
}

.diagnostic-admin-detail {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  color: #5c6b80;
  background: #f2f5f9;
  font-size: 18rpx;
  line-height: 28rpx;
  word-break: break-all;
}

.diagnostic-admin-detail view + view {
  margin-top: 12rpx;
}

.diagnostic-admin-detail text {
  display: block;
}

.diagnostic-admin-detail text:first-child {
  margin-bottom: 5rpx;
  color: #2f415c;
  font-weight: 800;
}

.admin-empty {
  padding: 22rpx 0 4rpx;
  color: #8390a3;
  font-size: 22rpx;
}

.admin-log-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.admin-log-item:last-child {
  border-bottom: 0;
}

.admin-log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334258;
  font-size: 22rpx;
}

.admin-log-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a879a;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-ok {
  color: #23834b;
}

.log-warn {
  color: #b36d18;
}

@media (max-width: 360px) {
  .admin-grid,
  .deployment-grid {
    grid-template-columns: 1fr;
  }

  .admin-field-wide {
    grid-column: auto;
  }

  .admin-actions {
    flex-direction: column;
  }

  .usage-summary-grid,
  .usage-type-grid,
  .usage-cost-summary,
  .usage-failure-summary,
  .auto-face-failure-summary {
    grid-template-columns: 1fr;
  }

  .diagnostic-admin-summary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .usage-toolbar {
    width: 100%;
    margin-top: 10rpx;
  }

  .usage-refresh-button {
    flex: 1;
    width: auto;
    font-size: 18rpx;
  }

  .usage-export-button {
    flex: 1;
    width: auto;
    font-size: 18rpx;
  }

  .user-stats-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .user-stats-actions {
    width: 100%;
  }

  .user-stats-d-head {
    align-items: stretch;
    flex-direction: column;
    gap: 12rpx;
  }

  .user-stats-d-actions {
    width: 100%;
  }

  .user-stats-d-action {
    flex: 1;
    width: auto;
    min-width: 0;
  }

  .user-stats-d-overview {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }

  .user-stats-d-donut {
    width: 148rpx;
    height: 148rpx;
  }
}
