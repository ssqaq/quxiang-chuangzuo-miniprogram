page {
  background: #f5f7fb;
}

.points-skeleton {
  min-height: 100vh;
  padding: 24rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  background: #f5f7fb;
}

.skeleton-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 24rpx;
  background: #ffffff;
}

.skeleton-block {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #edf1f6;
}

.skeleton-block::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -50%;
  width: 50%;
  content: "";
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0.7),
    rgba(255, 255, 255, 0)
  );
  animation: points-skeleton-shimmer 1.25s ease-in-out infinite;
}

.skeleton-kicker {
  width: 120rpx;
  height: 22rpx;
}

.skeleton-title {
  width: 260rpx;
  height: 44rpx;
  margin-top: 14rpx;
}

.skeleton-subtitle {
  width: 430rpx;
  max-width: 78%;
  height: 24rpx;
  margin-top: 12rpx;
}

.skeleton-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.skeleton-metric {
  height: 104rpx;
  border-radius: 16rpx;
}

.skeleton-section-title {
  width: 190rpx;
  height: 34rpx;
}

.skeleton-progress {
  width: 100%;
  height: 18rpx;
  margin-top: 28rpx;
}

.skeleton-button {
  width: 100%;
  height: 78rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
}

.skeleton-usage {
  height: 74rpx;
  border-radius: 16rpx;
}

.skeleton-row {
  width: 100%;
  height: 54rpx;
  margin-top: 18rpx;
}

@keyframes points-skeleton-shimmer {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(300%);
  }
}

.points-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  color: #1d2433;
}

.card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e1e8f1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(31, 49, 79, 0.05);
}

.points-hero {
  padding: 24rpx;
  border-color: #cfe3ff;
  background: linear-gradient(145deg, #edf5ff 0%, #ffffff 72%);
}

.points-hero-head,
.streak-head,
.ledger-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.points-heading,
.streak-heading {
  min-width: 0;
  flex: 1;
}

.points-kicker {
  color: #1f6feb;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.points-title {
  margin-top: 8rpx;
  color: #17253b;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.points-subtitle,
.section-subtitle,
.checkin-hint,
.usage-note,
.ledger-total {
  margin-top: 8rpx;
  color: #718096;
  font-size: 22rpx;
  line-height: 34rpx;
}

.points-balance {
  display: flex;
  flex: none;
  min-width: 132rpx;
  padding: 14rpx 16rpx;
  align-items: center;
  flex-direction: column;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.points-balance-number {
  display: block;
  color: #1f6feb;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.points-balance-label {
  display: block;
  margin-top: 4rpx;
  color: #7b8ba1;
  font-size: 20rpx;
}

.dashboard-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.dashboard-metric {
  min-width: 0;
  min-height: 104rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.dashboard-metric-blue {
  background: #edf4ff;
}

.dashboard-metric-green {
  background: #eaf8f3;
}

.dashboard-metric-orange {
  background: #fff4e3;
}

.dashboard-metric-purple {
  background: #f1edff;
}

.dashboard-metric-label {
  display: block;
  overflow: hidden;
  color: #78879b;
  font-size: 20rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-metric-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #2c405f;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-metric-blue .dashboard-metric-value {
  color: #2f70d5;
}

.dashboard-metric-green .dashboard-metric-value {
  color: #188b70;
}

.dashboard-metric-orange .dashboard-metric-value {
  color: #bd7623;
}

.dashboard-metric-purple .dashboard-metric-value {
  color: #7056cf;
}

.points-promo {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #946d24;
  background: #fff8e9;
  font-size: 21rpx;
  line-height: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.section-title {
  color: #243047;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.section-meta {
  flex: none;
  color: #7183a1;
  font-size: 20rpx;
  line-height: 30rpx;
}

.streak-count {
  display: flex;
  flex: none;
  align-items: baseline;
  color: #1f6feb;
  font-size: 24rpx;
  font-weight: 700;
}

.streak-count text:first-child {
  font-size: 44rpx;
  line-height: 44rpx;
}

.streak-progress-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8eff8;
}

.streak-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #62a3ff, #1f6feb);
}

.streak-progress-foot {
  display: flex;
  margin-top: 10rpx;
  justify-content: space-between;
  color: #7d899b;
  font-size: 20rpx;
}

.checkin-button {
  display: flex;
  width: 100%;
  height: 78rpx;
  margin-top: 22rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.checkin-button[disabled] {
  color: #7c8798 !important;
  background: #e9eef5 !important;
}

.checkin-hint {
  text-align: center;
}

.checkin-celebration {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #c8f0dc;
  border-radius: 16rpx;
  background: #effcf5;
  animation: checkin-celebration-in 320ms ease-out both;
}

.checkin-celebration-icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #28a66a;
  font-size: 30rpx;
  font-weight: 800;
}

.checkin-celebration-copy {
  min-width: 0;
  margin-left: 14rpx;
}

.checkin-celebration-title {
  color: #20794f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.checkin-celebration-text {
  margin-top: 2rpx;
  overflow: hidden;
  color: #5d806e;
  font-size: 20rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes checkin-celebration-in {
  0% {
    opacity: 0;
    transform: translateY(10rpx) scale(0.98);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.usage-card {
  padding-bottom: 22rpx;
}

.usage-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.usage-item {
  min-width: 0;
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  text-align: center;
}

.usage-label,
.usage-value {
  display: block;
}

.usage-label {
  color: #7b879a;
  font-size: 20rpx;
}

.usage-value {
  margin-top: 6rpx;
  color: #2e405a;
  font-size: 24rpx;
  font-weight: 700;
}

.free-usage-progress {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.free-usage-progress-head,
.free-usage-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #758297;
  font-size: 20rpx;
  line-height: 28rpx;
}

.free-usage-progress-head text:last-child {
  flex: none;
  color: #39516f;
  font-weight: 700;
}

.free-usage-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5edf7;
}

.free-usage-fill {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffbd5b, #f08a35);
  transition: width 260ms ease;
}

.free-usage-foot {
  margin-top: 8rpx;
  color: #96a0af;
  font-size: 18rpx;
}

.usage-note {
  margin-top: 14rpx;
}

.ledger-head {
  align-items: center;
}

.ledger-summary {
  display: flex;
  flex: none;
  align-items: flex-end;
  gap: 16rpx;
}

.ledger-summary-item {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  color: #8a96a8;
  font-size: 17rpx;
  line-height: 24rpx;
}

.ledger-summary-value {
  margin-top: 2rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.ledger-summary-income {
  color: #23834b;
}

.ledger-summary-expense {
  color: #c35d68;
}

.ledger-filter-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ledger-filter-chip {
  min-width: 84rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #e3eaf3;
  border-radius: 999rpx;
  color: #7b879a;
  background: #f7f9fc;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.ledger-filter-chip-active {
  border-color: #cfe3ff;
  color: #1f6feb;
  background: #edf4ff;
  font-weight: 700;
}

.empty-ledger {
  padding: 28rpx 0 8rpx;
  color: #8a96a8;
  font-size: 22rpx;
  text-align: center;
}

.ledger-row {
  display: flex;
  padding: 18rpx 0;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-top: 1rpx solid #edf0f5;
}

.ledger-row:first-of-type {
  margin-top: 16rpx;
}

.ledger-copy {
  min-width: 0;
  flex: 1;
}

.ledger-description {
  overflow: hidden;
  color: #334258;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-time {
  margin-top: 6rpx;
  color: #8792a4;
  font-size: 19rpx;
}

.ledger-amount {
  flex: none;
  font-size: 27rpx;
  font-weight: 800;
}

.ledger-income {
  color: #23834b;
}

.ledger-expense {
  color: #c35d68;
}

.ledger-free {
  color: #7b879a;
}

.points-message {
  margin: -4rpx 0 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  color: #7c6b3d;
  background: #fff8e9;
  font-size: 21rpx;
  line-height: 32rpx;
}

.back-button {
  display: flex;
  width: 100%;
  height: 78rpx;
  margin-top: 18rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.primary-btn {
  background: #356fce !important;
  color: #ffffff !important;
}

.plain-btn {
  background: #f4f6fa !important;
  color: #4b5567 !important;
}

button::after {
  border: 0;
}

@media (max-width: 360px) {
  .points-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .points-skeleton {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .points-hero {
    padding: 20rpx;
  }

  .points-title {
    font-size: 34rpx;
  }

  .points-balance {
    min-width: 112rpx;
    padding-right: 10rpx;
    padding-left: 10rpx;
  }

  .points-balance-number {
    font-size: 36rpx;
  }

  .dashboard-metric {
    min-height: 96rpx;
    padding: 14rpx;
  }

  .dashboard-metric-value {
    font-size: 28rpx;
  }

  .free-usage-progress-head,
  .free-usage-foot {
    font-size: 18rpx;
  }

  .ledger-filter-chip {
    min-width: 76rpx;
    padding-right: 14rpx;
    padding-left: 14rpx;
  }

  .ledger-summary {
    gap: 8rpx;
  }

  .ledger-summary-item {
    font-size: 16rpx;
  }
}

@media (min-width: 400px) and (max-width: 430px) {
  .points-page {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .points-hero {
    padding: 26rpx;
  }

  .points-skeleton {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .dashboard-metric {
    min-height: 112rpx;
    padding: 18rpx;
  }
}
