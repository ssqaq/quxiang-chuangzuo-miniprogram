page { background:#f4f8fe; color:#10294b; font-family:"Microsoft YaHei","PingFang SC","SimHei",sans-serif; font-weight:600; }
.operations-page { min-height:100vh; background:#f4f8fe; }
.appbar { height:112rpx; padding:0 24rpx 22rpx; display:flex; align-items:flex-end; gap:12rpx; box-sizing:border-box; background:#fff; border-bottom:1rpx solid #d9e4f2; }
.back { width:38rpx; height:40rpx; color:#2f73ee; font-size:50rpx; line-height:33rpx; text-align:center; }
.appbar-title { flex:1; min-width:0; overflow:hidden; color:#10294b; font-size:34rpx; line-height:1; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.appbar-link { flex:0 0 auto; color:#2f73ee; font-size:21rpx; line-height:1; font-weight:900; }
.appbar-link text { font-size:28rpx; }
.operations-scroll { height:calc(100vh - 112rpx); padding:18rpx; box-sizing:border-box; }
.view-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:6rpx; padding:5rpx; border-radius:14rpx; background:#e8f2ff; }
.view-tab { min-width:0; height:60rpx; display:flex; align-items:center; justify-content:center; border-radius:10rpx; color:#244668; font-size:19rpx; font-weight:900; }
.view-tab.active { background:#2f73ee; color:#fff; box-shadow:0 5rpx 12rpx rgba(47,115,238,.2); }
.quick-links { margin:10rpx 2rpx 0; display:grid; grid-template-columns:1fr 1fr; gap:8rpx; }
.quick-links view { min-width:0; padding:8rpx 10rpx; border:1rpx solid #c8dbf3; border-radius:10rpx; background:#fff; color:#2f73ee; font-size:17rpx; font-weight:900; text-align:center; }
.quick-links text { font-size:23rpx; }
.overview-card { margin-top:12rpx; padding:22rpx; border-radius:20rpx; background:linear-gradient(145deg,#2f73ee 0%,#315fd0 100%); color:#fff; box-shadow:0 14rpx 30rpx rgba(47,115,238,.18); }
.overview-eyebrow { display:block; color:#dce9ff; font-size:16rpx; font-weight:900; letter-spacing:2rpx; }
.overview-title { display:block; margin-top:6rpx; color:#fff; font-size:34rpx; line-height:1.15; font-weight:900; }
.overview-description { display:block; margin-top:6rpx; color:#e3edff; font-size:18rpx; line-height:1.45; }
.overview-actions { margin-top:16rpx; display:grid; grid-template-columns:1fr 1fr; gap:8rpx; }
.overview-button { min-width:0; height:62rpx; margin:0; padding:0 6rpx; border:1rpx solid rgba(255,255,255,.42); border-radius:11rpx; background:rgba(255,255,255,.1); color:#fff; font-size:18rpx; line-height:62rpx; font-weight:900; }
.overview-button[disabled] { opacity:.55; }
.summary-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8rpx; margin-top:12rpx; }
.summary-item { min-width:0; min-height:100rpx; padding:13rpx 7rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1rpx solid #c8dbf3; border-radius:14rpx; background:#fff; text-align:center; }
.summary-label { display:block; color:#61799a; font-size:16rpx; line-height:1.2; }
.summary-value { display:block; max-width:100%; margin-top:7rpx; overflow:hidden; color:#10294b; font-size:27rpx; line-height:1.1; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.detail-list { margin-top:12rpx; }
.detail-card { margin-bottom:8rpx; padding:12rpx; border:1rpx solid #c8dbf3; border-radius:14rpx; background:#fff; }
.detail-head { min-width:0; display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:8rpx; }
.detail-copy { min-width:0; }
.detail-title { display:block; overflow:hidden; color:#10294b; font-size:22rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.detail-description { display:block; margin-top:4rpx; overflow:hidden; color:#61799a; font-size:16rpx; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.detail-toggle { min-width:70rpx; height:52rpx; margin:0; padding:0 6rpx; border:1rpx solid #b6d2f5; border-radius:9rpx; background:#f2f7ff; color:#2f73ee; font-size:16rpx; line-height:52rpx; font-weight:900; }
.detail-body { margin-top:10rpx; padding:10rpx; border:1rpx dashed #9ec5f7; border-radius:10rpx; background:#f9fbff; }
.detail-line { display:block; color:#244668; font-size:16rpx; line-height:1.55; word-break:break-all; }
.foot-note { margin-top:12rpx; padding:11rpx 12rpx; border-radius:11rpx; background:#edf5ff; color:#61799a; font-size:17rpx; line-height:1.5; }
.empty-note { margin-top:12rpx; padding:14rpx; border-radius:11rpx; background:#edf5ff; color:#61799a; font-size:17rpx; line-height:1.5; }
.message { margin-top:10rpx; padding:10rpx 12rpx; border-radius:10rpx; background:#e5f8f1; color:#07875c; font-size:16rpx; line-height:1.4; }
.bottom-space { height:64rpx; }
.tap { opacity:.78; }
@media (max-width:700rpx) {
  .operations-scroll { padding-left:14rpx; padding-right:14rpx; }
  .appbar-title { font-size:31rpx; }
  .appbar-link { font-size:19rpx; }
  .view-tab { font-size:18rpx; }
  .overview-title { font-size:31rpx; }
  .overview-description { font-size:17rpx; }
  .summary-value { font-size:24rpx; }
  .detail-title { font-size:20rpx; }
}
