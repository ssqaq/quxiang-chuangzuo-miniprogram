.media-parser-page {
  min-height: 100vh;
  padding: 0 28rpx calc(72rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f8fe;
  color: #18355c;
}

.media-parser-topline {
  width: 100%;
  height: 6rpx;
  background: #2d7ff2;
}

.media-parser-hero {
  padding: 30rpx 4rpx 20rpx;
}

.hero-kicker,
.result-kicker,
.copywriting-kicker {
  color: #2d7ff2;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 30rpx;
}

.media-parser-heading {
  margin-top: 8rpx;
  color: #17345c;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.22;
}

.media-parser-subheading {
  margin-top: 10rpx;
  color: #6c82a0;
  font-size: 23rpx;
  line-height: 36rpx;
}

.input-card,
.state-card,
.result-card {
  border: 1rpx solid #dfe9f7;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(35, 76, 129, 0.06);
}

.input-card {
  padding: 22rpx;
}

.input-card-heading,
.result-head,
.copywriting-head,
.copywriting-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.input-card-heading .section-label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-label,
.result-title,
.state-title,
.copywriting-title {
  color: #214269;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.paste-button,
.copy-button {
  flex: none;
  width: auto;
  min-width: 0;
  height: 52rpx;
  margin: 0;
  padding: 0 17rpx;
  border: 0;
  border-radius: 999rpx;
  color: #2879ec;
  background: #eaf3ff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 52rpx;
  white-space: nowrap;
}

.paste-button::after,
.copy-button::after,
.text-button::after,
.secondary-btn::after {
  border: 0;
}

.media-input {
  width: 100%;
  min-height: 178rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #d5e3f6;
  border-radius: 17rpx;
  color: #28486f;
  background: #f8fbff;
  font-size: 24rpx;
  line-height: 38rpx;
}

.media-input-placeholder {
  color: #a0b2c9;
}

.input-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #92a5bf;
  font-size: 20rpx;
  line-height: 30rpx;
}

.privacy-note {
  display: flex;
  align-items: center;
  min-width: 0;
}

.privacy-check {
  display: inline-flex;
  width: 24rpx;
  height: 24rpx;
  margin-right: 7rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #2d7ff2;
  background: #e8f2ff;
  font-size: 16rpx;
  font-weight: 800;
}

.feature-row {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.feature-option {
  display: flex;
  min-width: 0;
  flex: 0 0 calc(50% - 5rpx);
  align-items: center;
  width: calc(50% - 5rpx);
  min-height: 84rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border: 1rpx solid #cfe0f7;
  border-radius: 16rpx;
  background: #fbfdff;
}

.feature-icon,
.feature-check,
.state-icon,
.stage-node {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: 800;
}

.feature-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 9rpx;
  font-size: 20rpx;
}

.feature-icon-media {
  color: #2d7ff2;
  background: #e5f0ff;
}

.feature-icon-copy {
  color: #4b69c6;
  background: #edf0ff;
}

.media-play-icon {
  width: 0;
  height: 0;
  margin-left: 3rpx;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  border-left: 11rpx solid currentColor;
}

.copy-lines-icon {
  display: flex;
  width: 20rpx;
  flex-direction: column;
  gap: 3rpx;
}

.copy-line {
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.copy-line-short {
  width: 14rpx;
}

.feature-copy {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.feature-title {
  overflow: hidden;
  color: #28496f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-subtitle {
  margin-top: 2rpx;
  overflow: hidden;
  color: #8a9db6;
  font-size: 18rpx;
  line-height: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-check {
  width: 28rpx;
  height: 28rpx;
  margin-left: 5rpx;
  color: #ffffff;
  background: #2d7ff2;
  font-size: 18rpx;
}

.primary-btn,
.secondary-btn {
  width: 100%;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.primary-btn {
  height: 88rpx;
  margin: 18rpx 0 0;
  color: #ffffff;
  background: #2d7ff2;
  box-shadow: 0 14rpx 24rpx rgba(45, 127, 242, 0.22);
  line-height: 88rpx;
}

.action-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 18rpx;
}

.action-button {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  box-sizing: border-box;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: normal;
}

.parse-button {
  position: relative;
  padding: 0 46rpx;
  text-align: center;
}

.primary-btn::after {
  border: 0;
}

.primary-btn[disabled] {
  opacity: 0.62;
  box-shadow: none;
}

.button-arrow {
  position: absolute;
  top: 50%;
  right: 22rpx;
  margin-left: 0;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-50%);
}

.button-label {
  display: block;
  overflow: hidden;
  line-height: 1.35;
  text-overflow: ellipsis;
  text-align: center;
  white-space: nowrap;
}

.back-button {
  padding: 0 12rpx;
  color: #2d7ff2;
  background: #eef5ff;
}

.page-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 13rpx;
  color: #7890b0;
  font-size: 19rpx;
  line-height: 28rpx;
}

.note-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: #2d7ff2;
}

.note-divider {
  margin: 0 9rpx;
  color: #bbcadc;
}

.state-card {
  margin-top: 18rpx;
  padding: 22rpx;
}

.state-loading {
  border-color: #d5e5fb;
  background: #fafdff;
}

.state-loading-head {
  display: flex;
  align-items: flex-start;
}

.state-spinner,
.state-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.state-spinner {
  flex: none;
  box-sizing: border-box;
  border: 5rpx solid #dceaff;
  border-top-color: #2d7ff2;
  border-radius: 50%;
  animation: media-parser-spin 0.9s linear infinite;
}

.state-text,
.result-hint {
  margin-top: 7rpx;
  color: #7890ad;
  font-size: 21rpx;
  line-height: 32rpx;
}

.stage-list {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f3f8ff;
}

.stage-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 52rpx;
  color: #91a4bd;
  font-size: 21rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.stage-item > text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage-item.is-current {
  color: #2d7ff2;
  font-weight: 700;
}

.stage-item.is-done {
  color: #55789f;
}

.stage-node {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  border: 1rpx solid #c8d8ec;
  box-sizing: border-box;
  color: #8aa0bb;
  background: #ffffff;
  font-size: 17rpx;
}

.stage-item.is-current .stage-node {
  border-color: #2d7ff2;
  color: #ffffff;
  background: #2d7ff2;
}

.stage-item.is-done .stage-node {
  border-color: #bcd7f9;
  color: #2d7ff2;
  background: #e9f3ff;
}

.state-error {
  display: flex;
  align-items: flex-start;
  border-color: #efd8dc;
  background: #fffafa;
}

.state-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #b34c5b;
  background: #f9e2e6;
  font-size: 30rpx;
  font-weight: 800;
}

.state-content {
  min-width: 0;
  flex: 1;
}

.text-button {
  margin: 12rpx 0 0;
  padding: 0;
  color: #2d7ff2;
  background: transparent;
  font-size: 22rpx;
  line-height: 38rpx;
  text-align: left;
}

.result-card {
  margin-top: 20rpx;
  padding: 22rpx;
}

.result-heading-copy {
  min-width: 0;
  flex: 1;
  padding-right: 14rpx;
}

.result-title {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-badge,
.result-type-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 34rpx;
}

.result-badge {
  flex: none;
  padding: 0 13rpx;
}

.result-badge-demo {
  color: #8c681d;
  background: #fff1c9;
}

.result-badge-real {
  color: #287252;
  background: #e2f7ed;
}

.result-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.result-type-chip {
  padding: 0 13rpx;
  color: #2d70d5;
  background: #eaf3ff;
}

.result-platform,
.result-author {
  margin-left: 10rpx;
  overflow: hidden;
  color: #8498b1;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-video,
.result-image {
  width: 100%;
  height: 380rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #eaf1fa;
}

.media-grid,
.live-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.media-grid-image {
  display: block;
  width: 100%;
  height: 190rpx;
  border-radius: 14rpx;
  background: #eef4fb;
}

.live-photo-item {
  min-width: 0;
}

.live-photo-label {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8b9eb7;
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-hint {
  margin-top: 12rpx;
}

.copywriting-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #d8e7fa;
  border-radius: 18rpx;
  background: #f6faff;
}

.copywriting-kicker {
  font-size: 18rpx;
  letter-spacing: 1.5rpx;
}

.copywriting-title {
  margin-top: 3rpx;
  font-size: 24rpx;
}

.copywriting-section {
  margin-top: 16rpx;
}

.copywriting-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
}

.copywriting-label {
  color: #6b85a7;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.copywriting-actions {
  display: flex;
  align-items: center;
}

.copywriting-action {
  width: auto;
  min-width: 98rpx;
  height: 44rpx;
  margin: 0;
  padding: 0 13rpx;
  border: 0;
  border-radius: 999rpx;
  color: #3976c8;
  background: #e9f3ff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.copywriting-action + .copywriting-action {
  margin-left: 8rpx;
}

.copywriting-action::after {
  border: 0;
}

.copywriting-toggle {
  min-width: 72rpx;
  color: #6a81a0;
  background: #eef3f9;
}

.copy-button {
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.copy-feedback-active {
  color: #16835a;
  background: #dff6e9;
}

.copywriting-body,
.copywriting-empty {
  min-height: 112rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #e0eaf7;
  border-radius: 13rpx;
  color: #36577f;
  background: #ffffff;
  font-size: 23rpx;
  line-height: 36rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.copywriting-body-collapsed {
  max-height: 180rpx;
  overflow: hidden;
}

.copywriting-body-shell {
  position: relative;
  margin-top: 14rpx;
}

.copywriting-body-in-shell {
  margin-top: 0;
}

.copywriting-fade {
  position: absolute;
  right: 1rpx;
  bottom: 1rpx;
  left: 1rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 104rpx;
  padding-bottom: 13rpx;
  box-sizing: border-box;
  border-radius: 0 0 13rpx 13rpx;
  color: #3976c8;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.94) 48%,
    #edf5ff 100%
  );
  font-size: 19rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.copywriting-empty {
  color: #8da0b9;
}

.copywriting-title-body {
  min-height: 0;
}

.copywriting-tag-box {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 56rpx;
  margin-top: 14rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid #e0eaf7;
  border-radius: 13rpx;
  background: #ffffff;
}

.copywriting-tag-chip {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 11rpx;
  border-radius: 999rpx;
  color: #4d78ba;
  background: #edf5ff;
  font-size: 19rpx;
  line-height: 36rpx;
}

.copywriting-footer {
  align-items: flex-start;
  margin-top: 10rpx;
  color: #91a5bf;
  font-size: 19rpx;
  line-height: 30rpx;
}

.copywriting-footer text:last-child {
  margin-left: 14rpx;
  text-align: right;
}

.save-button {
  margin-top: 18rpx;
}

.secondary-btn {
  height: 80rpx;
  margin: 12rpx 0 0;
  color: #5f7594;
  background: #f2f6fb;
  font-size: 23rpx;
  line-height: 80rpx;
}

.action-button.secondary-btn {
  width: auto;
  height: 88rpx;
  margin: 0;
  font-size: 26rpx;
  line-height: normal;
}

.primary-btn:not([disabled]):active,
.secondary-btn:not([disabled]):active,
.paste-button:active,
.copy-button:active,
  .copywriting-action:active,
  .copywriting-fade:active,
  .back-button:active {
  opacity: 0.76;
}

@media (prefers-reduced-motion: reduce) {
  .state-spinner {
    animation: none;
  }
}

@keyframes media-parser-spin {
  to {
    transform: rotate(360deg);
  }
}
