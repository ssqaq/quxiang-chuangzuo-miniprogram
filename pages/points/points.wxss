page {
  background: #f5f7fb;
}

.points-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  color: #1d2433;
}

.card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e7ebf2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(31, 49, 79, 0.05);
}

.points-hero {
  background: linear-gradient(135deg, #e9f3ff 0%, #ffffff 80%);
  border-color: #cfe3ff;
}

.points-hero-head,
.streak-head,
.ledger-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.points-kicker {
  color: #1f6feb;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.points-title {
  margin-top: 8rpx;
  color: #182132;
  font-size: 38rpx;
  font-weight: 800;
}

.points-subtitle,
.section-subtitle,
.checkin-hint,
.usage-note,
.ledger-total {
  margin-top: 8rpx;
  color: #718096;
  font-size: 22rpx;
  line-height: 34rpx;
}

.points-balance {
  flex: none;
  min-width: 132rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.points-balance-number {
  display: block;
  color: #1f6feb;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.points-balance-label {
  display: block;
  margin-top: 4rpx;
  color: #7b8ba1;
  font-size: 20rpx;
}

.points-promo {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #946d24;
  background: #fff8e9;
  font-size: 21rpx;
  line-height: 32rpx;
}

.section-title {
  color: #243047;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.streak-count {
  flex: none;
  color: #1f6feb;
  font-size: 24rpx;
  font-weight: 700;
}

.streak-count text:first-child {
  font-size: 44rpx;
  line-height: 44rpx;
}

.streak-progress-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8eff8;
}

.streak-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #62a3ff, #1f6feb);
}

.streak-progress-foot {
  display: flex;
  margin-top: 10rpx;
  justify-content: space-between;
  color: #7d899b;
  font-size: 20rpx;
}

.checkin-button {
  width: 100%;
  height: 78rpx;
  margin-top: 22rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 78rpx;
}

.checkin-button[disabled] {
  color: #7c8798 !important;
  background: #e9eef5 !important;
}

.checkin-hint {
  text-align: center;
}

.usage-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.usage-item {
  min-width: 0;
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  text-align: center;
}

.usage-label,
.usage-value {
  display: block;
}

.usage-label {
  color: #7b879a;
  font-size: 20rpx;
}

.usage-value {
  margin-top: 6rpx;
  color: #2e405a;
  font-size: 24rpx;
  font-weight: 700;
}

.usage-note {
  margin-top: 14rpx;
}

.ledger-head {
  align-items: center;
}

.ledger-total {
  margin-top: 0;
  font-size: 20rpx;
}

.empty-ledger {
  padding: 28rpx 0 8rpx;
  color: #8a96a8;
  font-size: 22rpx;
  text-align: center;
}

.ledger-row {
  display: flex;
  padding: 18rpx 0;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-top: 1rpx solid #edf0f5;
}

.ledger-row:first-of-type {
  margin-top: 16rpx;
}

.ledger-copy {
  min-width: 0;
  flex: 1;
}

.ledger-description {
  overflow: hidden;
  color: #334258;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-time {
  margin-top: 6rpx;
  color: #8792a4;
  font-size: 19rpx;
}

.ledger-amount {
  flex: none;
  font-size: 27rpx;
  font-weight: 800;
}

.ledger-income {
  color: #23834b;
}

.ledger-expense {
  color: #c35d68;
}

.ledger-free {
  color: #7b879a;
}

.back-button {
  width: 100%;
  height: 72rpx;
  margin-top: 4rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.primary-btn {
  background: #356fce !important;
  color: #ffffff !important;
}

.plain-btn {
  background: #f4f6fa !important;
  color: #4b5567 !important;
}

button::after {
  border: 0;
}

@media (max-width: 360px) {
  .points-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .points-title {
    font-size: 34rpx;
  }

  .points-balance {
    min-width: 112rpx;
    padding-right: 10rpx;
    padding-left: 10rpx;
  }

  .points-balance-number {
    font-size: 36rpx;
  }
}
