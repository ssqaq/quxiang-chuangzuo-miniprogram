              <text>失败率</text>
              <text>{{usageStats.failureStats.failureRate}}%</text>
            </view>
            <view class="usage-failure-summary-item usage-failure-summary-model">
              <text>失败最多的模型</text>
              <text wx:if="{{usageStats.failureStats.failedModels.length}}">
                {{usageStats.failureStats.failedModels[0].provider}} / {{usageStats.failureStats.failedModels[0].model}}
              </text>
              <text wx:else>暂无失败</text>
            </view>
          </view>
          <view wx:if="{{usageStats.failureStats.topFailureReasons.length}}" class="usage-failure-list">
            <view class="usage-failure-list-title">失败原因前 5 名</view>
            <view wx:for="{{usageStats.failureStats.topFailureReasons}}" wx:key="key" class="usage-failure-row">
              <view class="usage-failure-row-top">
                <text class="usage-failure-label">{{index + 1}}. {{item.label}}</text>
                <text class="usage-failure-count">{{item.count}} 次 · {{item.rate}}%</text>
              </view>
              <view class="usage-failure-row-detail">
                <text>{{item.provider || '未知 Provider'}} / {{item.model || '未知模型'}}</text>
                <text wx:if="{{item.status}}">HTTP {{item.status}}</text>
                <text>{{item.retryable ? '可重试' : '不可重试'}}</text>
              </view>
            </view>
          </view>
          <view wx:else class="admin-empty usage-empty">最近统计范围内没有失败记录。</view>
          <view wx:if="{{usageStats.failureStats.failureDetails.length}}" class="failure-detail-list">
            <view class="usage-failure-list-title">最近失败明细</view>
            <view wx:for="{{usageStats.failureStats.failureDetails}}" wx:key="requestId" class="failure-detail-row">
              <view class="failure-detail-head">
                <view class="failure-detail-title">{{item.createdAtText}} · {{item.provider}} / {{item.model}}</view>
                <button class="copy-error-button" data-index="{{index}}" catchtap="copyModelFailure">复制错误</button>
              </view>
              <view class="failure-detail-meta">
                <text>{{item.errorCode}}</text>
                <text wx:if="{{item.errorStatus}}">HTTP {{item.errorStatus}}</text>
                <text>{{item.durationMs}}ms</text>
                <text wx:if="{{item.requestId}}">请求 {{item.requestId}}</text>
              </view>
              <view class="failure-detail-message">{{item.errorMessage}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-daily-title">最近{{usageStats.days}}天每日明细</view>
        <scroll-view wx:if="{{moduleStates.usage.status !== 'loading' && usageStats.daily.length}}" class="usage-daily-list" scroll-y>
          <view wx:for="{{usageStats.daily}}" wx:key="dateKey" class="usage-daily-row">
            <view class="usage-daily-date">
              <text>{{item.dateLabel}}</text>
              <text>合计 {{item.total}} 次</text>
            </view>
            <view class="usage-daily-values">
              <text>图片 {{item.analysis.total}}</text>
              <text>生图 {{item.image.total}}</text>
              <text>人脸 {{item.face.total}}</text>
              <text>视频 {{item.video.total}}</text>
            </view>
            <view class="usage-daily-result">成功 {{item.success}} · 失败 {{item.failure}}</view>
          </view>
        </scroll-view>
        <view wx:elif="{{moduleStates.usage.status !== 'loading'}}" class="admin-empty usage-empty">还没有模型调用记录，部署后有调用就会自动统计。</view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-subsection-title">按用户统计</view>
        <view wx:if="{{moduleStates.usage.status !== 'loading' && usageStats.users.length}}" class="usage-user-list">
          <view wx:for="{{usageStats.users}}" wx:key="userHash" class="usage-user-row">
            <view class="usage-user-top">
              <text>用户 {{item.userHash}}</text>
              <text>¥{{item.estimatedCost}} · {{item.total}} 次</text>
            </view>
            <view class="usage-user-detail">
              <text>图片 {{item.byType.analysis.total}}</text>
              <text>生图 {{item.byType.image.total}}</text>
              <text>人脸 {{item.byType.face.total}}</text>
              <text>视频 {{item.byType.video.total}}</text>
              <text>Token {{item.totalTokens}}</text>
              <text>视频 {{item.videoDurationSeconds}} 秒</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{moduleStates.usage.status !== 'loading'}}" class="admin-empty usage-empty">还没有按用户统计的数据。</view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-subsection-title">按模型名称分组</view>
        <view wx:if="{{moduleStates.usage.status !== 'loading' && usageStats.models.length}}" class="usage-model-list">
          <view wx:for="{{usageStats.models}}" wx:key="model" class="usage-model-row">
            <view class="usage-model-top">
              <text>{{item.provider}} / {{item.model}}</text>
              <text>¥{{item.estimatedCost}} · {{item.total}} 次</text>
            </view>
            <view class="usage-user-detail">
              <text>{{item.usageType}}</text>
              <text>成功 {{item.success}}</text>
              <text>失败 {{item.failure}}</text>
              <text>Token {{item.totalTokens}}</text>
              <text>视频 {{item.videoDurationSeconds}} 秒</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{moduleStates.usage.status !== 'loading'}}" class="admin-empty usage-empty">还没有按模型分组的数据。</view>

        <view wx:if="{{moduleStates.usage.status !== 'loading'}}" class="usage-subsection-title">按月份统计</view>
        <scroll-view wx:if="{{moduleStates.usage.status !== 'loading' && usageStats.monthly.length}}" class="usage-monthly-list" scroll-y>
          <view wx:for="{{usageStats.monthly}}" wx:key="monthKey" class="usage-monthly-row">
            <view class="usage-daily-date">
              <text>{{item.monthKey}}</text>
              <text>预计 ¥{{item.estimatedCost}} · {{item.total}} 次</text>
            </view>
            <view class="usage-daily-values">
              <text>图片 ¥{{item.analysis.estimatedCost}}</text>
              <text>人脸 ¥{{item.face.estimatedCost}}</text>
              <text>生图 ¥{{item.image.estimatedCost}}</text>
              <text>视频 ¥{{item.video.estimatedCost}}</text>
            </view>
            <view class="usage-daily-result">Token {{item.totalTokens}} · 视频 {{item.videoDurationSeconds}} 秒</view>
          </view>
        </scroll-view>
        <view wx:elif="{{moduleStates.usage.status !== 'loading'}}" class="admin-empty usage-empty">还没有月度统计数据。</view>
      </view>

      <view class="card admin-section auto-face-failure-section">
