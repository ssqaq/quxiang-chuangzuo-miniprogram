page {
  background: #f2f5fa;
}

.admin-page {
  min-height: 100vh;
  padding: 22rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  color: #152033;
}

.card {
  border: 1rpx solid #dce4ef;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(35, 55, 86, 0.06);
}

.console-header {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: 18rpx;
}

.console-back {
  display: flex;
  flex: none;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 0 5rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e3e9f2;
  border-radius: 20rpx;
  color: #25344b;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(27, 45, 73, 0.08);
  font-size: 44rpx;
  font-weight: 400;
  line-height: 60rpx;
}

.console-back::after,
.quick-launch::after,
.current-config-row::after,
.config-close-button::after,
.status-check-button::after,
.monitor-toggle::after {
  border: 0;
}

.console-heading {
  min-width: 0;
  flex: 1;
}

.console-title {
  color: #111d31;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.console-subtitle {
  margin-top: 2rpx;
  overflow: hidden;
  color: #7a879b;
  font-size: 20rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-console {
  margin-top: 24rpx;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 28rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 16%, rgba(86, 137, 214, 0.38), transparent 34%),
    linear-gradient(145deg, #1c2e4b 0%, #29476f 100%);
  box-shadow: 0 18rpx 42rpx rgba(25, 48, 82, 0.2);
}

.status-console-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.status-console-label {
  color: #b8c7da;
  font-size: 20rpx;
  line-height: 28rpx;
}

.status-console-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.status-console-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 7rpx;
  border: 6rpx solid rgba(101, 223, 161, 0.16);
  border-radius: 50%;
  background: #65dfa1;
  box-shadow: 0 0 0 8rpx rgba(101, 223, 161, 0.07);
}

.status-warn .status-console-dot {
  border-color: rgba(255, 193, 92, 0.18);
  background: #ffc15c;
  box-shadow: 0 0 0 8rpx rgba(255, 193, 92, 0.08);
}

.status-neutral .status-console-dot {
  border-color: rgba(166, 191, 226, 0.18);
  background: #a6bfe2;
  box-shadow: 0 0 0 8rpx rgba(166, 191, 226, 0.08);
}

.status-console-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 6rpx;
  color: #cbd7e6;
  font-size: 19rpx;
  line-height: 30rpx;
}

.status-console-meta text {
  position: relative;
}

.status-console-meta text + text {
  padding-left: 16rpx;
}

.status-console-meta text + text::before {
  position: absolute;
  top: 12rpx;
  left: 0;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #8298b6;
  content: "";
}

.status-check-button {
  display: flex;
  width: auto;
  height: 68rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 18rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.11);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.status-console-actions {
  display: flex;
  width: 100%;
  gap: 12rpx;
  margin-top: 22rpx;
}

.status-refresh-button {
  border-color: rgba(126, 205, 255, 0.32);
  background: rgba(71, 151, 218, 0.2);
}

.status-probe-button {
  border-color: rgba(132, 229, 190, 0.32);
  background: rgba(44, 165, 113, 0.18);
}

.status-check-button.is-disabled,
.admin-action-button.is-disabled {
  opacity: 0.7;
}

.status-check-button.is-disabled {
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.07);
}

.quick-launch-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.quick-launch {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 136rpx;
  margin: 0;
  padding: 14rpx 8rpx 12rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 22rpx;
  color: #26344a;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(36, 58, 91, 0.04);
  line-height: normal;
}

.quick-launch.is-active {
  border-color: #8fb2ed;
  box-shadow: 0 0 0 3rpx rgba(55, 105, 198, 0.1);
}

.quick-launch.is-abnormal {
  border-color: #e58d96;
  background: #fff6f7;
  box-shadow: 0 0 0 3rpx rgba(191, 58, 73, 0.08);
}

.quick-launch.is-abnormal .quick-launch-name,
.quick-launch.is-abnormal .quick-launch-state {
  color: #b33f4c;
}

.quick-launch-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #326ad0;
  background: #eaf1ff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.quick-face .quick-launch-icon {
  color: #4f63bc;
  background: #eceffd;
}

.quick-analysis .quick-launch-icon {
  color: #2f74b5;
  background: #e8f4ff;
}

.quick-video .quick-launch-icon {
  color: #14815a;
  background: #e8f7f0;
}

.quick-points .quick-launch-icon {
  color: #7950bb;
  background: #f1eafe;
}

.quick-costs .quick-launch-icon {
  color: #a46b10;
  background: #fff4dd;
}

.quick-users .quick-launch-icon {
  color: #a94770;
  background: #fdeaf2;
}

.quick-launch-name {
  margin-top: 8rpx;
  color: #25344a;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.quick-launch-state {
  margin-top: 1rpx;
  overflow: hidden;
  color: #268157;
  font-size: 16rpx;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-section {
  margin-top: 24rpx;
}

.overview-heading {
  margin-bottom: 12rpx;
  padding-left: 4rpx;
  color: #50617a;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.current-config-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  margin: 0 0 12rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid #dce4ef;
  border-radius: 24rpx;
  color: #152033;
  background: #ffffff;
  box-shadow: 0 9rpx 24rpx rgba(35, 55, 86, 0.05);
  line-height: normal;
  text-align: left;
}

.current-config-row.is-abnormal {
  border-color: #e5a0a7;
  background: #fff8f8;
}

.current-config-static {
  cursor: default;
}

.current-config-main {
  min-width: 0;
  flex: 1;
}

.current-config-title {
  color: #152033;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.current-config-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #72829a;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-config-side {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.config-state {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #16764e;
  background: #e8f7f0;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
}

.config-state.is-off {
  color: #9a6217;
  background: #fff3df;
}

.current-config-arrow {
  color: #2869d7;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.today-section {
  margin-top: 20rpx;
}

.today-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.today-item {
  min-width: 0;
  padding: 20rpx 10rpx 18rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
}

.today-value,
.today-label {
  display: block;
}

.today-value {
  overflow: hidden;
  color: #132039;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-value.is-warn {
  color: #b24c47;
}

.today-label {
  margin-top: 5rpx;
  color: #8290a3;
  font-size: 18rpx;
  line-height: 26rpx;
}

.config-editor {
  margin-top: 22rpx;
  padding: 24rpx;
  border-color: #cad8eb;
}

.config-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8edf4;
}

.config-editor-kicker {
  color: #5d76a1;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 26rpx;
}

.config-editor-title {
  margin-top: 4rpx;
  color: #142139;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.config-close-button {
  display: flex;
  flex: none;
  width: 106rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce5f0;
  border-radius: 16rpx;
  color: #53647b;
  background: #f4f7fb;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
}

.config-editor-body {
  padding-top: 18rpx;
}

.config-editor-tools {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.config-tool-button {
  display: flex;
  min-width: 190rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #bdd0ef;
  border-radius: 16rpx;
  color: #245fd4;
  background: #eef5ff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.config-helper {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #526985;
  background: #eef4fb;
  font-size: 20rpx;
  line-height: 30rpx;
}

.admin-close-button {
  color: #566980 !important;
  background: #f0f4f9 !important;
}

.monitor-toggle {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin: 22rpx 0 0;
  padding: 18rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 1rpx solid #dce4ef;
  border-radius: 24rpx;
  color: #17243a;
  background: #ffffff;
  box-shadow: 0 9rpx 24rpx rgba(35, 55, 86, 0.05);
  line-height: normal;
  text-align: left;
}

.monitor-toggle.is-open {
  border-color: #aec4e5;
}

.monitor-toggle-title {
  color: #17243a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.monitor-toggle-subtitle {
  margin-top: 3rpx;
  color: #7d8a9e;
  font-size: 18rpx;
  line-height: 27rpx;
}

.monitor-toggle-arrow {
  flex: none;
  color: #6480a8;
  font-size: 34rpx;
  line-height: 40rpx;
}

.monitor-content {
  margin-top: 18rpx;
}

.monitor-toggle > view:first-child {
  min-width: 0;
  flex: 1;
}

.monitor-toggle-subtitle {
  overflow-wrap: anywhere;
  word-break: normal;
  text-align: left;
}

.monitor-toggle-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.monitor-all-button {
  display: flex;
  min-width: 86rpx;
  min-height: 52rpx;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cfe0f8;
  border-radius: 14rpx;
  color: #2565cf;
  background: #f3f7ff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.monitor-filter-button {
  display: flex;
  min-width: 100rpx;
  min-height: 52rpx;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ead9ad;
  border-radius: 14rpx;
  color: #8c6a21;
  background: #fffaf0;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.monitor-filter-button.is-active {
  border-color: #c7424e;
  color: #ffffff;
  background: #c7424e;
}

.monitor-toggle-arrow {
  display: flex;
  width: 48rpx;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbe5f2;
  border-radius: 14rpx;
  color: #2869d7;
  background: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.monitor-overview-card {
  display: flex;
  min-width: 0;
  margin-bottom: 18rpx;
  padding: 28rpx;
  align-items: stretch;
  justify-content: space-between;
  gap: 22rpx;
  overflow: hidden;
  border-radius: 26rpx;
  color: #ffffff;
  background: #1d3557;
  box-shadow: 0 18rpx 42rpx rgba(25, 48, 82, 0.18);
}

.monitor-overview-main {
  min-width: 0;
  flex: 1;
}

.monitor-overview-kicker {
  color: #b9cbe3;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.monitor-overview-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 50rpx;
  letter-spacing: -1rpx;
}

.monitor-overview-note {
  max-width: 100%;
  margin-top: 8rpx;
  color: #d6e0ef;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: left;
  overflow-wrap: anywhere;
  word-break: normal;
}

.monitor-overview-note-action {
  padding: 6rpx 8rpx;
  margin-left: -8rpx;
  border-radius: 10rpx;
}

.monitor-overview-note-action:active {
  background: rgba(255, 255, 255, 0.1);
}

.monitor-overview-stats {
  display: grid;
  width: 45%;
  min-width: 300rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  align-items: stretch;
}

.monitor-overview-stats > view {
  display: flex;
  min-width: 0;
  padding: 14rpx 10rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  text-align: center;
}

.monitor-overview-stat-action {
  transition: transform 0.08s ease, background-color 0.08s ease;
}

.monitor-overview-stat-action:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.14);
}

.monitor-overview-stats text {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.monitor-overview-stats text:first-child {
  color: #c4d3e7;
  font-size: 18rpx;
  line-height: 26rpx;
}

.monitor-overview-stats text:last-child {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.monitor-deployment-group {
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #dbe5f1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 24rpx rgba(35, 55, 86, 0.05);
}

.monitor-deployment-group.is-open {
  border-color: #aec4e5;
}

.monitor-section-head {
  display: flex;
  min-width: 0;
  min-height: 92rpx;
  padding: 18rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  text-align: left;
}

.monitor-section-head-main {
  min-width: 0;
  flex: 1;
}

.monitor-section-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.monitor-status-dot {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  border: 4rpx solid rgba(38, 157, 106, 0.16);
  border-radius: 50%;
  background: #2d9b6a;
  box-shadow: 0 0 0 4rpx rgba(45, 155, 106, 0.07);
}

.monitor-status-dot.is-danger {
  border-color: rgba(196, 66, 78, 0.16);
  background: #c7424e;
  box-shadow: 0 0 0 4rpx rgba(199, 66, 78, 0.07);
}

.monitor-section-title {
  min-width: 0;
  overflow: hidden;
  color: #1b2638;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.monitor-section-summary {
  display: block;
  margin: 5rpx 0 0 28rpx;
  overflow: hidden;
  color: #718096;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.monitor-section-toggle-button {
  display: flex;
  min-width: 116rpx;
  min-height: 60rpx;
  padding: 0 14rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #bcd3f6;
  border-radius: 16rpx;
  color: #246ee9;
  background: #edf4ff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.monitor-section-chevron {
  display: inline-flex;
  min-width: 20rpx;
  min-height: 20rpx;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1;
  transform: rotate(0deg);
}

.monitor-section-chevron.is-open {
  transform: rotate(180deg);
}

.monitor-deployment-body {
  padding: 0 18rpx 2rpx;
  border-top: 1rpx solid #edf0f5;
}

.monitor-deployment-body .admin-section {
  margin-bottom: 18rpx;
  box-shadow: none;
}

.monitor-deployment-body .admin-section:last-child {
  margin-bottom: 0;
}

.monitor-fold-card.is-collapsed {
  padding-bottom: 0;
}

.monitor-fold-body {
  padding-top: 2rpx;
}

.monitor-fold-card .monitor-section-toggle-button {
  min-width: 116rpx;
}

@media (max-width: 560px) {
  .monitor-toggle {
    align-items: flex-start;
  }

  .monitor-toggle-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .monitor-all-button {
    min-width: 78rpx;
  }

  .monitor-toggle-arrow {
    width: 44rpx;
  }

  .monitor-overview-card {
    display: block;
    padding: 24rpx;
  }

  .monitor-overview-stats {
    width: 100%;
    min-width: 0;
    margin-top: 18rpx;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .monitor-section-head {
    padding: 16rpx;
  }

  .monitor-deployment-body {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }
}

.admin-hero {
  padding: 28rpx;
  background: linear-gradient(135deg, #eef5ff 0%, #ffffff 74%);
}

.admin-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.admin-kicker {
  color: #1f6feb;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.admin-title {
  margin-top: 8rpx;
  color: #182132;
  font-size: 40rpx;
  font-weight: 800;
}

.admin-subtitle,
.admin-section-help {
  margin-top: 8rpx;
  color: #718096;
  font-size: 22rpx;
  line-height: 34rpx;
}

.admin-access-badge,
.admin-config-state {
  flex: none;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #23834b;
  background: #eaf8ef;
  font-size: 20rpx;
}

.admin-config-state.is-off {
  color: #ae6b13;
